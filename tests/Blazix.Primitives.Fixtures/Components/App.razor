<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Blazix.Primitives.Fixtures.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @* Tags every prerendered fixture node before Blazor starts (ADR-02/1, issue 3): an attribute Blazor never rendered
       survives reconciliation and vanishes with replacement. *@
    <script>for (const node of document.querySelectorAll('[data-fixture]')) node.setAttribute('data-prerendered-node', '');</script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
