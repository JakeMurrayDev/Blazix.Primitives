            <Render>
                <FixtureCompositeItem Tag="button" Disabled="true">second</FixtureCompositeItem>
            </Render>
        </FixtureCompositeItem>
        <FixtureCompositeItem Tag="button" type="button" Disabled="true" FocusableWhenDisabled="true" data-item="third">
