@namespace Blazix.Primitives.Fixtures.Client.NumberFieldFixtures
@using System.Globalization
@using Blazix.Primitives

@*
    The `number-field-input` fixture (tests/browser/number-field.input.spec.ts): a root with only its input, the input
    role's test consumer. `?case=` picks the root's props: `basic` (defaultValue 0), `bounds` (min -10, max 10), `empty`
    (no defaultValue), `de` (de-DE), `wheel` (defaultValue 5, allowWheelScrub). Every OnValueChange is recorded as
    `value/reason` in the container's data-changes, and every OnValueCommitted in data-commits; data-attached is rendered once the number-field module is attached.
    The `a-` cases (tests/browser/number-field.input-a.spec.ts, NumberFieldInput.test.tsx) render the root below instead:
    `a-alt` (defaultValue 0.15, smallStep 0.1, snapOnStep), `a-precise` (defaultValue 1.23456), `a-mirror` (value null,
    mirrored from OnValueChange), `a-cancel` (value 0, mirrored unless the "cancel" button armed a cancel, an "external"
    button that sets 10, the "cancel" button reading "armed" once armed), `a-lag` (value 0, never mirrored), `a-lag-inc` (`a-lag` with an Increment), `a-percent` (a percent
    format), `a-pl` (pl-PL), `a-signed` (min -10, max 10, defaultValue -5), `a-hundred` (defaultValue 100 inside a
    FieldRoot, whose data-focused marks the focus report) and `a-twelve` (defaultValue 12).
*@
<FixtureContainer Name="number-field-input" data-attached="@(attached ? "true" : "false")" data-changes="@string.Join(' ', changes)" data-commits="@string.Join(' ', commits)">
    @if (Case?.StartsWith("a-", StringComparison.Ordinal) == true)
    {
        @CaseA
    }
    else
    {
    <NumberFieldRoot DefaultValue="DefaultValue" Min="Min" Max="Max" AllowWheelScrub="@(Case == "wheel")" Culture="Culture" OnValueChange="Change" OnValueCommitted="Commit">
        <NumberFieldInput @ref="input" data-testid="input" />
    </NumberFieldRoot>
    }
</FixtureContainer>

@code {
    private readonly List<string> changes = [];
    private readonly List<string> commits = [];
    private NumberFieldInput? input;
    private bool attached;

    [SupplyParameterFromQuery(Name = "case")]
    public string? Case { get; set; }

    private double? DefaultValue => Case switch
    {
        "basic" => 0,
        "wheel" => 5,
        _ => null,
    };

    private double? Min => Case == "bounds" ? -10 : null;

    private double? Max => Case == "bounds" ? 10 : null;

    private CultureInfo Culture => CultureInfo.GetCultureInfo(Case == "de" ? "de-DE" : "en-US");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        await input!.TwinAttached;
        attached = true;
        StateHasChanged();
    }

    private void Change(ValueChangeEventArgs<double?> e)
    {
        string value = e.Value is double number ? number.ToString(CultureInfo.InvariantCulture) : "null";
        changes.Add($"{value}/{e.Details.Reason.ToLiteral()}");
    }

    private void Commit(ValueCommittedEventArgs<double?> e)
    {
        string value = e.Value is double number ? number.ToString(CultureInfo.InvariantCulture) : "null";
        commits.Add($"{value}/{e.Details.Reason.ToLiteral()}");
    }
}

@code {
    // The `a-` cases: NumberFieldInput.test.tsx's roots (number-field.input-a.spec.ts).
    private static readonly NumberFormatOptions s_percent = new() { Style = NumberFormatStyle.Percent };
    private static readonly CultureInfo s_aEnUs = CultureInfo.GetCultureInfo("en-US");
    private double? aValue;
    private bool aValueSet;
    private bool aCancel;

    // The controlled value: the case's initial value until the parent sets its own.
    private double? AValue => aValueSet ? aValue : Case == "a-mirror" ? null : 0;

    private double? AMin => Case == "a-signed" ? -10 : null;

    private double? AMax => Case == "a-signed" ? 10 : null;

    private bool ASnapOnStep => Case == "a-alt";

    private NumberFormatOptions? AFormat => Case == "a-percent" ? s_percent : null;

    private CultureInfo ACulture => Case == "a-pl" ? CultureInfo.GetCultureInfo("pl-PL") : s_aEnUs;

    private bool AControlled => Case is "a-mirror" or "a-cancel" or "a-lag" or "a-lag-inc";

    private double? ADefaultValue => Case switch
    {
        "a-alt" => 0.15,
        "a-precise" => 1.23456,
        "a-signed" => -5,
        "a-hundred" => 100,
        "a-twelve" => 12,
        _ => null,
    };

    private RenderFragment CaseA => @<text>
        @if (Case == "a-hundred")
        {
            <FieldRoot data-testid="field">
                <NumberFieldRoot DefaultValue="ADefaultValue" Culture="s_aEnUs" OnValueChange="Change" OnValueCommitted="Commit">
                    <NumberFieldInput @ref="input" data-testid="input" />
                </NumberFieldRoot>
            </FieldRoot>
        }
        else if (AControlled)
        {
            <NumberFieldRoot Value="AValue" Culture="s_aEnUs" OnValueChange="ChangeA" OnValueCommitted="Commit">
                <NumberFieldInput @ref="input" data-testid="input" />
                @if (Case == "a-lag-inc")
                {
                    <NumberFieldIncrement />
                }
            </NumberFieldRoot>
            @if (Case == "a-cancel")
            {
                <button type="button" @onclick="() => SetA(10)">external</button>
                <button type="button" @onclick="() => aCancel = true">@(aCancel ? "armed" : "cancel")</button>
            }
        }
        else
        {
            <NumberFieldRoot DefaultValue="ADefaultValue" Min="AMin" Max="AMax"
                             SmallStep="0.1" SnapOnStep="ASnapOnStep" Format="AFormat"
                             Culture="ACulture" OnValueChange="Change" OnValueCommitted="Commit">
                <NumberFieldInput @ref="input" data-testid="input" />
            </NumberFieldRoot>
        }
    </text>;

    // Records the change, then cancels it when armed, else stores it when the case mirrors (React's useState parent).
    private void ChangeA(ValueChangeEventArgs<double?> e)
    {
        Change(e);
        if (aCancel)
        {
            e.Details.Cancel();
            return;
        }

        if (Case is "a-mirror" or "a-cancel")
        {
            SetA(e.Value);
        }
    }

    private void SetA(double? value)
    {
        aValue = value;
        aValueSet = true;
    }
}
