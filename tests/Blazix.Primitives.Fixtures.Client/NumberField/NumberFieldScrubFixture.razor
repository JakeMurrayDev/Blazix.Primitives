@namespace Blazix.Primitives.Fixtures.Client.NumberFieldFixtures
@using System.Globalization
@using Blazix.Primitives

@*
    The `number-field-scrub` fixture (tests/browser/number-field.scrub.spec.ts): a root with its input and a scrub area
    holding a cursor, the scrub role's test consumer (NumberFieldScrubArea.test.tsx, NumberFieldScrubAreaCursor.test.tsx).
    `?case=` picks: `basic` (defaultValue 0), `sensitivity` (pixelSensitivity 5), `zero` (defaultValue 3.5, step 1,
    snapOnStep, pixelSensitivity 0), `vertical` (direction vertical), `teleport` (teleportDistance 100, the area fixed at
    100,100 sized 20x20), `two` (two scrub areas with a cursor each), `click` (the input after the area, an inline-block
    area 100x40 with a `label` child, both recording clicks), `readonly`, `select` (defaultValue 100; the title adds the
    consumer's select-on-focus listener), `paste` (defaultValue 10), `toggle` (a button that unmounts the scrub area, another that re-keys
    it). OnValueChange is recorded as `value/reason` in data-changes, OnValueCommitted in data-commits, clicks as
    `area`/`label` in data-clicks; data-attached is rendered once the input's and the scrub areas' modules attached.
*@
<FixtureContainer Name="number-field-scrub" data-attached="@(attached ? "true" : "false")" data-changes="@string.Join(' ', changes)" data-commits="@string.Join(' ', commits)" data-clicks="@string.Join(' ', clicks)">
    <NumberFieldRoot data-testid="root" DefaultValue="DefaultValue" Step="Step" SnapOnStep="@(Case == "zero")" ReadOnly="@(Case == "readonly")" Culture="s_enUs" OnValueChange="Change" OnValueCommitted="Commit">
        @if (Case == "click")
        {
            <NumberFieldScrubArea @ref="area" data-testid="scrub-area" style="display: inline-block; width: 100px; height: 40px" @onclick="@(() => clicks.Add("area"))">
                <label @onclick="@(() => clicks.Add("label"))">Amount</label>
                <NumberFieldScrubAreaCursor data-testid="scrub-area-cursor" />
            </NumberFieldScrubArea>
            <NumberFieldInput @ref="input" data-testid="input" />
        }
        else
        {
            <NumberFieldInput @ref="input" data-testid="input" />
            @if (mounted)
            {
                <NumberFieldScrubArea @key="areaKey" @ref="area" data-testid="scrub-area" Direction="Direction" PixelSensitivity="PixelSensitivity" TeleportDistance="TeleportDistance" style="@AreaStyle">
                    <NumberFieldScrubAreaCursor data-testid="scrub-area-cursor" />
                </NumberFieldScrubArea>
            }
            @if (Case == "two")
            {
                <NumberFieldScrubArea @ref="second" data-testid="scrub-area-2" style="display: inline-block; width: 100px; height: 40px">
                    <NumberFieldScrubAreaCursor data-testid="scrub-area-cursor" />
                </NumberFieldScrubArea>
            }
        }
    </NumberFieldRoot>
    @if (Case == "toggle")
    {
        <button type="button" data-testid="unmount" @onclick="@(() => mounted = false)">Unmount</button>
        <button type="button" data-testid="rekey" @onclick="@(() => areaKey++)">Re-key</button>
    }
</FixtureContainer>

@code {
    private static readonly CultureInfo s_enUs = CultureInfo.GetCultureInfo("en-US");
    private readonly List<string> changes = [];
    private readonly List<string> commits = [];
    private readonly List<string> clicks = [];
    private NumberFieldInput? input;
    private NumberFieldScrubArea? area;
    private NumberFieldScrubArea? second;
    private bool mounted = true;
    private int areaKey;
    private bool attached;

    [SupplyParameterFromQuery(Name = "case")]
    public string? Case { get; set; }

    private double? DefaultValue => Case switch
    {
        "zero" => 3.5,
        "select" => 100,
        "paste" => 10,
        _ => 0,
    };

    private StepValue? Step => Case == "zero" ? 1 : null;

    private Orientation Direction => Case == "vertical" ? Orientation.Vertical : Orientation.Horizontal;

    private double PixelSensitivity => Case switch
    {
        "sensitivity" => 5,
        "zero" => 0,
        _ => 2,
    };

    private double? TeleportDistance => Case == "teleport" ? 100 : null;

    private string AreaStyle => Case == "teleport"
        ? "position: fixed; left: 100px; top: 100px; width: 20px; height: 20px"
        : "display: inline-block; width: 100px; height: 40px";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        await Task.WhenAll(input!.TwinAttached, area!.TwinAttached, second?.TwinAttached ?? Task.CompletedTask);
        attached = true;
        StateHasChanged();
    }

    private void Change(ValueChangeEventArgs<double?> e)
    {
        string value = e.Value is double number ? number.ToString(CultureInfo.InvariantCulture) : "null";
        changes.Add($"{value}/{e.Details.Reason.ToLiteral()}");
    }

    private void Commit(ValueCommittedEventArgs<double?> e)
    {
        string value = e.Value is double number ? number.ToString(CultureInfo.InvariantCulture) : "null";
        commits.Add($"{value}/{e.Details.Reason.ToLiteral()}");
    }
}
