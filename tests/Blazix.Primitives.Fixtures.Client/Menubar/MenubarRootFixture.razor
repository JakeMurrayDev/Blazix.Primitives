@namespace Blazix.Primitives.Fixtures.Client.MenubarFixtures
@using System.Globalization
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@using Microsoft.AspNetCore.Components.Web
@inherits PopupSuiteFixtureBase

@*
    The `menubar-root` fixture (tests/browser/menubar.spec.ts, M5 track 8, issue 195): Menubar.test.tsx's
    ContainedTriggerMenubar (`setup=contained`, the default): File (Open, Save, a Share submenu with Email and Print),
    Edit (Copy, Paste) and View (Zoom In, Zoom Out, a Layout submenu with a radio group), each a MenuRoot with its own
    trigger. `setup=detached`: the three triggers in the bar bound by a handle to one Root outside it; `setup=multiple`:
    the three triggers inside one Root in the bar (DetachedTriggerMenubar, MultipleContainedTriggersMenubar); the Root
    renders the menu its trigger's payload names (`file`, `edit`, `view`), its open changes in `data-file-changes`.
    `case=first-disabled`: a bar whose File trigger is disabled, then Edit. `case=consumer`: a bar whose File trigger has a consumer `onmousedown` (calling PreventPartHandler() with
    `veto`) and `onclick`, recorded in `data-handler-calls`. `case=disabled-open`: a disabled bar
    whose File menu is held open by `Open`, its item recording its clicks (`data-item-clicks`). `case=triggerless`: an
    Outside button and a bar whose one menu has no trigger, is bound open and kept mounted (Menubar.test.tsx:119).
    `case=scroll-lock`: a modal bar of File (`fileWidth=narrow` makes its positioner 240px wide, else the viewport less
    10px) and Edit (240px) (`:821-927`). `case=open-side`: a bar (`orientation`) whose File menu is open, for
    MenuPositioner.test.tsx's "Menubar parent" titles. `orientation=vertical` turns the bar, `loopFocus=false` stops the arrow keys at the ends, `disabled` disables it, and `dir=rtl` puts it in a right-to-left DirectionProvider. A "Before" button precedes the bar for Tab. The container records each
    menu's open changes (`data-file-changes`, `data-edit-changes`, `data-view-changes`, `open:reason`).
*@
<FixtureContainer Name="menubar-root" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-file-changes="@string.Join(' ', fileChanges)" data-edit-changes="@string.Join(' ', editChanges)"
                  data-view-changes="@string.Join(' ', viewChanges)" data-item-clicks="@string.Join(' ', itemClicks)" data-handler-calls="@string.Join(' ', handlerCalls)">
    <button type="button" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" data-testid="before">Before</button>
    @switch (Query("case"))
    {
        case "first-disabled":
            <Menubar @ref="bar" style="display: flex">
                <MenuRoot TPayload="NoPayload" @ref="file">
                    <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" Disabled="true" data-testid="file-trigger">File</MenuTrigger>
                    <MenuPortal><MenuPositioner><MenuPopup><MenuItem>Open</MenuItem></MenuPopup></MenuPositioner></MenuPortal>
                </MenuRoot>
                <MenuRoot TPayload="NoPayload" @ref="edit">
                    <MenuTrigger TPayload="NoPayload" @ref="editTrigger" data-testid="edit-trigger">Edit</MenuTrigger>
                    <MenuPortal><MenuPositioner><MenuPopup><MenuItem>Copy</MenuItem></MenuPopup></MenuPositioner></MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        case "consumer":
            <Menubar @ref="bar">
                <MenuRoot TPayload="NoPayload" @ref="file" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(fileChanges, args))">
                    <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" data-testid="file-trigger"
                                 @onmousedown="@OnConsumerMouseDown" @onclick="@(() => handlerCalls.Add("click"))">File</MenuTrigger>
                    <MenuPortal><MenuPositioner data-testid="file-menu"><MenuPopup><MenuItem>Open</MenuItem></MenuPopup></MenuPositioner></MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        case "triggerless":
            <button type="button" data-testid="outside">Outside</button>
            <Menubar @ref="bar">
                <MenuRoot TPayload="NoPayload" @ref="file" @bind-Open="triggerlessOpen">
                    <MenuPortal KeepMounted="true">
                        <MenuPositioner>
                            <MenuPopup data-testid="triggerless-menu"><MenuItem>Item</MenuItem></MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        case "scroll-lock":
            <Menubar @ref="bar" Modal="true" style="display: flex">
                <MenuRoot TPayload="NoPayload" @ref="file" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(fileChanges, args))">
                    <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" data-testid="file-trigger">File</MenuTrigger>
                    <MenuPortal>
                        <MenuPositioner data-testid="file-menu" style="@(Query("fileWidth") == "narrow" ? "width: 240px" : "width: calc(100vw - 10px)")">
                            <MenuPopup><MenuItem>Open</MenuItem></MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
                <MenuRoot TPayload="NoPayload" @ref="edit" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(editChanges, args))">
                    <MenuTrigger TPayload="NoPayload" @ref="editTrigger" data-testid="edit-trigger">Edit</MenuTrigger>
                    <MenuPortal>
                        <MenuPositioner data-testid="edit-menu" style="width: 240px">
                            <MenuPopup><MenuItem>Copy</MenuItem></MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        case "open-side":
            <Menubar @ref="bar" Orientation="@orientation">
                <MenuRoot TPayload="NoPayload" @ref="file" Open="true">
                    <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" style="width: 72px; height: 36px">File</MenuTrigger>
                    <MenuPortal>
                        <MenuPositioner data-testid="positioner"><MenuPopup style="width: 52px; height: 24px">Open</MenuPopup></MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        case "disabled-open":
            <Menubar @ref="bar" Disabled="true">
                <MenuRoot TPayload="NoPayload" @ref="file" Open="true">
                    <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" data-testid="file-trigger">File</MenuTrigger>
                    <MenuPortal>
                        <MenuPositioner>
                            <MenuPopup>
                                <MenuItem data-testid="file-item" @onclick="@(() => itemClicks.Add("Open"))">Open</MenuItem>
                            </MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </Menubar>
            break;
        default:
    <DirectionProvider Direction="@direction">
    @if (Query("setup") == "detached")
    {
        <Menubar @ref="bar" Orientation="@orientation" LoopFocus="@loopFocus" Disabled="@disabled" style="max-width: 25vw; display: flex">
            <MenuTrigger TPayload="string" @ref="fileShared" Handle="handle" Payload="@("file")" data-testid="file-trigger">File</MenuTrigger>
            <MenuTrigger TPayload="string" @ref="editShared" Handle="handle" Payload="@("edit")" data-testid="edit-trigger">Edit</MenuTrigger>
            <MenuTrigger TPayload="string" @ref="viewShared" Handle="handle" Payload="@("view")" data-testid="view-trigger">View</MenuTrigger>
        </Menubar>
        <MenuRoot TPayload="string" @ref="shared" Handle="handle" OnOpenChange="RecordShared" PayloadContent="@DynamicMenu" />
    }
    else if (Query("setup") == "multiple")
    {
        <Menubar @ref="bar" Orientation="@orientation" LoopFocus="@loopFocus" Disabled="@disabled" style="max-width: 25vw; display: flex">
            <MenuRoot TPayload="string" @ref="shared" OnOpenChange="RecordShared" PayloadContent="@DynamicMenu">
                <MenuTrigger TPayload="string" @ref="fileShared" Payload="@("file")" data-testid="file-trigger">File</MenuTrigger>
                <MenuTrigger TPayload="string" @ref="editShared" Payload="@("edit")" data-testid="edit-trigger">Edit</MenuTrigger>
                <MenuTrigger TPayload="string" @ref="viewShared" Payload="@("view")" data-testid="view-trigger">View</MenuTrigger>
            </MenuRoot>
        </Menubar>
    }
    else
    {
    <Menubar @ref="bar" Orientation="@orientation" LoopFocus="@loopFocus" Disabled="@disabled" style="max-width: 25vw; display: flex">
        <MenuRoot TPayload="NoPayload" @ref="file" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(fileChanges, args))">
            <MenuTrigger TPayload="NoPayload" @ref="fileTrigger" data-testid="file-trigger">File</MenuTrigger>
            <MenuPortal>
                <MenuPositioner data-testid="file-menu">
                    <MenuPopup>@FileItems</MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuRoot>
        <MenuRoot TPayload="NoPayload" @ref="edit" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(editChanges, args))">
            <MenuTrigger TPayload="NoPayload" @ref="editTrigger" data-testid="edit-trigger">Edit</MenuTrigger>
            <MenuPortal>
                <MenuPositioner data-testid="edit-menu">
                    <MenuPopup>@EditItems</MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuRoot>
        <MenuRoot TPayload="NoPayload" @ref="view" OnOpenChange="@((ValueChangeEventArgs<bool> args) => Record(viewChanges, args))">
            <MenuTrigger TPayload="NoPayload" @ref="viewTrigger" data-testid="view-trigger">View</MenuTrigger>
            <MenuPortal>
                <MenuPositioner data-testid="view-menu">
                    <MenuPopup>@ViewItems</MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuRoot>
    </Menubar>
    }
    </DirectionProvider>
            break;
    }
</FixtureContainer>

@code {
    private readonly List<string> fileChanges = [];
    private readonly List<string> editChanges = [];
    private readonly List<string> viewChanges = [];
    private readonly List<string> itemClicks = [];
    private readonly List<string> handlerCalls = [];
    private bool triggerlessOpen = true;
    private Menubar? bar;
    private MenuRoot<NoPayload>? file;
    private MenuRoot<NoPayload>? edit;
    private MenuRoot<NoPayload>? view;
    private MenuTrigger<NoPayload>? fileTrigger;
    private MenuTrigger<NoPayload>? editTrigger;
    private MenuTrigger<NoPayload>? viewTrigger;
    private Orientation orientation = Orientation.Horizontal;
    private bool loopFocus = true;
    private bool disabled;
    private TextDirection direction = TextDirection.Ltr;
    private readonly MenuHandle<string> handle = new();
    private MenuRoot<string>? shared;
    private MenuTrigger<string>? fileShared;
    private MenuTrigger<string>? editShared;
    private MenuTrigger<string>? viewShared;

    protected override IEnumerable<Task> Attachments =>
    [
        bar?.TwinsAttached ?? Task.CompletedTask,
        file?.SessionAttached ?? Task.CompletedTask,
        edit?.SessionAttached ?? Task.CompletedTask,
        view?.SessionAttached ?? Task.CompletedTask,
        fileTrigger?.TwinsAttached ?? Task.CompletedTask,
        editTrigger?.TwinsAttached ?? Task.CompletedTask,
        viewTrigger?.TwinsAttached ?? Task.CompletedTask,
        shared?.SessionAttached ?? Task.CompletedTask,
        fileShared?.TwinsAttached ?? Task.CompletedTask,
        editShared?.TwinsAttached ?? Task.CompletedTask,
        viewShared?.TwinsAttached ?? Task.CompletedTask,
    ];

    protected override void OnInitialized()
    {
        orientation = Query("orientation") == "vertical" ? Orientation.Vertical : Orientation.Horizontal;
        loopFocus = QueryFlag("loopFocus") != false;
        disabled = QueryFlag("disabled") == true;
        direction = Query("dir") == "rtl" ? TextDirection.Rtl : TextDirection.Ltr;
    }

    private static void Record(List<string> changes, ValueChangeEventArgs<bool> args) =>
        changes.Add(string.Create(CultureInfo.InvariantCulture, $"{(args.Value ? "true" : "false")}:{args.Details.Reason.ToLiteral()}"));

    // Deliverable 6's consumer handlers: `veto` makes the press's handler call PreventPartHandler().
    private void OnConsumerMouseDown(MouseEventArgs args)
    {
        handlerCalls.Add("mousedown");
        if (QueryFlag("veto") == true)
        {
            args.PreventPartHandler();
        }
    }

    // The shared Root's open changes, recorded under File's attribute.
    private void RecordShared(ValueChangeEventArgs<bool> args) => Record(fileChanges, args);

    // Menubar.test.tsx's DynamicMenu: the shared Root renders the menu its trigger's payload names.
    private RenderFragment<string?> DynamicMenu => key => @<MenuPortal>
        <MenuPositioner data-testid="@(key is null ? null : key + "-menu")">
            <MenuPopup>
                @switch (key)
                {
                    case "file":
                        @FileItems
                        break;
                    case "edit":
                        @EditItems
                        break;
                    case "view":
                        @ViewItems
                        break;
                }
            </MenuPopup>
        </MenuPositioner>
    </MenuPortal>;

    private RenderFragment FileItems => @<text>
        <MenuItem data-testid="file-item-1">Open</MenuItem>
        <MenuItem data-testid="file-item-2">Save</MenuItem>
        <MenuSubmenuRoot>
            <MenuSubmenuTrigger data-testid="share-trigger">Share</MenuSubmenuTrigger>
            <MenuPortal>
                <MenuPositioner data-testid="share-menu">
                    <MenuPopup>
                        <MenuItem data-testid="share-item-1">Email</MenuItem>
                        <MenuItem data-testid="share-item-2">Print</MenuItem>
                    </MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuSubmenuRoot>
    </text>;

    private RenderFragment EditItems => @<text>
        <MenuItem data-testid="edit-item-1">Copy</MenuItem>
        <MenuItem data-testid="edit-item-2">Paste</MenuItem>
    </text>;

    private RenderFragment ViewItems => @<text>
        <MenuItem data-testid="view-item-1">Zoom In</MenuItem>
        <MenuItem data-testid="view-item-2">Zoom Out</MenuItem>
        <MenuSubmenuRoot>
            <MenuSubmenuTrigger data-testid="layout-trigger">Layout</MenuSubmenuTrigger>
            <MenuPortal>
                <MenuPositioner data-testid="layout-menu">
                    <MenuPopup>
                        <MenuRadioGroup TValue="string" DefaultValue="@("single")">
                            <MenuRadioItem TValue="string" Value="@("single")" data-testid="layout-item-1">Single column</MenuRadioItem>
                            <MenuRadioItem TValue="string" Value="@("two")" data-testid="layout-item-2">Two columns</MenuRadioItem>
                        </MenuRadioGroup>
                    </MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuSubmenuRoot>
    </text>;
}
