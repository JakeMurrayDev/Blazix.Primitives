@namespace Blazix.Primitives.Fixtures.Client.DialogFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `dialog-conformance` fixture (tests/browser/dialog.spec.ts): popupConformanceTests (tests/browser/suites/) on Dialog,
    a contained trigger, portal, popup and close (DialogRoot.test.tsx's popupConformanceTests host). The query sets the
    root's props:
    - `open=true|false`: a controlled root (the `[data-set-open]` buttons change it, as the suite's rerender does);
      absent, the root is uncontrolled;
    - `defaultOpen`, `cancelOpen`, `cancelClose`, `allowPropagation`, `popupId`, `keepMounted`, `modal=true|false|trap-focus`;
    - `animated`: the popup takes the `dialog-animated` class, 200 ms keyframes on `[data-open]` and `[data-ending-style]`
      (open the page with `?animations=1`).
*@
<FixtureContainer Name="dialog-conformance" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes">
    <style>
        @@keyframes dialog-conformance-enter { from { opacity: 0; } }
        @@keyframes dialog-conformance-exit { to { opacity: 0; } }
        .dialog-animated[data-open] { animation: dialog-conformance-enter 200ms; }
        .dialog-animated[data-ending-style] { animation: dialog-conformance-exit 200ms; }
        /* The suite's rerender clicks these while a modal dialog's internal backdrop covers the page. */
        [data-fixture="dialog-conformance"] [data-set-open] { position: relative; z-index: 1; }
        /* As Base UI's demos position the popup, so a modal dialog's internal backdrop lies under it. */
        [data-base-ui-portal] [role="dialog"] { position: relative; z-index: 1; }
    </style>
    <button type="button" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" data-set-open="true" data-key-control @onclick="() => open = true" @onkeydown="OnShift(() => open = true)">Set open</button>
    <button type="button" data-set-open="false" data-key-control @onclick="() => open = false" @onkeydown="OnShift(() => open = false)">Set closed</button>

    @if (controlled)
    {
        <DialogRoot TPayload="NoPayload" @ref="root" Open="@open" DefaultOpen="@defaultOpen" Modal="@modal" OnOpenChange="RecordOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete">
            @Content
        </DialogRoot>
    }
    else
    {
        <DialogRoot TPayload="NoPayload" @ref="root" DefaultOpen="@defaultOpen" Modal="@modal" OnOpenChange="RecordOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete">
            @Content
        </DialogRoot>
    }
</FixtureContainer>

@code {
    private bool controlled;
    private bool open;
    private bool defaultOpen;
    private bool keepMounted;
    private ModalValue? modal;
    private Dictionary<string, object> popupAttributes = [];
    private DialogTrigger<NoPayload>? trigger;
    private DialogRoot<NoPayload>? root;

    protected override IEnumerable<Task> Attachments =>
        [trigger?.TwinAttached ?? Task.CompletedTask, root?.SessionAttached ?? Task.CompletedTask];

    protected override void OnInitialized()
    {
        controlled = QueryFlag("open") is not null;
        open = QueryFlag("open") == true;
        defaultOpen = QueryFlag("defaultOpen") == true;
        keepMounted = QueryFlag("keepMounted") == true;
        modal = Query("modal") switch
        {
            "false" => (ModalValue?)false,
            "trap-focus" => ModalValue.TrapFocus,
            _ => null,
        };
        popupAttributes["data-testid"] = "popup";
        if (Query("popupId") is { } id)
        {
            popupAttributes["id"] = id;
        }

        if (QueryFlag("animated") == true)
        {
            popupAttributes["class"] = "dialog-animated";
        }
    }

    private RenderFragment Content => @<text>
        <DialogTrigger TPayload="NoPayload" @ref="trigger" data-testid="trigger">Trigger</DialogTrigger>
        <DialogPortal KeepMounted="@keepMounted">
            <DialogPopup @attributes="popupAttributes">
                <span>Popup content</span>
                <DialogClose data-testid="close">Close popup</DialogClose>
            </DialogPopup>
        </DialogPortal>
    </text>;
}
