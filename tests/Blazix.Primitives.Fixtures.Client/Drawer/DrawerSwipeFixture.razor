@namespace Blazix.Primitives.Fixtures.Client.DrawerFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `drawer-swipe` fixture (tests/browser/drawer.spec.ts; M6 track 8b, issue 279): the Viewport's dismiss gesture.
    - `case=right`: DrawerRoot.test.tsx's TestCase, an open drawer swiped to the right; its popup is fixed at the top
      left, 200 px wide and 300 px tall, so the dismiss threshold is 100 px ("uses a size-based swipe threshold"); the
      viewport covers the page, as a Drawer viewport does, so a point past the popup still lands in it.
    - `case=down` (added 2026-11-19): DrawerViewport.test.tsx's drawers, the default direction. The popup is fixed at
      left 0 and top 100, 200 px wide and 300 px tall, and holds a Close button, a Drawer.Content region with
      selectable text and a target, two 40 px regions, one with `data-base-ui-swipe-ignore` and one with the legacy
      `data-swipe-ignore`, and a vertical scroll container 60 px tall over 120 px of content. Selectable text outside the drawer precedes the root.
    - `case=scroll` (added 2026-11-20): DrawerViewport.test.tsx's scroll-edge drawers. The popup is fixed at left 300 and
      top 300, 200 px wide and 300 px tall, and holds a vertical scroll container 60 px tall over 120 px of content and a
      horizontal one 120 px wide over 360 px; `direction` (`down`, the default, `up`, `left` or `right`) is the swipe direction.
    - `noPopup=true`: the Viewport renders no Popup ("ignores swipe input until a popup is mounted").
    - `alwaysOpen=true`: the root is controlled with `Open="true"` and never follows a change.
    The open changes are recorded as `open:reason` in `data-open-changes`; `cancelClose=true` cancels a close and
    `retainEveryClose=true` keeps a close mounted (PopupSuiteFixtureBase). The sync button is the suites' `settle` barrier.
*@
<FixtureContainer Name="drawer-swipe" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <span data-testid="outside-text">Outside selection</span>
    @if (QueryFlag("alwaysOpen") == true)
    {
        <DrawerRoot TPayload="NoPayload" @ref="root" Open="true" SwipeDirection="@Direction" OnOpenChange="RecordOpenChange">
            @Parts
        </DrawerRoot>
    }
    else
    {
        <DrawerRoot TPayload="NoPayload" @ref="root" DefaultOpen="true" SwipeDirection="@Direction" OnOpenChange="RecordOpenChange">
            @Parts
        </DrawerRoot>
    }
</FixtureContainer>

@code {
    private DrawerRoot<NoPayload>? root;
    private DrawerViewport? viewport;

    private bool Down => Case == "down";

    private bool Scroll => Case == "scroll";

    private SwipeDirection Direction => Scroll
        ? Query("direction") switch { "up" => SwipeDirection.Up, "left" => SwipeDirection.Left, "right" => SwipeDirection.Right, _ => SwipeDirection.Down }
        : Down ? SwipeDirection.Down : SwipeDirection.Right;

    private string PopupStyle => Scroll
        ? "position: fixed; left: 300px; top: 300px; width: 200px; height: 300px;"
        : Down
            ? "position: fixed; left: 0; top: 100px; width: 200px; height: 300px;"
            : "position: fixed; left: 0; top: 0; width: 200px; height: 300px;";

    private RenderFragment Parts => @<DrawerPortal>
        <DrawerBackdrop data-testid="backdrop" />
        <DrawerViewport @ref="viewport" data-testid="viewport" style="position: fixed; inset: 0;">
            @if (QueryFlag("noPopup") != true)
            {
            <DrawerPopup data-testid="popup" style="@PopupStyle">
                @if (Scroll)
                {
                    <div data-testid="scroll" style="overflow-y: auto; max-height: 60px;"><div style="height: 120px;">Scrollable content</div></div>
                    <div data-testid="hscroll" style="overflow-x: auto; max-width: 120px;"><div style="width: 360px; height: 40px;">Scrollable content</div></div>
                }
                else if (Down)
                {
                    <DrawerClose>Close</DrawerClose>
                    <DrawerContent>
                        <span data-testid="text">Selectable</span>
                        <div data-testid="content-target" style="height: 100px;">Action</div>
                    </DrawerContent>
                    <div data-testid="ignored" data-base-ui-swipe-ignore style="height: 40px;">Ignored</div>
                    <div data-testid="legacy" data-swipe-ignore style="height: 40px;">Legacy</div>
                    <div data-testid="scroll" style="overflow-y: auto; max-height: 60px;"><div style="height: 120px;">Scrollable content</div></div>
                }
                else
                {
                    @("Drawer")
                }
            </DrawerPopup>
            }
        </DrawerViewport>
    </DrawerPortal>;

    protected override IEnumerable<Task> Attachments =>
        [root?.SessionAttached ?? Task.CompletedTask, viewport?.GestureAttached ?? Task.CompletedTask];
}
