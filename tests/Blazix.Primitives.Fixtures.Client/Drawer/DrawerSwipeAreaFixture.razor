@namespace Blazix.Primitives.Fixtures.Client.DrawerFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `drawer-swipe-area` fixture (tests/browser/drawer.spec.ts; M6 track 8b slice 4, added 2026-11-21): DrawerSwipeArea
    .test.tsx's trees. A root with a swipe area (`swipe-area`, fixed at the top left, 300 by 300 px) and, with `parts`, a
    portal holding a Backdrop (`backdrop`), a Viewport fixed at inset 0 and a popup (`popup`) fixed at the right, `pw` by
    `ph` px (100 by 100 by default), with the inline `transform` the query names. Switches:
    - `area`, `root`: the area's and the root's swipe directions; `disabled`: the area starts disabled; `id`: the area's id;
    - `provider`: a Provider around it all with an Indent (`indent`); `keepMounted`: the portal stays mounted;
    - `open=reject`: the root is controlled and stays closed, recording each request; `modal=false`: a non-modal root;
      `initialFocus=false`: the popup leaves focus where it is. An outside button (`outside-button`) sits beside the target.
    Controls (Shift keydowns, as no outside press reads them): "Disable area", "Enable area", "Change id". The page also has
    an outside target (`outside`). Every open change is recorded in `data-open-changes`.
*@
<FixtureContainer Name="drawer-swipe-area" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges">
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" tabindex="-1" data-disable-area data-key-control @onclick="() => disabled = true" @onkeydown="OnShift(() => disabled = true)">Disable area</button>
    <button type="button" tabindex="-1" data-enable-area data-key-control @onclick="() => disabled = false" @onkeydown="OnShift(() => disabled = false)">Enable area</button>
    <button type="button" tabindex="-1" data-change-id data-key-control @onclick="ChangeId" @onkeydown="OnShift(ChangeId)">Change id</button>
    <div data-testid="outside" style="position: fixed; right: 0; bottom: 0; width: 40px; height: 40px;">Outside</div>
    <button type="button" data-testid="outside-button" style="position: fixed; right: 60px; bottom: 0;">Outside</button>
    @if (QueryFlag("provider") == true)
    {
        <DrawerProvider>
            <DrawerIndent data-testid="indent" />
            @Tree
        </DrawerProvider>
    }
    else
    {
        @Tree
    }
</FixtureContainer>

@code {
    private DrawerRoot<NoPayload>? root;
    private DrawerSwipeArea? area;
    private bool disabled;
    private string areaId = "swipe-area-id";

    /// <inheritdoc />
    protected override IEnumerable<Task> Attachments => [root?.SessionAttached ?? Task.CompletedTask];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        disabled = QueryFlag("disabled") == true;
        areaId = Query("id") ?? areaId;
    }

    private ModalValue Modal => QueryFlag("modal") != false;

    private void ChangeId() => areaId += "-next";

    private SwipeDirection? Direction(string name) => Query(name) switch
    {
        "up" => SwipeDirection.Up,
        "down" => SwipeDirection.Down,
        "left" => SwipeDirection.Left,
        "right" => SwipeDirection.Right,
        _ => null,
    };

    private RenderFragment Tree => @<text>
        @if (Query("open") == "reject")
        {
            <DrawerRoot TPayload="NoPayload" @ref="root" Open="false" Modal="@Modal" SwipeDirection="@(Direction("root") ?? SwipeDirection.Down)" OnOpenChange="RecordOpenChange">
                @Parts
            </DrawerRoot>
        }
        else
        {
            <DrawerRoot TPayload="NoPayload" @ref="root" Modal="@Modal" SwipeDirection="@(Direction("root") ?? SwipeDirection.Down)" OnOpenChange="RecordOpenChange">
                @Parts
            </DrawerRoot>
        }
    </text>;

    private RenderFragment Parts => @<text>
        <DrawerSwipeArea @ref="area" id="@areaId" data-testid="swipe-area" SwipeDirection="@Direction("area")" Disabled="@disabled"
                         style="position: fixed; left: 0; top: 0; width: 300px; height: 300px;" />
        @if (QueryFlag("parts") == true)
        {
            <DrawerPortal KeepMounted="@(QueryFlag("keepMounted") == true)">
                <DrawerBackdrop data-testid="backdrop" />
                <DrawerViewport style="position: fixed; inset: 0; pointer-events: none;">
                    <DrawerPopup data-testid="popup" style="@PopupStyle" InitialFocus="@(QueryFlag("initialFocus") == false ? false : null)">Drawer</DrawerPopup>
                </DrawerViewport>
            </DrawerPortal>
        }
    </text>;

    private string PopupStyle =>
        $"position: fixed; right: 0; top: 0; width: {Query("pw") ?? "100"}px; height: {Query("ph") ?? "100"}px; margin: 0; padding: 0; border: 0; pointer-events: auto;"
        + (Query("transform") is { } transform ? $" transform: {transform};" : string.Empty);
}
