@namespace Blazix.Primitives.Fixtures.Client.DrawerFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `drawer-popup` fixture (tests/browser/drawer.spec.ts): DrawerPopup.test.tsx's focus and key trees.
    - `case=focus`: the page's input, then a non-modal drawer, trigger "Open", popup `popup` holding the input `popup-input`
      ("defaults initial focus to the popup element");
    - `case=focus-disabled`: the same drawer with `InitialFocus="false"` ("leaves focus on the trigger when initial focus is
      disabled");
    - `case=composite`: an open non-modal drawer whose portal's container is the page's `wrapper` element, so its keydowns
      bubble to the wrapper's native listener as React's portal bubbles them to the wrapper's `onKeyDown` ("stops composite
      navigation keys from escaping the popup"); the popup holds the input "Field".
*@
<FixtureContainer Name="drawer-popup" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes">
    <button type="button" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    @if (Case == "composite")
    {
        <div id="drawer-wrapper" data-testid="wrapper"></div>
        <DrawerRoot TPayload="NoPayload" @ref="root" Open="true" Modal="false" OnOpenChange="RecordOpenChange">
            <DrawerPortal Container="@("#drawer-wrapper")">
                <DrawerViewport>
                    <DrawerPopup @ref="popup" data-testid="popup">
                        <input aria-label="Field" />
                    </DrawerPopup>
                </DrawerViewport>
            </DrawerPortal>
        </DrawerRoot>
    }
    else
    {
        <input data-testid="page-input" />
        <DrawerRoot TPayload="NoPayload" @ref="root" Modal="false" OnOpenChange="RecordOpenChange">
            <DrawerTrigger @ref="trigger">Open</DrawerTrigger>
            <DrawerPortal>
                <DrawerViewport>
                    @if (Case == "focus-disabled")
                    {
                        <DrawerPopup data-testid="popup" InitialFocus="false">Drawer</DrawerPopup>
                    }
                    else
                    {
                        <DrawerPopup data-testid="popup">
                            <input data-testid="popup-input" />
                        </DrawerPopup>
                    }
                </DrawerViewport>
            </DrawerPortal>
        </DrawerRoot>
    }
</FixtureContainer>

@code {
    private DrawerRoot<NoPayload>? root;
    private DrawerTrigger<NoPayload>? trigger;
    private DrawerPopup? popup;

    protected override IEnumerable<Task> Attachments =>
        [trigger?.TwinAttached ?? Task.CompletedTask, root?.SessionAttached ?? Task.CompletedTask, popup?.TwinAttached ?? Task.CompletedTask];
}
