@namespace Blazix.Primitives.Fixtures.Client.SliderFixtures
@using Blazix.Primitives
@inherits SliderFixtureBase

@*
    The `slider-prerender` fixture (tests/browser/slider.field.spec.ts), prerendered: SliderRoot.test.tsx "does not link
    Slider.Label before hydration" (SLD-ARIA-12) and SliderThumb.test.tsx's "server-side rendering" titles (SLD-ANI-05).
    Two centre-mode roots, 100 px wide: `single` (DefaultValue 30, a SliderLabel "Volume", a Value, an Indicator, one
    thumb) and `range` (DefaultValues 30 and 40, a SliderLabel "Price range", a Value, an Indicator, thumbs with `Index`).
    The static response is the server's render; the labels publish their ids after the interactive render.
*@
<FixtureContainer Name="slider-prerender" data-attached="@(Attached ? "true" : "false")">
    <div data-case="single">
        <SliderRoot @ref="Root" DefaultValue="30" Culture="@Culture" data-testid="root" style="width: 100px">
            <SliderLabel @ref="Label" data-testid="label">Volume</SliderLabel>
            <SliderValue data-testid="value" />
            <SliderControl data-testid="control" style="position: relative; height: 10px">
                <SliderTrack data-testid="track" style="width: 100%; height: 100%">
                    <SliderIndicator data-testid="indicator" />
                    <SliderThumb data-testid="thumb" style="width: 10px; height: 10px" />
                </SliderTrack>
            </SliderControl>
        </SliderRoot>
    </div>
    <div data-case="range">
        <SliderRoot @ref="Root" DefaultValues="@rangeValues" Culture="@Culture" data-testid="root" style="width: 100px">
            <SliderLabel @ref="Label" data-testid="label">Price range</SliderLabel>
            <SliderValue data-testid="value" />
            <SliderControl data-testid="control" style="position: relative; height: 10px">
                <SliderTrack data-testid="track" style="width: 100%; height: 100%">
                    <SliderIndicator data-testid="indicator" />
                    <SliderThumb Index="0" data-testid="thumb" style="width: 10px; height: 10px" />
                    <SliderThumb Index="1" data-testid="thumb" style="width: 10px; height: 10px" />
                </SliderTrack>
            </SliderControl>
        </SliderRoot>
    </div>
</FixtureContainer>

@code {
    private readonly double[] rangeValues = [30, 40];

    private static System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.GetCultureInfo("en-US");
}
