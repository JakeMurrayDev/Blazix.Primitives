        .motion-panel[data-ending-style] {
            height: 0;
        }

        .fading-panel {
            overflow: hidden;
            height: var(--collapsible-panel-height);
            opacity: 1;
            transition: height 1000ms linear, opacity 1000ms linear;
        }

        .fading-panel[data-starting-style],
        .fading-panel[data-ending-style] {
            height: 0;
            opacity: 0;
        }

        .keyframe-panel {
            overflow: hidden;
        }

        .keyframe-panel[data-open] {
            animation: panel-slide-down 100ms ease-out;
        }

        .keyframe-panel[data-closed] {
            animation: panel-slide-up 100ms ease-in;
        }
    </style>

