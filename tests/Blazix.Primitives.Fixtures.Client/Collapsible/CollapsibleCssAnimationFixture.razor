@namespace Blazix.Primitives.Fixtures.Client.CollapsibleFixtures
@using Blazix.Primitives
@inherits CollapsibleFixtureBase

@*
    The `collapsible-css-animation` fixture (tests/browser/collapsible.spec.ts): CollapsiblePanel.test.tsx "CSS
    animations", one case per Base UI test (the render-function case is in `collapsible-render-function`).
*@
<FixtureContainer Name="collapsible-css-animation" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync">
    <style>
        @@keyframes panel-slide-down {
            from {
                height: 0;
            }

            to {
                height: var(--collapsible-panel-height);
            }
        }

        @@keyframes panel-slide-up {
            from {
                height: var(--collapsible-panel-height);
            }

            to {
                height: 0;
            }
        }

        .animation-test-panel[data-open] {
            overflow: hidden;
            animation: panel-slide-down 100ms linear;
        }

        .close-reopen-panel[data-open] {
            overflow: hidden;
            animation: panel-slide-down 100ms linear;
        }

        .close-reopen-panel[data-closed] {
            overflow: hidden;
            animation: panel-slide-up 100ms linear;
        }

        .closing-animation-panel[data-closed] {
            overflow: hidden;
            animation: panel-slide-up 100ms linear;
        }
    </style>

    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>

    <CollapsibleCaseFrame Name="initially-open" Case="initiallyOpen">
        <CollapsibleRoot @ref="initiallyOpenRoot" DefaultOpen="true" data-root>
            <CollapsibleTrigger @ref="initiallyOpenTrigger">Trigger</CollapsibleTrigger>
            <CollapsiblePanel @ref="initiallyOpenPanel" class="animation-test-panel" data-panel>This is panel content</CollapsiblePanel>
        </CollapsibleRoot>
    </CollapsibleCaseFrame>

    <CollapsibleCaseFrame Name="close-reopen" Case="closeReopen">
