            <CollapsibleTrigger @ref="closeReopenTrigger">Trigger</CollapsibleTrigger>
            <CollapsiblePanel @ref="closeReopenPanel" class="close-reopen-panel" data-panel KeepMounted="true">This is panel content</CollapsiblePanel>
        </CollapsibleRoot>
    </CollapsibleCaseFrame>

    <CollapsibleCaseFrame Name="closing-keyframe" Case="closingKeyframe">
        <CollapsibleRoot @ref="closingKeyframeRoot" DefaultOpen="true" data-root>
            <CollapsibleTrigger @ref="closingKeyframeTrigger">Trigger</CollapsibleTrigger>
            <CollapsiblePanel @ref="closingKeyframePanel" class="closing-animation-panel" data-panel>This is panel content</CollapsiblePanel>
        </CollapsibleRoot>
    </CollapsibleCaseFrame>

    <CollapsibleCaseFrame Name="only-open-keyframes" Case="onlyOpenKeyframes">
