@namespace Blazix.Primitives.Fixtures.Client.PopoverFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `popover-nested-menu` fixture (tests/browser/popover.spec.ts, M6 track 11, issue 263): PopoverRoot.test.tsx's
    "nested menu interactions", a TestPopover inside an open `<dialog>` that is both portals' container (Base UI's shared
    container), once per `variant` as popover-root's (`contained`, `detached`, `multiple`). The trigger `trigger` reads
    "Toggle"; the popup `popover-popup` holds a Menu whose trigger reads "Open nested" and whose popup `menu-popup` reads
    "Nested Menu", or, with `item=true`, holds an item "Item" that does not close on click. The menu's trigger renders once
    the popover opens, after the page's readiness: an OpenOnMount beside it waits for its handles, and the container then
    renders `data-child-attached="true"`.
*@
<FixtureContainer Name="popover-nested-menu" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-child-attached="@(childAttached ? "true" : "false")" data-open-changes="@OpenChanges">
    <dialog open id="popover-nested-menu-dialog">
        @if (variant == "contained")
        {
            <PopoverRoot TPayload="NoPayload" @ref="root" OnOpenChange="RecordOpenChange">
                @Trigger(null)
                @Portal
            </PopoverRoot>
        }
        else
        {
            @Trigger(handle)
            @if (variant == "multiple")
            {
                <PopoverTrigger TPayload="NoPayload" @ref="second" Handle="@handle" data-testid="trigger-2">Toggle another</PopoverTrigger>
            }
            <PopoverRoot TPayload="NoPayload" @ref="root" Handle="@handle" OnOpenChange="RecordOpenChange">
                @Portal
            </PopoverRoot>
        }
    </dialog>
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
</FixtureContainer>

@code {
    private const string Container = "#popover-nested-menu-dialog";
    private readonly PopoverHandle<NoPayload> handle = new();
    private PopoverRoot<NoPayload>? root;
    private PopoverTrigger<NoPayload>? trigger;
    private PopoverTrigger<NoPayload>? second;
    private MenuTrigger<NoPayload>? menuTrigger;
    private bool childAttached;
    private bool item;
    private string variant = "contained";

    protected override IEnumerable<Task> Attachments =>
    [
        trigger?.TwinsAttached ?? Task.CompletedTask,
        second?.TwinsAttached ?? Task.CompletedTask,
        root?.SessionAttached ?? Task.CompletedTask,
    ];

    private RenderFragment Portal => @<PopoverPortal Container="@Container">
        <PopoverPositioner data-testid="positioner">
            <PopoverPopup data-testid="popover-popup">
                <MenuRoot TPayload="NoPayload">
                    <MenuTrigger TPayload="NoPayload" @ref="menuTrigger">Open nested</MenuTrigger>
                    <OpenOnMount Run="ChildMountedAsync" />
                    <MenuPortal Container="@Container">
                        <MenuPositioner>
                            <MenuPopup data-testid="menu-popup">
                                @if (item)
                                {
                                    <MenuItem CloseOnClick="false">Item</MenuItem>
                                }
                                else
                                {
                                    @("Nested Menu")
                                }
                            </MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </PopoverPopup>
        </PopoverPositioner>
    </PopoverPortal>;

    protected override void OnInitialized()
    {
        variant = Query("variant") ?? "contained";
        item = QueryFlag("item") == true;
    }

    private RenderFragment Trigger(PopoverHandle<NoPayload>? triggerHandle) =>
        @<PopoverTrigger TPayload="NoPayload" @ref="trigger" Handle="@triggerHandle" data-testid="trigger">Toggle</PopoverTrigger>;

    private async Task ChildMountedAsync()
    {
        await (menuTrigger?.TwinsAttached ?? Task.CompletedTask);
        childAttached = true;
        StateHasChanged();
    }
}
