@namespace Blazix.Primitives.Fixtures.Client.TabsFixtures
@using Blazix.Primitives
@inherits TabsFixtureBase

@*
    The `tabs-activation` fixture (tests/browser/tabs.spec.ts, groups C and D): the click, focus, press and key activation
    pages of TabsRoot.test.tsx and TabsTab.test.tsx, and the request pages (a cancel, a controlled parent that ignores or
    applies the change). Every case records OnValueChange and the consumer's handlers on its Tabs.
*@
<FixtureContainer Name="tabs-activation" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>

    @* TabsRoot.test.tsx "should call onValueChange when clicking", "…non-main button clicks", "…when already active". *@
    <TabsCaseFrame Name="controlled" Case="controlled">
        <TabsRoot TValue="int" Value="0" OnValueChange="controlled.Change" data-root>
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "selects the clicked tab" and TabsList.test.tsx "sets the aria-selected attribute on the active tab". *@
    <TabsCaseFrame Name="uncontrolled" Case="uncontrolled">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="uncontrolled.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="false">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 1</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 2</TabsTab>
                <TabsTab @ref="IntTab" Value="2" data-tab="2">Tab 3</TabsTab>
            </TabsList>
            <TabsPanel @ref="IntPanel" Value="0" KeepMounted="true" data-panel="0">Panel 1</TabsPanel>
            <TabsPanel @ref="IntPanel" Value="1" KeepMounted="true" data-panel="1">Panel 2</TabsPanel>
            <TabsPanel @ref="IntPanel" Value="2" KeepMounted="true" data-panel="2">Panel 3</TabsPanel>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "does not select the clicked disabled tab". *@
    <TabsCaseFrame Name="disabled" Case="disabled">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="disabled.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="false">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 1</TabsTab>
                <TabsTab @ref="IntTab" Value="1" Disabled="true" @onclick="disabled.Click" data-tab="1">Tab 2</TabsTab>
                <TabsTab @ref="IntTab" Value="2" data-tab="2">Tab 3</TabsTab>
            </TabsList>
            <TabsPanel @ref="IntPanel" Value="0" KeepMounted="true" data-panel="0">Panel 1</TabsPanel>
            <TabsPanel @ref="IntPanel" Value="1" KeepMounted="true" data-panel="1">Panel 2</TabsPanel>
            <TabsPanel @ref="IntPanel" Value="2" KeepMounted="true" data-panel="2">Panel 3</TabsPanel>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "when `activateOnFocus = true` should call onValueChange on pointerdown" and "…if an unactive tab gets focused". *@
    <TabsCaseFrame Name="focus-on" Case="focusOn">
        <TabsRoot TValue="int" Value="0" OnValueChange="focusOn.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="true">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" @onpointerdown="focusOn.PointerDown" data-tab="1">Tab 1</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "when `activateOnFocus = false` should not call onValueChange if an unactive tab gets focused". *@
    <TabsCaseFrame Name="focus-off" Case="focusOff">
        <TabsRoot TValue="int" Value="1" OnValueChange="focusOff.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="false">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsTab.test.tsx "pointer interaction": TwoTabs, with the second Tab enabled, then disabled. *@
    <TabsCaseFrame Name="pointer" Case="pointer">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="pointer.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="true">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">One</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Two</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="pointer-disabled" Case="pointerDisabled">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="pointerDisabled.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="true">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">One</TabsTab>
                <TabsTab @ref="IntTab" Value="1" Disabled="true" @onpointerdown="pointerDisabled.PointerDown" @onclick="pointerDisabled.Click" data-tab="1">Two</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsTab.test.tsx "activates the focused tab with %s when `activateOnFocus` is false". *@
    <TabsCaseFrame Name="keys" Case="keys">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="keys.Change" data-root>
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">One</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Two</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsTab.test.tsx "renders as an anchor and toggles selection when `nativeButton` is false", and the `<a href>`
       substitute TAB-API-09/TAB-KEY-16 re-cite "renders a react-router Link" to (ADR 13 Amendments 2026-10-22). *@
    <TabsCaseFrame Name="anchor" Case="anchor">
        <TabsRoot TValue="string" DefaultValue="@("overview")" OnValueChange="anchor.Change" data-root>
            <TabsList @ref="List">
                <TabsTab @ref="StringTab" Value="@("overview")" NativeButton="false" data-tab="overview">
                    <Render><a href="@(PageUrl + "#overview")"></a></Render>
                    <ChildContent>Overview</ChildContent>
                </TabsTab>
                <TabsTab @ref="StringTab" Value="@("details")" NativeButton="false" data-tab="details">
                    <Render><a href="@(PageUrl + "#details")"></a></Render>
                    <ChildContent>Details</ChildContent>
                </TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "does not move an uncontrolled selection when a user-initiated change is canceled". *@
    <TabsCaseFrame Name="cancel" Case="cancel">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="cancel.Change" data-root>
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
            </TabsList>
            <TabsPanel @ref="IntPanel" Value="0" KeepMounted="true" data-panel="0">Panel 0</TabsPanel>
            <TabsPanel @ref="IntPanel" Value="1" KeepMounted="true" data-panel="1">Panel 1</TabsPanel>
        </TabsRoot>
    </TabsCaseFrame>

    @* A controlled parent that applies the change (`apply`), for the commit's timing per mode. *@
    <TabsCaseFrame Name="applied" Case="applied">
        <TabsRoot TValue="int" Value="appliedValue" OnValueChange="applied.Change" data-root>
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    @* TabsRoot.test.tsx "keeps a nested root independent from the one hosting its panel". *@
    <TabsCaseFrame Name="nested" Case="nested">
        <TabsRoot TValue="string" DefaultValue="@("outer-1")" data-root>
            <TabsList @ref="List" data-list="outer">
                <TabsTab @ref="StringTab" Value="@("outer-1")" data-tab="outer-1">Outer 1</TabsTab>
                <TabsTab @ref="StringTab" Value="@("outer-2")" data-tab="outer-2">Outer 2</TabsTab>
            </TabsList>
            <TabsPanel @ref="StringPanel" Value="@("outer-1")" data-panel="outer-1">
                <TabsRoot TValue="string" DefaultValue="@("inner-1")">
                    <TabsList @ref="List" data-list="inner">
                        <TabsTab @ref="StringTab" Value="@("inner-1")" data-tab="inner-1">Inner 1</TabsTab>
                        <TabsTab @ref="StringTab" Value="@("inner-2")" data-tab="inner-2">Inner 2</TabsTab>
                    </TabsList>
                    <TabsPanel @ref="StringPanel" Value="@("inner-1")" data-panel="inner-1">Inner panel 1</TabsPanel>
                    <TabsPanel Value="@("inner-2")" data-panel="inner-2">Inner panel 2</TabsPanel>
                </TabsRoot>
            </TabsPanel>
            <TabsPanel Value="@("outer-2")" data-panel="outer-2">Outer panel 2</TabsPanel>
        </TabsRoot>
    </TabsCaseFrame>

    @* TAB-PTR-09: the consumer's onclick and onfocus call PreventPartHandler() (port titles per mode). *@
    <TabsCaseFrame Name="veto" Case="veto">
        <TabsRoot TValue="int" DefaultValue="0" OnValueChange="veto.Change" data-root>
            <TabsList @ref="List" ActivateOnFocus="vetoFocus">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" @onclick="veto.Click" @onfocus="veto.Focus" data-tab="1">Tab 1</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>
</FixtureContainer>

@code {
    private readonly TabsCase controlled = new();
    private readonly TabsCase uncontrolled = new();
    private readonly TabsCase disabled = new();
    private readonly TabsCase focusOn = new();
    private readonly TabsCase focusOff = new();
    private readonly TabsCase pointer = new();
    private readonly TabsCase pointerDisabled = new();
    private readonly TabsCase keys = new();
    private readonly TabsCase anchor = new();
    private readonly TabsCase cancel = new() { Cancel = true };
    private readonly TabsCase applied = new();
    private readonly TabsCase veto = new();
    private readonly TabsCase nested = new();
    private int appliedValue;
    private bool vetoFocus;

    protected override void OnInitialized()
    {
        applied.Apply = value => appliedValue = (int)value!;
        veto.Veto = Query("veto", "true") == "true";
        vetoFocus = Query("vetoFocus", "false") == "true";
    }
}
