@namespace Blazix.Primitives.Fixtures.Client.TabsFixtures
@using Blazix.Primitives
@inherits TabsFixtureBase

@*
    The `tabs-list` fixture (tests/browser/tabs.spec.ts, group B): TabsList.test.tsx's `loopFocus` pages and its "roving
    focus after tab removal" pages, and TabsRoot.test.tsx's "keeps a roving focus entry point when a controlled selected tab
    is removed". Each removal case has buttons that remove Tabs, as the tests' setProps does.
*@
<FixtureContainer Name="tabs-list" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>

    <TabsCaseFrame Name="loop-first" Case="loopFirst">
        <TabsRoot TValue="int" Value="0">
            <TabsList @ref="List" LoopFocus="false">
                @for (int index = 0; index < 3; index++)
                {
                    int value = index;
                    <TabsTab @ref="IntTab" Value="value" data-tab="@value">Tab @value</TabsTab>
                }
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="loop-last" Case="loopLast">
        <TabsRoot TValue="int" Value="2">
            <TabsList @ref="List" LoopFocus="false">
                @for (int index = 0; index < 3; index++)
                {
                    int value = index;
                    <TabsTab @ref="IntTab" Value="value" data-tab="@value">Tab @value</TabsTab>
                }
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="hidden-successor" Case="hiddenSuccessor">
        <button type="button" data-action="remove-middle" @onclick="() => showMiddle = false">Remove middle</button>
        <TabsRoot TValue="int" DefaultValue="0">
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                @if (showMiddle)
                {
                    <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
                }
                <TabsTab @ref="IntTab" Value="2" hidden data-tab="2">Tab 2</TabsTab>
                <TabsTab @ref="IntTab" Value="3" data-tab="3">Tab 3</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="disabled-fallback" Case="disabledFallback">
        <button type="button" data-action="remove-selected" @onclick="() => showSelected = false">Remove selected</button>
        <TabsRoot TValue="int" Value="2">
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" Disabled="true" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
                @if (showSelected)
                {
                    <TabsTab @ref="IntTab" Value="2" data-tab="2">Tab 2</TabsTab>
                }
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="successors" Case="successors">
        <button type="button" data-action="remove-selected" @onclick="() => successorSelected = false">Remove selected</button>
        <button type="button" data-action="remove-first" @onclick="() => successorFirst = false">Remove first</button>
        <TabsRoot TValue="int" Value="1">
            <TabsList @ref="List">
                @if (successorFirst)
                {
                    <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                }
                @if (successorSelected)
                {
                    <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
                }
                <TabsTab @ref="IntTab" Value="2" data-tab="2">Tab 2</TabsTab>
                <TabsTab @ref="IntTab" Value="3" data-tab="3">Tab 3</TabsTab>
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>

    <TabsCaseFrame Name="entry-point" Case="entryPoint">
        <button type="button" data-action="remove-last" @onclick="() => showLast = false">Remove last</button>
        <TabsRoot TValue="int" Value="2" OnValueChange="entryPoint.Change">
            <TabsList @ref="List">
                <TabsTab @ref="IntTab" Value="0" data-tab="0">Tab 0</TabsTab>
                <TabsTab @ref="IntTab" Value="1" data-tab="1">Tab 1</TabsTab>
                @if (showLast)
                {
                    <TabsTab @ref="IntTab" Value="2" data-tab="2">Tab 2</TabsTab>
                }
            </TabsList>
        </TabsRoot>
    </TabsCaseFrame>
</FixtureContainer>

@code {
    private readonly TabsCase loopFirst = new();
    private readonly TabsCase loopLast = new();
    private readonly TabsCase hiddenSuccessor = new();
    private readonly TabsCase disabledFallback = new();
    private readonly TabsCase successors = new();
    private readonly TabsCase entryPoint = new();
    private bool showMiddle = true;
    private bool showSelected = true;
    private bool successorFirst = true;
    private bool successorSelected = true;
    private bool showLast = true;
}
