        closeDelay = Query("closeDelay") is { } c ? new Duration(int.Parse(c, System.Globalization.CultureInfo.InvariantCulture)) : null;
        orientation = Query("orientation") == "vertical" ? Orientation.Vertical : Orientation.Horizontal;
        rtl = QueryFlag("rtl") == true;
        side = Query("side") switch
        {
            "left" => Side.Left,
            "top" => Side.Top,
            "inline-start" => Side.InlineStart,
            "inline-end" => Side.InlineEnd,
            _ => orientation == Orientation.Vertical ? Side.Right : null,
        };
        keepMounted = QueryFlag("keepMounted") == true;
        keepMountedContent = QueryFlag("keepMountedContent") == true;
        disabled = Query("disabled");
        topLink = QueryFlag("topLink") == true;
        closeOnClick = QueryFlag("closeOnClick") == true;
        nested = Query("nested") is "inline" or "portal" or "deep" or "falsy" or "tabBoundary" or "tabFlow" ? Query("nested") : null;
        nestedDefault = Query("nestedDefault");
        sized = QueryFlag("sized") == true;
        fade = QueryFlag("fade") == true;
        contentFade = QueryFlag("contentFade") == true;
        fluid = QueryFlag("fluid") == true;
        noViewport = QueryFlag("noViewport") == true;
        arrow = QueryFlag("arrow") == true;
        fixedValue = QueryFlag("fixed") == true;
        roomy = Query("side") is not null;
        vetoOpenKey = QueryFlag("vetoOpenKey") == true;
        scopedExit = QueryFlag("scopedExit") == true;
        emptyItem = QueryFlag("emptyItem") == true;
        customList = QueryFlag("customList") == true;
        actionContent = QueryFlag("actionContent") == true;
        nestedSide = Query("nestedSide") is "right" or "left" or "bottom" or "top" ? Query("nestedSide") : null;
        nestedPopup = Query("nestedPopup") is "dialog" or "popover" ? Query("nestedPopup") : null;
    }

    private void DropFirst()
    {
        firstDropped = true;
        controlledValue = null;
    }

    private async Task MarkAsync(Task attached, string handle)
    {
        await attached;
        handles.Add(handle);
        await InvokeAsync(StateHasChanged);
    }

    private void VetoOpenKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            vetoCalls++;
            e.PreventPartHandler();
        }
    }

    private string? ContentClass(int n)
    {
        string? size = sized ? "sized-" + n.ToString(System.Globalization.CultureInfo.InvariantCulture) : fluid && n == 1 ? "fluid" : null;
        string? fadeClass = contentFade ? "content-fade" : scopedExit ? "scoped-content" : null;
        return fadeClass is null ? size : size is null ? fadeClass : size + " " + fadeClass;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && root is not null)
        {
            attachments.Add(root.TwinsAttached);
            foreach (NavigationMenuTrigger? trigger in triggers)
            {
                if (trigger is not null)
                {
                    attachments.Add(trigger.TwinsAttached);
                    int n = Array.IndexOf(triggers, trigger);
                    _ = MarkAsync(trigger.ModuleAttached, $"trigger-{n}:navigation-menu");
                    _ = MarkAsync(trigger.InteractionsAttached, $"trigger-{n}:interactions");
                }
            }
        }
    }

