@namespace Blazix.Primitives.Fixtures.Client.NavigationMenuFixtures
@using Blazix.Primitives
@inherits NavigationMenuFixtureBase

@*
    The `navigation-menu-basic` fixture (tests/browser/navigation-menu.spec.ts, M5 track 5): NavigationMenuRoot.test.tsx's
    TestNavigationMenu. Two Items `item-1` and `item-2`, each a Trigger `trigger-<n>` ("Item <n>", an Icon) and a Content
    `content-<n>` with two Links `link-<n>-a`, `link-<n>-b`; a Portal, a Positioner `positioner`, a Popup `popup-root`, a
    Viewport `viewport`. The query:
    - `value` makes the Root controlled (`none` is null; `[data-set-value]` buttons set it); `defaultValue`; `delay`,
      `closeDelay` (ms); `orientation=vertical`; `rtl` (a DirectionProvider); `side` (the Positioner's: `left`,
      `inline-start`, `inline-end`, `top`); `keepMounted` (the Portal), `keepMountedContent`;
    - `disabled=<n>` disables trigger `<n>` (`[data-enable]` enables it again); `topLink` adds an Item with a Link
      `top-link`; `closeOnClick` on every Link;
    - `nested=inline` puts an inline nested Root (List and Viewport `nested-viewport`, Items `nested-<n>`) in content 1,
      `nestedDefault=nested-1` its default; `sized` gives content 1 400×200 and content 2 300×150, fixed;
    - `fade` gives the Popup a 400 ms exit animation `nav-popup-out`, `contentFade` every Content one, `nav-content-out`
      (with the host's `animations=1`); `fluid` makes content 1 40vw wide;
      `noViewport` renders the text "Popup" in the Popup instead of a Viewport; `arrow` adds an Arrow `arrow`;
    - `fixed` keeps a controlled value where the page set it (ValueChanged ignored); `cancel`, `retain` (the base's).
    With `side`, the menu sits 300 px down and 400 px in, so the requested side has room.
    The List is a row (a column when vertical, the Positioner then on the right), so the popup never covers a trigger.
    Around the menu: a `before` and an `after` button, in that order in the DOM but laid out in a row above the menu, so
    the popup never covers them either. `[data-unmount]` calls Unmount, `[data-close]` CloseAsync.
*@
<FixtureContainer Name="navigation-menu-basic" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-value-changes="@ValueChanges" data-open-change-completes="@OpenChangeCompletes">
    <style>
        .sized-1 { width: 400px; height: 200px; }
        .sized-2 { width: 300px; height: 150px; }
        @@keyframes nav-popup-out { to { opacity: 0; } }
        @@keyframes nav-content-out { to { opacity: 0; } }
        .fade[data-ending-style] { animation: nav-popup-out 400ms; }
        .content-fade[data-ending-style] { animation: nav-content-out 400ms; }
        .fluid { width: 40vw; }
        .menu-frame.roomy { margin: 300px 0 0 400px; }
        [data-testid="popup-root"] { width: var(--popup-width, auto); height: var(--popup-height, auto); }
        [data-testid="list"], [data-testid="nested-list"] { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
        [data-testid="list"].vertical { flex-direction: column; align-items: flex-start; }
        .menu-frame { display: grid; grid-template-columns: max-content max-content 1fr; grid-template-areas: "before after ." "menu menu menu"; gap: 8px; align-items: start; }
        .menu-frame > [data-testid="before"] { grid-area: before; }
        .menu-frame > [data-testid="after"] { grid-area: after; }
        .menu-frame > [data-testid="root"] { grid-area: menu; }
    </style>
    <div class="@(roomy ? "menu-frame roomy" : "menu-frame")">
        <button type="button" data-testid="before">Before</button>
        @if (rtl)
        {
            <DirectionProvider Direction="TextDirection.Rtl">@Menu</DirectionProvider>
        }
        else
        {
            @Menu
        }
        <button type="button" data-testid="after">After</button>
    </div>
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" tabindex="-1" data-unmount data-key-control @onclick="() => root?.Unmount()" @onkeydown="OnShift(() => root?.Unmount())">Unmount</button>
    <button type="button" tabindex="-1" data-close data-key-control @onclick="() => root!.CloseAsync()" @onkeydown="OnShift(() => root!.CloseAsync())">Close</button>
    @if (disabled is not null)
    {
        <button type="button" tabindex="-1" data-enable data-key-control @onclick="() => disabled = null" @onkeydown="OnShift(() => disabled = null)">Enable</button>
    }
    @if (controlled)
    {
        <button type="button" tabindex="-1" data-set-value="none" data-key-control @onclick="() => controlledValue = null" @onkeydown="OnShift(() => controlledValue = null)">Set none</button>
        <button type="button" tabindex="-1" data-set-value="item-1" data-key-control @onclick="@(() => controlledValue = "item-1")" @onkeydown="@(OnShift(() => controlledValue = "item-1"))">Set 1</button>
        <button type="button" tabindex="-1" data-set-value="item-2" data-key-control @onclick="@(() => controlledValue = "item-2")" @onkeydown="@(OnShift(() => controlledValue = "item-2"))">Set 2</button>
    }
</FixtureContainer>

@code {
    private readonly List<Task> attachments = [];
    private readonly NavigationMenuTrigger?[] triggers = new NavigationMenuTrigger?[3];
    private NavigationMenuRoot<string>? root;
    private bool controlled;
    private string? controlledValue;
    private string? defaultValue;
    private Duration? delay;
    private Duration? closeDelay;
    private Orientation orientation = Orientation.Horizontal;
    private bool rtl;
    private Side? side;
    private bool keepMounted;
    private bool keepMountedContent;
    private string? disabled;
    private bool topLink;
    private bool closeOnClick;
    private bool nestedInline;
    private string? nestedDefault;
    private bool sized;
    private bool fade;
    private bool contentFade;
    private bool fluid;
    private bool noViewport;
    private bool arrow;
    private bool fixedValue;
    private bool roomy;

    protected override IEnumerable<Task> Attachments => attachments;

    protected override void OnInitialized()
    {
        string? value = Query("value");
        controlled = value is not null;
        controlledValue = value == "none" ? null : value;
        defaultValue = Query("defaultValue");
        delay = Query("delay") is { } d ? new Duration(int.Parse(d, System.Globalization.CultureInfo.InvariantCulture)) : null;
        closeDelay = Query("closeDelay") is { } c ? new Duration(int.Parse(c, System.Globalization.CultureInfo.InvariantCulture)) : null;
        orientation = Query("orientation") == "vertical" ? Orientation.Vertical : Orientation.Horizontal;
        rtl = QueryFlag("rtl") == true;
        side = Query("side") switch
        {
            "left" => Side.Left,
            "top" => Side.Top,
            "inline-start" => Side.InlineStart,
            "inline-end" => Side.InlineEnd,
            _ => orientation == Orientation.Vertical ? Side.Right : null,
        };
        keepMounted = QueryFlag("keepMounted") == true;
        keepMountedContent = QueryFlag("keepMountedContent") == true;
        disabled = Query("disabled");
        topLink = QueryFlag("topLink") == true;
        closeOnClick = QueryFlag("closeOnClick") == true;
        nestedInline = Query("nested") == "inline";
        nestedDefault = Query("nestedDefault");
        sized = QueryFlag("sized") == true;
        fade = QueryFlag("fade") == true;
        contentFade = QueryFlag("contentFade") == true;
        fluid = QueryFlag("fluid") == true;
        noViewport = QueryFlag("noViewport") == true;
        arrow = QueryFlag("arrow") == true;
        fixedValue = QueryFlag("fixed") == true;
        roomy = Query("side") is not null;
    }

    private string? ContentClass(int n)
    {
        string? size = sized ? "sized-" + n.ToString(System.Globalization.CultureInfo.InvariantCulture) : fluid && n == 1 ? "fluid" : null;
        return contentFade ? size is null ? "content-fade" : size + " content-fade" : size;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && root is not null)
        {
            attachments.Add(root.TwinsAttached);
            foreach (NavigationMenuTrigger? trigger in triggers)
            {
                if (trigger is not null)
                {
                    attachments.Add(trigger.TwinsAttached);
                }
            }
        }
    }

    private RenderFragment Menu => @<text>
    @if (controlled)
    {
        <NavigationMenuRoot TValue="string" @ref="root" Value="@controlledValue" ValueChanged="@(v => controlledValue = fixedValue ? controlledValue : v)" OnValueChange="RecordValueChange" OnOpenChangeComplete="RecordOpenChangeComplete" Delay="delay" CloseDelay="closeDelay" Orientation="orientation" data-testid="root">
            @Body
        </NavigationMenuRoot>
    }
    else
    {
        <NavigationMenuRoot TValue="string" @ref="root" DefaultValue="@defaultValue" OnValueChange="RecordValueChange" OnOpenChangeComplete="RecordOpenChangeComplete" Delay="delay" CloseDelay="closeDelay" Orientation="orientation" data-testid="root">
            @Body
        </NavigationMenuRoot>
    }
</text>;

    private RenderFragment Body => @<text>
    <NavigationMenuList data-testid="list" class="@(orientation == Orientation.Vertical ? "vertical" : null)">
        @for (int i = 1; i <= 2; i++)
        {
            int n = i;
            <NavigationMenuItem TValue="string" Value="@("item-" + n)">
                <NavigationMenuTrigger @ref="triggers[n]" data-testid="@("trigger-" + n)" Disabled="@(disabled == n.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                    Item @n
                    <NavigationMenuIcon />
                </NavigationMenuTrigger>
                <NavigationMenuContent data-testid="@("content-" + n)" KeepMounted="keepMountedContent" class="@ContentClass(n)">
                    <NavigationMenuLink href="@(PageUrl + "#link-" + n + "-a")" CloseOnClick="closeOnClick" data-testid="@("link-" + n + "-a")">Link @n A</NavigationMenuLink>
                    <NavigationMenuLink href="@(PageUrl + "#link-" + n + "-b")" CloseOnClick="closeOnClick" data-testid="@("link-" + n + "-b")">Link @n B</NavigationMenuLink>
                    @if (nestedInline && n == 1)
                    {
                        <NavigationMenuRoot TValue="string" DefaultValue="@nestedDefault" data-testid="nested-root">
                            <NavigationMenuList data-testid="nested-list">
                                @for (int j = 1; j <= 2; j++)
                                {
                                    int m = j;
                                    <NavigationMenuItem TValue="string" Value="@("nested-" + m)">
                                        <NavigationMenuTrigger data-testid="@("nested-trigger-" + m)">Nested @m</NavigationMenuTrigger>
                                        <NavigationMenuContent data-testid="@("nested-content-" + m)">
                                            <NavigationMenuLink href="@(PageUrl + "#nested-" + m)" CloseOnClick="closeOnClick" data-testid="@("nested-link-" + m)">Nested link @m</NavigationMenuLink>
                                        </NavigationMenuContent>
                                    </NavigationMenuItem>
                                }
                            </NavigationMenuList>
                            <NavigationMenuViewport data-testid="nested-viewport" />
                        </NavigationMenuRoot>
                    }
                </NavigationMenuContent>
            </NavigationMenuItem>
        }
        @if (topLink)
        {
            <NavigationMenuItem TValue="string">
                <NavigationMenuLink href="@(PageUrl + "#top")" data-testid="top-link">Top</NavigationMenuLink>
            </NavigationMenuItem>
        }
    </NavigationMenuList>
    <NavigationMenuPortal KeepMounted="keepMounted" data-testid="portal">
        <NavigationMenuPositioner Side="side" data-testid="positioner">
            <NavigationMenuPopup data-testid="popup-root" class="@(fade ? "fade" : null)">
                @if (arrow)
                {
                    <NavigationMenuArrow data-testid="arrow" />
                }
                @if (noViewport)
                {
                    @("Popup")
                }
                else
                {
                    <NavigationMenuViewport data-testid="viewport" />
                }
            </NavigationMenuPopup>
        </NavigationMenuPositioner>
    </NavigationMenuPortal>
</text>;
}
