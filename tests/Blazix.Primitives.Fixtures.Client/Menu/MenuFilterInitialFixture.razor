<FixtureContainer Name="menu-filter-initial" data-attached="@(attached ? "true" : "false")" data-input-attached="@(inputAttached ? "true" : "false")" data-trigger-clicks="@triggerClicks" data-input-keydowns="@inputKeyDowns" data-popup-keydowns="@popupKeyDowns" data-open-completes="@string.Join(' ', openCompletes)" data-value-changes="@string.Join('|', valueChanges)" data-open-changes="@string.Join(' ', openChanges)">
    @if (ExitAnimation)
