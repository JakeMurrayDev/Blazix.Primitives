@code {
    private MenuRoot<NoPayload>? root;
    private MenuInput? input;
    private bool attached;
    private bool attaching;
    private bool inputAttached;
    private bool inputAttaching;

    [SupplyParameterFromQuery(Name = "cancelArrow")]
    public bool CancelArrow { get; set; }

    // `cancelArrow=true`: the consumer's onKeyDown keeps ArrowDown from the trigger's own handling (preventBaseUIHandler).
    // Only then does the trigger carry a consumer handler, which makes each of its keydowns ask C# (design point 6).
    private Dictionary<string, object>? TriggerAttributes => CancelArrow
        ? new() { ["onkeydown"] = EventCallback.Factory.Create<KeyboardEventArgs>(this, OnTriggerKeyDown) }
        : Count ? new() { ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, () => triggerClicks++) } : null;

    // `count=true`: consumer handlers on the trigger's click, the input's keydown and the popup's keydown count their calls.
    private Dictionary<string, object>? InputAttributes => Count
        ? new() { ["onkeydown"] = EventCallback.Factory.Create<KeyboardEventArgs>(this, () => inputKeyDowns++) }
        : null;

    private Dictionary<string, object>? PopupAttributes => Count
        ? new() { ["onkeydown"] = EventCallback.Factory.Create<KeyboardEventArgs>(this, () => popupKeyDowns++) }
        : null;

    private int triggerClicks;
    private int inputKeyDowns;
    private int popupKeyDowns;

    [SupplyParameterFromQuery(Name = "controlled")]
    public bool Controlled { get; set; }

    private bool open;

    // `controlled=true`: the open state is this page's.
    private Dictionary<string, object>? RootParameters => Controlled
        ? new() { ["Open"] = open, ["OpenChanged"] = EventCallback.Factory.Create<bool>(this, value => open = value) }
        : null;

    [SupplyParameterFromQuery(Name = "exitAnimation")]
    public bool ExitAnimation { get; set; }

    [SupplyParameterFromQuery(Name = "query")]
    public string? Query { get; set; }

    private readonly List<string> valueChanges = [];

    private void RecordValue(ValueChangeEventArgs<string> args) => valueChanges.Add($"{args.Value}:{args.Details.Reason.ToLiteral()}");

    [SupplyParameterFromQuery(Name = "cancelOpen")]
    public bool CancelOpenRequests { get; set; }

    private readonly List<string> openChanges = [];

    // Each open request is recorded; `cancelOpen=true` cancels every one that opens.
    private void CancelOpen(ValueChangeEventArgs<bool> args)
    {
        openChanges.Add(args.Value ? "true" : "false");
        if (CancelOpenRequests && args.Value)
        {
            args.Details.Cancel();
        }
    }

    [SupplyParameterFromQuery(Name = "keepMounted")]
    public bool KeepMounted { get; set; }

    [SupplyParameterFromQuery(Name = "count")]
    public bool Count { get; set; }

    private void OnTriggerKeyDown(KeyboardEventArgs args)
    {
        if (CancelArrow && args.Key == "ArrowDown")
        {
            args.PreventPartHandler();
        }
    }

    [SupplyParameterFromQuery(Name = "hover")]
    public bool Hover { get; set; }

    [SupplyParameterFromQuery(Name = "orientation")]
    public string? OrientationName { get; set; }

    [SupplyParameterFromQuery(Name = "plain")]
    public bool Plain { get; set; }

    [SupplyParameterFromQuery(Name = "after")]
    public bool After { get; set; }

    // An open or close renders this component again, so its after-render finds the popup's input; each completion is
    // recorded in `data-open-completes` (space-separated).
    private void OnOpenChangeComplete(bool open) => openCompletes.Add(open ? "true" : "false");

    private readonly List<string> openCompletes = [];

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || root is null)
        {
            return;
        }

        // The input renders with the open popup; its handle attaches after the portal's move, a leg later on Server, and the
        // trigger relays keys only to an attached input.
        if (attached && !inputAttached && !inputAttaching && input is not null)
        {
            inputAttaching = true;
            await input.FilterAttached;
            inputAttached = true;
            StateHasChanged();
            return;
        }

        if (attached || attaching)
        {
            return;
        }

        attaching = true;
        await root.SessionAttached;
        attached = true;
        StateHasChanged();
    }
}
