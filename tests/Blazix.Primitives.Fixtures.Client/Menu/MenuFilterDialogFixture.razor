@code {
    private DialogRoot<NoPayload>? dialog;
    private DialogTrigger<NoPayload>? trigger;
    private bool attached;
    private bool attaching;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (attached || attaching || !RendererInfo.IsInteractive || dialog is null || trigger is null)
