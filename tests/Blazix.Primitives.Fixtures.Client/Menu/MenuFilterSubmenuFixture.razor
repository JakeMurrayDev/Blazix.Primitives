@namespace Blazix.Primitives.Fixtures.Client.MenuFixtures
@using Blazix.Primitives
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

@*
    The `menu-filter-submenu` fixture (tests/browser/menu.filter-submenu.spec.ts, M5 track 12): MenuFilterSubmenuRoot.test.tsx's
    trees, open. A root menu "Actions" whose popup holds the items named by `before` (comma-separated; default "Rename"), a
    submenu whose trigger reads `label` (default "Move to"; `data-testid="submenu-trigger"`), then the items named by `after`
    (default "Delete"). `parent=plain` makes the root plain, with its items directly in the popup; otherwise the root is
    filterable, with an input "Filter actions" and a list. `child=plain` makes the submenu plain; otherwise it is filterable,
    with an input "Filter folders". The submenu's popup (`data-testid="submenu"`) holds a list (`data-testid="submenu-list"`)
    of the items named by `children` (default "Projects,Archive"). `closed=true` starts the root closed; `orientation=horizontal`
    sets the root's orientation; `dir=rtl` the direction; `loop=false` the root's LoopFocus; `disabled` names a root item to
    disable; `auto` ("true" or "always") the submenu's AutoHighlight; `delay` the trigger's Delay in milliseconds (default
    Base UI's); `hover=false` turns the trigger's OpenOnHover off. `nested` names a plain submenu first in the submenu's list,
    whose popup holds Archive; `second` names a second filterable submenu after the `after` items, with an input "Filter
    second" and the items named by `secondChildren` (default "PDF") and its trigger's Delay `secondDelay`. `closeDelay` sets
    both triggers' CloseDelay; `modal=false` the root's Modal; `list=true` wraps a plain root's items in a list
    (`data-testid="parent-list"`, as a filterable root's list is). `detached=true` replaces the root's trigger with two
    detached triggers before the menu, "First trigger" and "Second trigger", on a handle. `shadow=true` portals the
    submenu into an open shadow root on `[data-shadow-host]`, created after the first render. `exiting=true` gives both
    popups the class `exiting`, a 300 ms opacity exit (open the page with `animations=1` for it to run); `slowExit=true` makes
    that exit 10 s. `childOpen=true`
    starts the submenu open; `childQuery` makes the filterable submenu's query controlled, starting at that text;
    `childDefault` sets its uncontrolled DefaultValue; `childCancel=true` cancels every change of it. Each submenu query
    request is recorded as `value:reason` in `data-child-value-changes` (`|`-separated). `afterInput=true` adds an input
    "After" (`data-testid="after-input"`) after the menu. `controlledChild=true` makes the submenu's open state this page's
    (starting at `childOpen`) and adds a button "Outside" after the menu whose Shift keydown closes the submenu (no focus
    move); `extra` names an item that an Alt keydown on "Outside" appends to the submenu's list. Each highlight report of the root is recorded as
    `label:reason:key` (`none` for no item) in `data-highlights`, and each submenu open request as `open:reason` in
    `data-submenu-changes` (`|`-separated). `data-attached` turns "true" once the root's session has attached and, for a
    filterable root that starts open, its input's and list's `menu-filter` handles; `data-child-attached` turns "true" once
    the input of a filterable submenu that starts open (`childOpen=true`) has its handle.
*@
<FixtureContainer Name="menu-filter-submenu" data-attached="@(attached ? "true" : "false")" data-child-attached="@(childAttached ? "true" : "false")" data-highlights="@string.Join('|', highlights)" data-submenu-changes="@string.Join('|', submenuChanges)" data-child-value-changes="@string.Join('|', childValueChanges)">
    @if (Detached)
    {
        <MenuTrigger TPayload="NoPayload" Handle="@handle">First trigger</MenuTrigger>
        <MenuTrigger TPayload="NoPayload" Handle="@handle">Second trigger</MenuTrigger>
    }
    @if (Exiting)
    {
        <style>.exiting { transition: opacity @(SlowExit ? "10s" : "300ms"); } .exiting[data-ending-style] { opacity: 0; }</style>
    }
    <div data-shadow-host @ref="shadowHost"></div>
    <DirectionProvider Direction="@(Dir == "rtl" ? TextDirection.Rtl : TextDirection.Ltr)">
        @if (ParentPlain)
        {
            @RootMenu
        }
        else
        {
            <MenuFilterProvider>@RootMenu</MenuFilterProvider>
        }
    </DirectionProvider>
    @if (ControlledChild)
    {
        <button type="button" data-key-control @onkeydown="CloseChildOnShift">Outside</button>
    }
    @if (AfterInput)
    {
        <input data-testid="after-input" aria-label="After" />
    }
</FixtureContainer>

@code {
    private readonly List<string> highlights = [];
    private readonly List<string> submenuChanges = [];
    private readonly List<string> childValueChanges = [];
    private string? childQuery;
    private readonly MenuHandle<NoPayload> handle = new();
    private ElementReference shadowHost;
    private PortalContainerValue? submenuContainer;
    private MenuRoot<NoPayload>? root;
    private MenuInput? input;
    private MenuList? list;
    private bool attached;
    private bool attaching;
    private MenuInput? childInput;
    private bool childAttached;
    private bool childAttaching;

    [SupplyParameterFromQuery(Name = "parent")]
    public string? Parent { get; set; }

    [SupplyParameterFromQuery(Name = "child")]
    public string? Child { get; set; }

    [SupplyParameterFromQuery(Name = "before")]
    public string? Before { get; set; }

    [SupplyParameterFromQuery(Name = "after")]
    public string? After { get; set; }

    [SupplyParameterFromQuery(Name = "label")]
    public string? Label { get; set; }

    [SupplyParameterFromQuery(Name = "children")]
    public string? Children { get; set; }

    [SupplyParameterFromQuery(Name = "closed")]
    public bool Closed { get; set; }

    [SupplyParameterFromQuery(Name = "orientation")]
    public string? OrientationName { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    [SupplyParameterFromQuery(Name = "loop")]
    public string? Loop { get; set; }

    [SupplyParameterFromQuery(Name = "disabled")]
    public string? DisabledItem { get; set; }

    [SupplyParameterFromQuery(Name = "auto")]
    public string? Auto { get; set; }

    [SupplyParameterFromQuery(Name = "delay")]
    public int? Delay { get; set; }

    [SupplyParameterFromQuery(Name = "nested")]
    public string? Nested { get; set; }

    [SupplyParameterFromQuery(Name = "second")]
    public string? Second { get; set; }

    [SupplyParameterFromQuery(Name = "secondChildren")]
    public string? SecondChildren { get; set; }

    [SupplyParameterFromQuery(Name = "secondDelay")]
    public int? SecondDelay { get; set; }

    [SupplyParameterFromQuery(Name = "closeDelay")]
    public int? CloseDelay { get; set; }

    [SupplyParameterFromQuery(Name = "modal")]
    public string? ModalName { get; set; }

    [SupplyParameterFromQuery(Name = "list")]
    public bool List { get; set; }

    [SupplyParameterFromQuery(Name = "detached")]
    public bool Detached { get; set; }

    [SupplyParameterFromQuery(Name = "exiting")]
    public bool Exiting { get; set; }

    [SupplyParameterFromQuery(Name = "slowExit")]
    public bool SlowExit { get; set; }

    [SupplyParameterFromQuery(Name = "shadow")]
    public bool Shadow { get; set; }

    [SupplyParameterFromQuery(Name = "controlledChild")]
    public bool ControlledChild { get; set; }

    private bool childOpenState;
    private bool extraAdded;

    [SupplyParameterFromQuery(Name = "extra")]
    public string? Extra { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => childOpenState = ChildOpen;

    private Dictionary<string, object>? ChildRootParameters => ControlledChild
        ? new() { ["Open"] = childOpenState, ["OpenChanged"] = EventCallback.Factory.Create<bool>(this, value => childOpenState = value) }
        : null;

    private void CloseChildOnShift(KeyboardEventArgs args)
    {
        if (args.Key == "Shift")
        {
            childOpenState = false;
        }
        else if (args.Key == "Alt")
        {
            extraAdded = true;
        }
    }

    [SupplyParameterFromQuery(Name = "afterInput")]
    public bool AfterInput { get; set; }

    [SupplyParameterFromQuery(Name = "childOpen")]
    public bool ChildOpen { get; set; }

    [SupplyParameterFromQuery(Name = "childQuery")]
    public string? ChildQuery { get; set; }

    [SupplyParameterFromQuery(Name = "childDefault")]
    public string? ChildDefault { get; set; }

    [SupplyParameterFromQuery(Name = "childCancel")]
    public bool ChildCancel { get; set; }

    // The filterable submenu's provider: a controlled query when `childQuery` is given, else uncontrolled.
    private Dictionary<string, object> ChildProviderParameters
    {
        get
        {
            Dictionary<string, object> parameters = new() { ["OnValueChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<string>>(this, RecordChildValue) };
            if (ChildQuery is not null)
            {
                parameters["Value"] = childQuery ??= ChildQuery;
                parameters["ValueChanged"] = EventCallback.Factory.Create<string>(this, value => childQuery = value);
            }
            else if (ChildDefault is not null)
            {
                parameters["DefaultValue"] = ChildDefault;
            }

            return parameters;
        }
    }

    private void RecordChildValue(ValueChangeEventArgs<string> args)
    {
        childValueChanges.Add($"{args.Value}:{args.Details.Reason.ToLiteral()}");
        if (ChildCancel)
        {
            args.Details.Cancel();
        }
    }

    [SupplyParameterFromQuery(Name = "hover")]
    public string? Hover { get; set; }

    private bool ParentPlain => Parent == "plain";

    private bool ChildPlain => Child == "plain";

    private static string[] Names(string? value, string fallback) =>
        (value ?? fallback).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private AutoHighlightValue? AutoHighlight => Auto switch
    {
        "true" => true,
        "always" => AutoHighlightValue.Always,
        _ => null,
    };

    private RenderFragment RootMenu => @<MenuRoot TPayload="NoPayload" DefaultOpen="@(!Closed)" Modal="@(ModalName == "false" ? false : null)" LoopFocus="@(Loop != "false")" Orientation="@(OrientationName == "horizontal" ? Orientation.Horizontal : Orientation.Vertical)" OnItemHighlighted="RecordHighlight" Handle="@(Detached ? handle : null)" @ref="root">
        @if (!Detached)
        {
            <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
        }
        <MenuPortal>
            <MenuPositioner>
                <MenuPopup data-testid="popup" class="@(Exiting ? "exiting" : null)">
                    @if (ParentPlain && !List)
                    {
                        @Items
                    }
                    else if (ParentPlain)
                    {
                        <MenuList data-testid="parent-list">@Items</MenuList>
                    }
                    else
                    {
                        <MenuInput aria-label="Filter actions" @ref="input" />
                        <MenuList data-testid="parent-list" @ref="list">@Items</MenuList>
                    }
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>;

    private RenderFragment Items => @<text>
        @foreach (string name in Names(Before, "Rename"))
        {
            <MenuItem @key="name" Disabled="@(name == DisabledItem)">@name</MenuItem>
        }
        @if (ChildPlain)
        {
            @Submenu
        }
        else
        {
            <MenuFilterProvider AutoHighlight="@AutoHighlight" @attributes="ChildProviderParameters">@Submenu</MenuFilterProvider>
        }
        @foreach (string name in Names(After, "Delete"))
        {
            <MenuItem @key="name" Disabled="@(name == DisabledItem)">@name</MenuItem>
        }
        @if (Second is not null)
        {
            <MenuFilterProvider>
                <MenuSubmenuRoot>
                    <MenuSubmenuTrigger Delay="@(SecondDelay is { } second ? (Duration?)second : null)" CloseDelay="@(CloseDelay is { } closing ? (Duration?)closing : null)">@Second</MenuSubmenuTrigger>
                    <MenuPortal>
                        <MenuPositioner>
                            <MenuPopup data-testid="second-submenu">
                                <MenuInput aria-label="Filter second" />
                                <MenuList>
                                    @foreach (string name in Names(SecondChildren, "PDF"))
                                    {
                                        <MenuItem @key="name">@name</MenuItem>
                                    }
                                </MenuList>
                            </MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuSubmenuRoot>
            </MenuFilterProvider>
        }
    </text>;

    private RenderFragment Submenu => @<MenuSubmenuRoot OnOpenChange="RecordSubmenu" DefaultOpen="@ChildOpen" @attributes="ChildRootParameters">
        <MenuSubmenuTrigger data-testid="submenu-trigger" Delay="@(Delay is { } ms ? (Duration?)ms : null)" CloseDelay="@(CloseDelay is { } close ? (Duration?)close : null)" OpenOnHover="@(Hover != "false")">@(Label ?? "Move to")</MenuSubmenuTrigger>
        <MenuPortal Container="@submenuContainer">
            <MenuPositioner>
                <MenuPopup data-testid="submenu" class="@(Exiting ? "exiting" : null)">
                    @if (!ChildPlain)
                    {
                        <MenuInput aria-label="Filter folders" @ref="childInput" />
                    }
                    <MenuList data-testid="submenu-list">
                        @if (Nested is not null)
                        {
                            <MenuSubmenuRoot>
                                <MenuSubmenuTrigger>@Nested</MenuSubmenuTrigger>
                                <MenuPortal>
                                    <MenuPositioner>
                                        <MenuPopup data-testid="nested-submenu">
                                            <MenuItem>Archive</MenuItem>
                                        </MenuPopup>
                                    </MenuPositioner>
                                </MenuPortal>
                            </MenuSubmenuRoot>
                        }
                        @foreach (string name in Names(Children, "Projects,Archive"))
                        {
                            <MenuItem @key="name">@name</MenuItem>
                        }
                        @if (extraAdded && Extra is not null)
                        {
                            <MenuItem @key="Extra">@Extra</MenuItem>
                        }
                    </MenuList>
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuSubmenuRoot>;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The input of a submenu that starts open attaches its handle after its portal's move, a leg later on Server.
        if (attached && ChildOpen && !childAttached && !childAttaching && childInput is not null)
        {
            childAttaching = true;
            await childInput.FilterAttached;
            childAttached = true;
            StateHasChanged();
            return;
        }

        // A filterable root that starts open waits for its input's and list's handles; otherwise the session is enough.
        bool needsParts = !ParentPlain && !Closed;
        if (attached || attaching || !RendererInfo.IsInteractive || root is null || (needsParts && (input is null || list is null)))
        {
            return;
        }

        attaching = true;
        if (Shadow)
        {
            try
            {
                submenuContainer = new PortalContainerValue(await JS.InvokeAsync<IJSObjectReference>("blazixFixtureDom.createOpenShadowRoot", shadowHost));
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went while the page was set up.
                return;
            }
        }

        await (needsParts ? Task.WhenAll(root.SessionAttached, input!.FilterAttached, list!.FilterAttached) : root.SessionAttached);
        attached = true;
        StateHasChanged();
    }

    private void RecordHighlight(MenuItemHighlightedEventArgs args) =>
        highlights.Add($"{(args.ItemId is null ? "none" : args.Details.Label ?? "")}:{args.Details.Reason.ToLiteral()}:{args.Details.Event.Key}");

    private void RecordSubmenu(ValueChangeEventArgs<bool> args) =>
        submenuChanges.Add($"{(args.Value ? "open" : "close")}:{args.Details.Reason.ToLiteral()}");
}
