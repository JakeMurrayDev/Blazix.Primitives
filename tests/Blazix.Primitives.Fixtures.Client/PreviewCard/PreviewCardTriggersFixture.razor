@namespace Blazix.Primitives.Fixtures.Client.PreviewCardFixtures
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@using Blazix.Primitives
@inherits PopupSuiteFixtureBase

@*
    The `preview-card-triggers` fixture (tests/browser/preview-card.spec.ts): detachedTriggersConformanceTests (tests/browser/suites/)
    with PreviewCardRoot.detached-triggers.test.tsx's parts (:35-49), the suite's Fixture as a page (the `popup-triggers` page
    of M4 track 1 with PreviewCard parts). Triggers `trigger-1`.. are links (`href="#"`) that carry their number as payload
    and open and close at once (`delay: 0, closeDelay: 0`; Base UI's `pointerEvents: 'none'` is left out, since the suite
    hovers with the real pointer); the root's payload template
    renders `root-payload` on a line of its own, so a payload's text never moves a trigger from under the pointer (with
    `rootFirst` it precedes the triggers), and the portaled positioner and popup with a viewport (`viewport`, as Base UI's
    config passes one) around its `content`. The positioner sits
    below its trigger (the suite's `positionerProps` of the controlled case, `side: 'bottom', align: 'start'`, with the
    side kept for every case), so the suite's one-step move to the page's origin leaves the trigger from the side opposite
    the popup and the safe polygon closes at once (FLT-ALG-15), as Base UI's dispatched `mouseleave` does.
    - `mode=contained|detached`, `triggerCount` (2), `rootFirst`, `nesting` (wrappers around the triggers);
    - `open` and `triggerId` (a controlled root), `defaultOpen`, `defaultTriggerId`; PreviewCard's handle always throws for
      an unregistered trigger id (PRV-EDGE-05);
    - `case=controlled`: the suite's programmatic case, a controlled root whose OnOpenChange follows the request, and the
      buttons "Open Trigger 1", "Open Trigger 2" and "Close externally";
    - `rootMounted=false`: the root starts unmounted;
    - `case=overlap`: detached triggers and two keyed roots on one handle by phase (`[data-set-phase]`: outgoing, overlap,
      incoming); the incoming root's batch opens `trigger-2` through the handle after its first render (OpenOnMount);
    - buttons: `[data-toggle-root]` (mounts or unmounts the root), `[data-set-nesting]`, `[data-recreate-handle]`,
      `[data-handle-open]` (the handle's OpenAsync with that id; a thrown message renders as `data-handle-error`),
      `[data-handle-close]`; the container renders the handle's `IsOpen` as `data-handle-open-state`.
*@
<FixtureContainer Name="preview-card-triggers" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes"
                  data-handle-open-state="@(handle?.IsOpen == true ? "true" : "false")" data-handle-error="@handleError">
    <button type="button" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" data-toggle-root data-key-control @onclick="() => rootMounted = !rootMounted" @onkeydown="OnShift(() => rootMounted = !rootMounted)">Toggle root</button>
    <button type="button" data-recreate-handle data-key-control @onclick="RecreateHandle" @onkeydown="OnShift(RecreateHandle)">Recreate handle</button>
    @for (int level = 0; level <= 3; level++)
    {
        int value = level;
        <button type="button" data-set-nesting="@value" data-key-control @onclick="() => nesting = value" @onkeydown="OnShift(() => nesting = value)">Nesting @value</button>
    }
    <button type="button" data-handle-open="trigger-1" data-key-control @onclick='() => HandleOpenAsync("trigger-1")' @onkeydown='OnShift(() => HandleOpenAsync("trigger-1"))'>Handle open 1</button>
    <button type="button" data-handle-open="trigger-2" data-key-control @onclick='() => HandleOpenAsync("trigger-2")' @onkeydown='OnShift(() => HandleOpenAsync("trigger-2"))'>Handle open 2</button>
    <button type="button" data-handle-open="missing" data-key-control @onclick='() => HandleOpenAsync("missing")' @onkeydown='OnShift(() => HandleOpenAsync("missing"))'>Handle open missing</button>
    <button type="button" data-handle-close data-key-control @onclick="HandleCloseAsync" @onkeydown="OnShift(HandleCloseAsync)">Handle close</button>

    @foreach (string value in new[] { "outgoing", "overlap", "incoming" })
    {
        <button type="button" data-set-phase="@value" data-key-control @onclick="() => phase = value" @onkeydown="OnShift(() => phase = value)">Phase @value</button>
    }

    <div style="margin: 50px">
        @if (Case == "overlap")
        {
            @Nest(0)
            @if (phase is "outgoing" or "overlap")
            {
                <PreviewCardRoot TPayload="string" @key="@("outgoing")" Handle="@handle" OnOpenChange="RecordOpenChange" PayloadContent="@Popup" />
            }

            @if (phase is "overlap" or "incoming")
            {
                <PreviewCardRoot TPayload="string" @key="@("incoming")" Handle="@handle" OnOpenChange="RecordOpenChange" PayloadContent="@Popup" />
                <OpenOnMount Run='() => HandleOpenAsync("trigger-2")' />
            }
        }
        else if (detached && !rootFirst)
        {
            @Nest(nesting)
        }

        @if (rootMounted && Case != "overlap")
        {
            @if (controlled)
            {
                <PreviewCardRoot TPayload="string" @ref="root" Handle="@(detached ? handle : null)" Open="@open" TriggerId="@triggerId"
                                  OnOpenChange="FollowOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete" PayloadContent="@Popup">
                    @if (!detached)
                    {
                        @Nest(nesting)
                    }
                </PreviewCardRoot>
            }
            else
            {
                <PreviewCardRoot TPayload="string" @ref="root" Handle="@(detached ? handle : null)" DefaultOpen="@defaultOpen" DefaultTriggerId="@defaultTriggerId"
                                  OnOpenChange="RecordOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete" PayloadContent="@Popup">
                    @if (!detached)
                    {
                        @Nest(nesting)
                    }
                </PreviewCardRoot>
            }
        }

        @if (detached && rootFirst && Case != "overlap")
        {
            @Nest(nesting)
        }

        @if (Case == "controlled")
        {
            <button type="button" @onclick='() => SetControlled(true, "trigger-1")'>Open Trigger 1</button>
            <button type="button" @onclick='() => SetControlled(true, "trigger-2")'>Open Trigger 2</button>
            <button type="button" @onclick="() => open = false">Close externally</button>
        }
    </div>
</FixtureContainer>

@code {
    private readonly Dictionary<string, PreviewCardTrigger<string>> triggerRefs = [];
    private PreviewCardHandle<string>? handle;
    private PreviewCardRoot<string>? root;
    private bool detached;
    private bool controlled;
    private bool open;
    private string? triggerId;
    private bool defaultOpen;
    private string? defaultTriggerId;
    private int triggerCount = 2;
    private bool rootFirst;
    private bool rootMounted = true;
    private int nesting;
    private string? handleError;
    private string phase = "outgoing";

    protected override IEnumerable<Task> Attachments => [HandlesAttachedAsync()];

    // A detached trigger renders against the handle's fallback store until its root attaches to the handle, after the
    // fixture's first render: its handle attaches only then, so it is awaited after the root's session.
    private async Task HandlesAttachedAsync()
    {
        await (root?.SessionAttached ?? Task.CompletedTask);
        await Task.WhenAll(triggerRefs.Values.Select(trigger => trigger.TwinAttached));
    }

    protected override void OnInitialized()
    {
        handle = new PreviewCardHandle<string>();
        detached = Query("mode") == "detached";
        controlled = Case == "controlled" || QueryFlag("open") is not null;
        open = QueryFlag("open") == true;
        triggerId = Query("triggerId");
        defaultOpen = QueryFlag("defaultOpen") == true;
        defaultTriggerId = Query("defaultTriggerId");
        triggerCount = int.TryParse(Query("triggerCount"), out int count) ? count : 2;
        rootFirst = QueryFlag("rootFirst") == true;
        nesting = int.TryParse(Query("nesting"), out int level) ? level : 0;
        rootMounted = QueryFlag("rootMounted") != false;
        if (Case == "overlap")
        {
            detached = true;
        }
    }

    private RenderFragment Nest(int level) => level == 0 ? Triggers : @<div>@Nest(level - 1)</div>;

    private RenderFragment Triggers => @<text>
        @for (int number = 1; number <= triggerCount; number++)
        {
            string id = $"trigger-{number}";
            string payload = number.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <PreviewCardTrigger TPayload="string" @key="number" @ref="triggerRefs[id]" href="#" Delay="0" CloseDelay="0" Handle="@(detached ? handle : null)" id="@id" data-testid="@id" Payload="@payload">Trigger @payload</PreviewCardTrigger>
        }
    </text>;

    private RenderFragment<string?> Popup => payload => @<text>
        <span data-testid="root-payload" style="display: block">@(payload ?? "No payload")</span>
        <PreviewCardPortal>
            <PreviewCardPositioner data-testid="positioner" Side="Side.Bottom" Align="@(Case == "controlled" ? Align.Start : Align.Center)">
                <PreviewCardPopup data-testid="popup">
                    <PreviewCardViewport data-testid="viewport">
                        <span data-testid="content">@payload</span>
                    </PreviewCardViewport>
                </PreviewCardPopup>
            </PreviewCardPositioner>
        </PreviewCardPortal>
    </text>;

    private void FollowOpenChange(ValueChangeEventArgs<bool> args)
    {
        RecordOpenChange(args);
        triggerId = args.Details.Trigger?.Id;
        open = args.Value;
    }

    private void SetControlled(bool value, string? id)
    {
        open = value;
        triggerId = id;
    }

    private void RecreateHandle() => handle = new PreviewCardHandle<string>();

    private async Task HandleOpenAsync(string id)
    {
        handleError = null;
        try
        {
            await handle!.OpenAsync(id);
        }
        catch (InvalidOperationException error)
        {
            handleError = error.Message;
        }

        // OpenOnMount calls this outside the page's own events: render the handle's state now.
        StateHasChanged();
    }

    private Task HandleCloseAsync() => handle!.CloseAsync();
}
