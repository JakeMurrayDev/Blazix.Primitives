@namespace Blazix.Primitives.Fixtures.Client.PreviewCardFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `preview-card-positioner` fixture (tests/browser/preview-card.spec.ts): the positioner conformance suite's cases
    (tests/browser/suites/positioner-conformance.ts, its header has the contract) with PreviewCardPositioner.test.tsx's tree
    (:108-122, its Trigger rendering a `div`, :12-17), and an arrow inside the popup for the port's arrow titles by
    `case=arrow`, `arrow-uncentered` (`ArrowPadding="40"`) and `arrow-centered` (`ArrowPadding="0"`, a 200 px trigger). The
    root is open from its first render, except `collision-padding`, opened by `[data-open-button]`. The suite's cases name
    the side `bottom`, PreviewCard's default.
    With `viewport: true` (PreviewCardPositioner.test.tsx runs the suite so): `viewport`, a PreviewCardViewport in the popup;
    `viewport-toggle`, `[data-viewport-toggle]` mounts and unmounts it.
*@
<FixtureContainer Name="preview-card-positioner" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case">
    <button type="button" data-sync-button style="position: fixed; right: 0; bottom: 0" data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    @* The suite finds the positioner inside the fixture's container, so the portal moves its node here. *@
    <div id="preview-card-positioner-host"></div>

    @if (Case == "collision-padding")
    {
        <button type="button" data-open-button style="position: fixed; right: 0; top: 0" @onclick="() => open = true">Open</button>
        <PreviewCardRoot TPayload="NoPayload" @ref="root" Open="@open">
            <div style="position: fixed; bottom: 8px; left: 16px">
                <PreviewCardTrigger TPayload="NoPayload" @ref="trigger" Render="Div" data-testid="trigger" style="width: 72px; height: 36px; box-sizing: border-box">Trigger</PreviewCardTrigger>
            </div>
            <PreviewCardPortal Container="@PortalHost">
                <PreviewCardPositioner data-testid="positioner" Side="Side.Bottom" SideOffset="8" CollisionPadding="12" CollisionAvoidance="s_noFallback">
                    <PreviewCardPopup data-popup style="width: 200px; height: 1000px; max-height: var(--available-height)">Popup</PreviewCardPopup>
                </PreviewCardPositioner>
            </PreviewCardPortal>
        </PreviewCardRoot>
    }
    else if (Case.StartsWith("arrow", StringComparison.Ordinal))
    {
        <div style="position: fixed; top: 0; left: 0">
            <PreviewCardRoot TPayload="NoPayload" @ref="root" Open="true">
                <PreviewCardTrigger TPayload="NoPayload" @ref="trigger" style="@($"width: {(Case == "arrow-centered" ? 200 : 20)}px; height: 20px")">T</PreviewCardTrigger>
                <PreviewCardPortal Container="@PortalHost">
                    <PreviewCardPositioner Side="Side.Bottom" ArrowPadding="@ArrowPaddingFor(Case)">
                        <PreviewCardPopup style="width: 200px; height: 40px">
                            <PreviewCardArrow data-testid="arrow" style="width: 10px; height: 10px" />
                        </PreviewCardPopup>
                    </PreviewCardPositioner>
                </PreviewCardPortal>
            </PreviewCardRoot>
        </div>
    }
    else
    {
        <PreviewCardRoot TPayload="NoPayload" @ref="root" Open="true">
            <PreviewCardTrigger TPayload="NoPayload" @ref="trigger" Render="Div" data-testid="trigger" style="position: fixed; top: 0; left: 0; width: 72px; height: 36px; box-sizing: border-box">Trigger</PreviewCardTrigger>
            <PreviewCardPortal Container="@PortalHost">
                @if (Case.StartsWith("sideOffset-override-", StringComparison.Ordinal) || Case.StartsWith("alignOffset-override-", StringComparison.Ordinal))
                {
                    OverrideCase overrideCase = OverrideCase.For(Case);
                    <DirectionProvider Direction="overrideCase.Direction">
                        <PreviewCardPositioner data-testid="positioner" Side="overrideCase.Side" Align="overrideCase.Align" SideOffset="overrideCase.SideOffset" AlignOffset="overrideCase.AlignOffset">
                            <PreviewCardPopup data-popup style="width: 52px; height: 24px">Popup</PreviewCardPopup>
                        </PreviewCardPositioner>
                    </DirectionProvider>
                }
                else
                {
                    <PreviewCardPositioner data-testid="positioner" Side="Side.Bottom" SideOffset="SideOffsetFor(Case)" AlignOffset="AlignOffsetFor(Case)">
                        <PreviewCardPopup data-popup style="width: 52px; height: 24px">
                            @if (Case == "viewport" || (Case == "viewport-toggle" && viewport))
                            {
                                <PreviewCardViewport>Popup</PreviewCardViewport>
                            }
                            else
                            {
                                @("Popup")
                            }
                        </PreviewCardPopup>
                    </PreviewCardPositioner>
                }
            </PreviewCardPortal>
        </PreviewCardRoot>
        @if (Case == "viewport-toggle")
        {
            <button type="button" data-viewport-toggle data-key-control style="position: fixed; right: 0; top: 0" @onclick="() => viewport = !viewport" @onkeydown="OnShift(() => viewport = !viewport)">Toggle Viewport</button>
        }
    }
</FixtureContainer>

@code {
    private static readonly CollisionAvoidance s_noFallback = new(FallbackAxisSide: FallbackAxisSide.None);

    private PreviewCardRoot<NoPayload>? root;
    private PreviewCardTrigger<NoPayload>? trigger;
    private bool open;
    private bool viewport;

    protected override IEnumerable<Task> Attachments => [root?.SessionAttached ?? Task.CompletedTask, trigger?.TwinAttached ?? Task.CompletedTask];

    private static RenderFragment Div => @<div />;

    private static PortalContainerValue PortalHost => "#preview-card-positioner-host";

    private static double? ArrowPaddingFor(string name) => name switch
    {
        "arrow-uncentered" => 40,
        "arrow-centered" => 0,
        _ => null,
    };

    private static OffsetValue? SideOffsetFor(string name) => name switch
    {
        "sideOffset-number" => 7,
        "sideOffset-function" => new Offset(AnchorWidth: 1, PositionerWidth: 1),
        _ => null,
    };

    private static OffsetValue? AlignOffsetFor(string name) => name switch
    {
        "alignOffset-number" => 7,
        "alignOffset-function" => new Offset(PositionerWidth: 1),
        _ => null,
    };

    private sealed record OverrideCase(Side Side, Align? Align, TextDirection Direction, OffsetValue? SideOffset, OffsetValue? AlignOffset)
    {
        public static OverrideCase For(string name)
        {
            bool side = name.StartsWith("sideOffset-", StringComparison.Ordinal);
            int number = name[^1] - '0';
            OffsetOverride keyed = number switch
            {
                1 => new OffsetOverride(Primitives.Side.Right, null, Constant: 5),
                2 => new OffsetOverride(null, Primitives.Align.End, Constant: 5),
                3 => new OffsetOverride(Primitives.Side.InlineEnd, null, Constant: 5),
                _ => new OffsetOverride(Primitives.Side.InlineStart, null, Constant: 5),
            };
            OffsetValue offset = new Offset { Overrides = [keyed] };
            (Primitives.Side requested, Primitives.Align? align, TextDirection direction) = number switch
            {
                1 => (Primitives.Side.Left, (Primitives.Align?)null, TextDirection.Ltr),
                2 => (Primitives.Side.Right, Primitives.Align.Start, TextDirection.Ltr),
                3 => (Primitives.Side.InlineStart, null, TextDirection.Ltr),
                _ => (Primitives.Side.InlineStart, null, TextDirection.Rtl),
            };
            return new OverrideCase(requested, align, direction, side ? offset : null, side ? null : offset);
        }
    }
}
