@namespace Blazix.Primitives.Fixtures.Client.ComboboxFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `combobox-root` fixture (tests/browser/combobox.spec.ts, M5 track 10): a Combobox over string items, as
    ComboboxRoot.test.tsx renders most of its titles: an Input, a Portal > Positioner > Popup with an Empty and a List whose
    ItemContent renders one Item per filtered item. The query sets the root's props:
    - `items` (`|`-separated; absent for apple|banana|cherry|date|elderberry), `defaultValue`, `multiple`, `autoHighlight`,
      `openOnInputClick=false`, `inline`, `readOnly`, `disabled`, `defaultOpen`;
    The container renders `data-attached` once the session and the input's handles are attached, and records
    `data-value-changes`, `data-input-changes` and `data-open-changes` as space-separated `value:reason` entries (a space in a
    value is `_`).
*@
<FixtureContainer Name="combobox-root" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges" data-value-changes="@string.Join(' ', valueChanges)" data-input-changes="@string.Join(' ', inputChanges)">
    <button type="button" data-testid="before">Before</button>
    <ComboboxRoot TValue="string" @ref="root" @attributes="rootParameters">
        <ComboboxInput @ref="input" data-testid="input" />
        <ComboboxPortal>
            <ComboboxPositioner style="position: relative; z-index: 1">
                <ComboboxPopup data-testid="popup">
                    <ComboboxEmpty data-testid="empty">No items.</ComboboxEmpty>
                    <ComboboxList TValue="string" data-testid="list">
                        <ItemContent>
                            <ComboboxItem TValue="string" Value="@context.Value" @key="context.Value">@context.Value</ComboboxItem>
                        </ItemContent>
                    </ComboboxList>
                </ComboboxPopup>
            </ComboboxPositioner>
        </ComboboxPortal>
    </ComboboxRoot>
    <button type="button" data-testid="after">After</button>
</FixtureContainer>

@code {
    private static readonly string[] s_items = ["apple", "banana", "cherry", "date", "elderberry"];

    private readonly Dictionary<string, object?> rootParameters = [];
    private readonly List<string> valueChanges = [];
    private readonly List<string> inputChanges = [];
    private ComboboxRoot<string>? root;
    private ComboboxInput? input;

    protected override IEnumerable<Task> Attachments =>
        [root?.SessionAttached ?? Task.CompletedTask, input?.TwinAttached ?? Task.CompletedTask];

    protected override void OnInitialized()
    {
        IReadOnlyList<string> items = Query("items") is { } list ? (list.Length == 0 ? [] : list.Split('|')) : s_items;
        rootParameters["Items"] = items;
        rootParameters["OnOpenChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<bool>>(this, RecordOpenChange);
        rootParameters["OnInputValueChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<string>>(this, args => inputChanges.Add(Entry(args.Value, args.Details.Reason)));
        if (QueryFlag("multiple") == true)
        {
            rootParameters["Multiple"] = true;
            rootParameters["OnValuesChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<IReadOnlyList<string>>>(this, args => valueChanges.Add(Entry(string.Join(',', args.Value), args.Details.Reason)));
        }
        else
        {
            rootParameters["OnValueChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<string>>(this, args => valueChanges.Add(Entry(args.Value, args.Details.Reason)));
        }

        if (Query("defaultValue") is { } value)
        {
            rootParameters["DefaultValue"] = value;
        }

        Flag("autoHighlight", "AutoHighlight");
        Flag("inline", "Inline");
        Flag("readOnly", "ReadOnly");
        Flag("disabled", "Disabled");
        Flag("defaultOpen", "DefaultOpen");
        if (QueryFlag("openOnInputClick") == false)
        {
            rootParameters["OpenOnInputClick"] = false;
        }
    }

    private void Flag(string query, string parameter)
    {
        if (QueryFlag(query) == true)
        {
            rootParameters[parameter] = true;
        }
    }

    private static string Entry(string? value, EventReason reason) =>
        (value ?? "null").Replace(' ', '_') + ":" + reason.ToLiteral();
}
