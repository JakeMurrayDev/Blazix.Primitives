@namespace Blazix.Primitives.Fixtures.Client.PopupFixtures
@using Blazix.Primitives
@inherits PopupSuiteFixtureBase

@*
    The `popup-conformance` fixture (tests/browser/popup.spec.ts): popupConformanceTests (tests/browser/suites/) on the
    test-only popup host, a contained trigger, portal, popup and close. The query sets the root's props:
    - `open=true|false`: a controlled root (the `[data-set-open]` buttons change it, as the suite's rerender does);
      absent, the root is uncontrolled;
    - `defaultOpen`, `cancelOpen` (the root's OnOpenChange cancels an open), `cancelClose` (it cancels a close),
      `allowPropagation` (a close lets its keydown propagate), `popupId`, `keepMounted`;
    - `animated`: the popup takes the `popup-animated` class, 200 ms keyframes on `[data-open]` and `[data-ending-style]`
      (open the page with `?animations=1`).
*@
<FixtureContainer Name="popup-conformance" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes">
    <style>
        @@keyframes popup-conformance-enter { from { opacity: 0; } }
        @@keyframes popup-conformance-exit { to { opacity: 0; } }
        .popup-animated[data-open] { animation: popup-conformance-enter 200ms; }
        .popup-animated[data-ending-style] { animation: popup-conformance-exit 200ms; }
    </style>
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <button type="button" data-set-open="true" @onclick="() => open = true">Set open</button>
    <button type="button" data-set-open="false" @onclick="() => open = false">Set closed</button>

    @if (controlled)
    {
        <FixturePopupRoot TPayload="NoPayload" @ref="root" Open="@open" DefaultOpen="@defaultOpen" OnOpenChange="RecordOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete">
            @Content
        </FixturePopupRoot>
    }
    else
    {
        <FixturePopupRoot TPayload="NoPayload" @ref="root" DefaultOpen="@defaultOpen" OnOpenChange="RecordOpenChange" OnOpenChangeComplete="RecordOpenChangeComplete">
            @Content
        </FixturePopupRoot>
    }
</FixtureContainer>

@code {
    private bool controlled;
    private bool open;
    private bool defaultOpen;
    private bool keepMounted;
    private Dictionary<string, object> popupAttributes = [];
    private FixturePopupPopup<NoPayload>? popup;
    private FixturePopupRoot<NoPayload>? root;

    protected override IEnumerable<Task> Attachments =>
        [.. popup is null ? [] : new[] { popup.TwinAttached }, root?.SessionAttached ?? Task.CompletedTask];

    protected override void OnInitialized()
    {
        controlled = QueryFlag("open") is not null;
        open = QueryFlag("open") == true;
        defaultOpen = QueryFlag("defaultOpen") == true;
        keepMounted = QueryFlag("keepMounted") == true;
        popupAttributes["data-testid"] = "popup";
        if (Query("popupId") is { } id)
        {
            popupAttributes["id"] = id;
        }

        if (QueryFlag("animated") == true)
        {
            popupAttributes["class"] = "popup-animated";
        }
    }

    private RenderFragment Content => @<text>
        <FixturePopupTrigger TPayload="NoPayload" data-testid="trigger">Trigger</FixturePopupTrigger>
        <FixturePopupPortal TPayload="NoPayload" KeepMounted="@keepMounted">
            <FixturePopupPopup TPayload="NoPayload" @ref="popup" KeepMounted="@keepMounted" @attributes="popupAttributes">
                <span>Popup content</span>
                <FixturePopupClose TPayload="NoPayload" data-testid="close">Close popup</FixturePopupClose>
            </FixturePopupPopup>
        </FixturePopupPortal>
    </text>;
}
