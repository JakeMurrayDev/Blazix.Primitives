@namespace Blazix.Primitives.Fixtures.Client.ToolbarFixtures

@*
    One case of a Toolbar fixture (tests/browser/toolbar.spec.ts): the record of ToolbarCase as data attributes, around the
    case's content, with native buttons before and after it so a spec can focus them and press Tab.
*@
<div data-case="@Name"
     data-clicks="@Case.Clicks"
     data-keydowns="@Case.KeyDowns"
     data-pointerdowns="@Case.PointerDowns"
     data-mousedowns="@Case.MouseDowns"
     data-mousemoves="@Case.MouseMoves"
     data-changes="@Case.Changes"
     data-checked="@Case.Checked"
     data-log="@Case.Log">
    <button type="button" data-before>Before</button>
    @ChildContent
    <button type="button" data-after>After</button>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    [Parameter, EditorRequired]
    public required ToolbarCase Case { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
