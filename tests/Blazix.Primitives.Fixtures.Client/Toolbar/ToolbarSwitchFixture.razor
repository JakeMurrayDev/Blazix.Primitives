@namespace Blazix.Primitives.Fixtures.Client.ToolbarFixtures
@using Blazix.Primitives
@inherits ToolbarFixtureBase

@*
    The `toolbar-switch` fixture (tests/browser/toolbar.spec.ts): ToolbarButton.test.tsx's Switch block over a native
    SwitchRoot, `NativeButton="true"` over a `<button>`, the shape a checkable root supports inside a toolbar button
    (design point 14.7, option (c) pending the user: a non-native switch puts the id it receives on its hidden input).
    - `renders`: "renders a switch".
    - `interactions`: "handles interactions", the consumer's onclick and the switch's OnCheckedChange.
    - `disabled`: "disabled state", the same on a disabled button.
*@
<FixtureContainer Name="toolbar-switch" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>

    <ToolbarCaseFrame Name="renders" Case="renders">
        <ToolbarRoot @ref="Root" data-root>
            <ToolbarButton @ref="Button" Render="RendersSwitch" data-item="button" />
        </ToolbarRoot>
    </ToolbarCaseFrame>

    <ToolbarCaseFrame Name="interactions" Case="interactions">
        <ToolbarRoot @ref="Root" data-root>
            <ToolbarButton @ref="Button" Render="InteractionsSwitch" data-item="button" @onclick="() => interactions.Click(ButtonSource)" />
        </ToolbarRoot>
    </ToolbarCaseFrame>

    <ToolbarCaseFrame Name="disabled" Case="disabled">
        <ToolbarRoot @ref="Root" data-root>
            <ToolbarButton @ref="Button" Disabled="true" Render="DisabledSwitch" data-item="button" @onclick="() => disabled.Click(ButtonSource)" />
        </ToolbarRoot>
    </ToolbarCaseFrame>
</FixtureContainer>

@code {
    private const string ButtonSource = "button";

    private readonly ToolbarCase renders = new();
    private readonly ToolbarCase interactions = new();
    private readonly ToolbarCase disabled = new();

    private RenderFragment RendersSwitch => @<SwitchRoot @ref="Switch" NativeButton="true"><Render><button></button></Render></SwitchRoot>;

    private RenderFragment InteractionsSwitch => @<SwitchRoot @ref="Switch" NativeButton="true" DefaultChecked="false" OnCheckedChange="interactions.CheckedChange"><Render><button></button></Render></SwitchRoot>;

    private RenderFragment DisabledSwitch => @<SwitchRoot @ref="Switch" NativeButton="true" OnCheckedChange="disabled.CheckedChange"><Render><button></button></Render></SwitchRoot>;
}
