@namespace Blazix.Primitives.Fixtures.Client.ToolbarFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `toolbar-dialog` fixture (tests/browser/toolbar.spec.ts): ToolbarButton.test.tsx's Dialog block, a ToolbarButton
    whose Render is a DialogTrigger, in a non-modal DialogRoot inside a ToolbarRoot (M4 track 8, ADR 12 Amendments
    2026-10-27 item 4). Dialog reads no toolbar context: the substitution is the pipeline's (SubstituteParameters).
    - `renders`: "renders a dialog trigger"; `interactions`: "handles interactions"; `disabled`: "disabled state" (a
      disabled ToolbarButton); `composite`: "prevents composite keydowns from escaping", a second plain ToolbarButton
      "empty" after the dialog trigger.
    The container records the root's open changes (`data-open-changes`).
*@
<FixtureContainer Name="toolbar-dialog" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync" data-case="@Case"
                  data-open-changes="@OpenChanges">
    <button type="button" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
    <button type="button" data-before>Before</button>
    <ToolbarRoot @ref="root" data-root>
        <DialogRoot TPayload="NoPayload" Modal="false" OnOpenChange="RecordOpenChange">
            <ToolbarButton @ref="button" Disabled="@(Case == "disabled")" Render="Trigger" data-item="button">@(Case == "composite" ? "dialog" : null)</ToolbarButton>
            <DialogPortal>
                @if (Case != "composite")
                {
                    <DialogBackdrop />
                }
                <DialogPopup>
                    @if (Case != "composite")
                    {
                        <DialogTitle>title text</DialogTitle>
                    }
                </DialogPopup>
            </DialogPortal>
        </DialogRoot>
        @if (Case == "composite")
        {
            <ToolbarButton data-item="empty">empty</ToolbarButton>
        }
    </ToolbarRoot>
</FixtureContainer>

@code {
    private ToolbarRoot? root;
    private ToolbarButton? button;
    private DialogTrigger<NoPayload>? trigger;

    protected override IEnumerable<Task> Attachments =>
    [
        root?.TwinAttached ?? Task.CompletedTask,
        button?.TwinAttached ?? Task.CompletedTask,
        trigger?.TwinAttached ?? Task.CompletedTask,
    ];

    private RenderFragment Trigger => @<DialogTrigger TPayload="NoPayload" @ref="trigger" data-testid="trigger" />;
}
