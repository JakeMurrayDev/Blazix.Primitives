@namespace Blazix.Primitives.Fixtures.Client.SelectFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `select-basic` fixture (tests/browser/select.spec.ts; M5 track 9): a single select of five apples with a label, a
    value with a placeholder, an icon, a portal, a positioner, a popup with a list, items with text and indicators. The
    query: `align=false` places the popup against the trigger (`AlignItemWithTrigger=false`); `defaultValue` the value at
    the first render; `modal=false`. The container records `data-value-changes` (value and reason) and the open changes.
*@
<FixtureContainer Name="select-basic" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges" data-value-changes="@string.Join(' ', valueChanges)">
    <SelectRoot TValue="string" @ref="root" DefaultValue="@defaultValue" Modal="@modal" Items="@s_apples" OnValueChange="RecordValueChange" OnOpenChange="RecordOpenChange">
        <SelectLabel data-testid="label">Apple</SelectLabel>
        <SelectTrigger @ref="trigger" data-testid="trigger">
            <SelectValue data-testid="value">
                <Placeholder>Select apple</Placeholder>
            </SelectValue>
            <SelectIcon data-testid="icon" />
        </SelectTrigger>
        <SelectPortal>
            <SelectPositioner data-testid="positioner" AlignItemWithTrigger="@align" SideOffset="4">
                <SelectPopup data-testid="popup">
                    <SelectList data-testid="list">
                        @foreach (LabeledValue<string> apple in s_apples)
                        {
                            <SelectItem @key="apple.Value" Value="@apple.Value" data-testid="@("item-" + apple.Value)">
                                <SelectItemIndicator />
                                <SelectItemText>@apple.Label</SelectItemText>
                            </SelectItem>
                        }
                    </SelectList>
                </SelectPopup>
            </SelectPositioner>
        </SelectPortal>
    </SelectRoot>
    <button type="button" data-testid="outside">Outside</button>
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
</FixtureContainer>

@code {
    private static readonly LabeledValue<string>[] s_apples =
    [
        new("gala", "Gala"),
        new("fuji", "Fuji"),
        new("honeycrisp", "Honeycrisp"),
        new("granny-smith", "Granny Smith"),
        new("pink-lady", "Pink Lady"),
    ];

    private readonly List<string> valueChanges = [];
    private SelectRoot<string>? root;
    private SelectTrigger<string>? trigger;

    protected override IEnumerable<Task> Attachments => [root!.SessionAttached, trigger!.TwinsAttached];
    private string? defaultValue;
    private bool align = true;
    private bool modal = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        defaultValue = Query("defaultValue");
        align = Query("align") != "false";
        modal = Query("modal") != "false";
    }

    private void RecordValueChange(ValueChangeEventArgs<string> args)
    {
        valueChanges.Add($"{args.Value}:{args.Details.Reason.ToLiteral()}");
    }
}
