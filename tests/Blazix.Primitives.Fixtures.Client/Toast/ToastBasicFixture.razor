@namespace Blazix.Primitives.Fixtures.Client.ToastFixtures
@using Blazix.Primitives
@inherits ToastFixtureBase

@*
    The `toast-basic` fixture (tests/browser/toast*.spec.ts): Base UI's `List` and `Button` (toast/utils/test-utils.tsx) in a
    provider over the scope's manager, the add button after the viewport (`?before=1` puts it before, toast.md §16 Q3).
    Each root carries its title, description, a close labelled `close-press` and an action. Query: `limit`, `timeout` (ms),
    `directions` (`up,right`…), `keyed=index` (index keys, `data-testid="root-<index>"`), `animated=1` (a 10 s opacity
    exit, ToastRoot.test.tsx's style), `content=1` (the parts inside a Content), `id` (the add's id), `width` (the roots'
    width in px), `title`, `priority=high`, `anchored=1` (positioner settings whose anchor is set to none, so the toast
    cannot be swiped), `touch=1` (`touch-action: none` on the roots, so a touch drag is not a pan), `recreate=1` (each root given a fresh copy of its toast), `portaled=1` (a button inside each root, portaled to the body). `show` also lengthens the titles
    (ToastRoot.test.tsx's "registers an active toast after its root remounts"); `add-one`, `add-two` and `close-one` add
    and close the toasts `one` and `two`. The controls record nothing themselves: `data-closed` and `data-removed` list the ids, `data-reports` the
    module's reports C# applied.
*@
<FixtureContainer Name="toast-basic" data-attached="@(Attached ? "true" : "false")" data-closed="@Closed" data-removed="@Removed"
                  data-reports="@Reports" data-sync="@Sync" data-count="@Manager.Toasts.Count">
    @if (touchNone)
    {
        <style>[data-testid^="root"] { touch-action: none; }</style>
    }
    @if (animated)
    {
        <style>
            [data-testid^="root"] { opacity: 1; transition: opacity 10s; }
            [data-testid^="root"][data-ending-style] { opacity: 0; }
        </style>
    }
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    @if (before)
    {
        <button type="button" data-testid="add" @onclick="Add">add</button>
    }
    <ToastProvider TData="NoPayload" @ref="Provider" Timeout="@timeout" Limit="@(limit ?? 3)">
        <ToastViewport @ref="Viewport" data-testid="viewport" style="position: fixed; right: 16px; bottom: 16px; width: 300px">
            <ToastsContent Context="toasts">
                @if (shown)
                {
                    @for (int i = 0; i < toasts.Count; i++)
                    {
                        ToastObject<NoPayload> toast = recreate ? toasts[i] with { } : toasts[i];
                        object key = indexKeys ? i : toast.Id;
                        <ToastRoot @key="key" Toast="toast" SwipeDirections="@directions" data-testid="@(indexKeys ? $"root-{i}" : "root")"
                                   data-toast-id="@toast.Id" data-height="@toast.Height" style="@rootStyle">
                            @if (withContent)
                            {
                                <ToastContent data-testid="@($"content-{toast.Id}")">
                                    <ToastParts LongTitle="longTitle" />
                                </ToastContent>
                            }
                            else
                            {
                                <ToastParts LongTitle="longTitle" />
                            }
                            @if (portaled)
                            {
                                <ToastPortal><button type="button" data-testid="portaled">portaled</button></ToastPortal>
                            }
                        </ToastRoot>
                    }
                }
            </ToastsContent>
        </ToastViewport>
    </ToastProvider>
    @if (!before)
    {
        <button type="button" data-testid="add" @onclick="Add">add</button>
    }
    <button type="button" data-testid="close-newest" @onclick="CloseNewest">close newest</button>
    <button type="button" data-testid="close-all" @onclick="() => Manager.Close()">close all</button>
    <button type="button" data-testid="update" @onclick="UpdateNewest">update</button>
    <button type="button" data-testid="hide" @onclick="() => shown = false">hide</button>
    <button type="button" data-testid="show" @onclick="Show">show</button>
    <button type="button" data-testid="add-one" @onclick="@(() => Manager.Add(Recorded("one") with { Title = "One", Timeout = 0 }))">add-1</button>
    <button type="button" data-testid="add-two" @onclick="@(() => Manager.Add(Recorded("two") with { Title = "Two", Timeout = 0 }))">add-2</button>
    <button type="button" data-testid="close-one" @onclick="@(() => Manager.Close("one"))">close-1</button>
</FixtureContainer>

@code {
    private Duration? timeout;
    private int? limit;
    private IReadOnlyList<SwipeDirection>? directions;
    private bool before;
    private bool indexKeys;
    private bool animated;
    private bool withContent;
    private bool shown = true;
    private bool longTitle;
    private bool anchored;
    private bool portaled;
    private bool touchNone;
    private bool recreate;
    private string? fixedId;
    private string? rootStyle;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        timeout = QueryInt("timeout") is { } ms ? (Duration?)ms : null;
        limit = QueryInt("limit");
        before = Query("before", "0") == "1";
        indexKeys = Query("keyed", "id") == "index";
        animated = Query("animated", "0") == "1";
        withContent = Query("content", "0") == "1";
        fixedId = Query("id", string.Empty) is { Length: > 0 } id ? id : null;
        anchored = Query("anchored", "0") == "1";
        portaled = Query("portaled", "0") == "1";
        touchNone = Query("touch", "0") == "1";
        recreate = Query("recreate", "0") == "1";
        rootStyle = QueryInt("width") is { } width ? $"width: {width}px" : null;
        if (Query("directions", string.Empty) is { Length: > 0 } list)
        {
            directions = [.. list.Split(',').Select(name => Enum.Parse<SwipeDirection>(name, ignoreCase: true))];
        }
    }

    private void Add() => Manager.Add(Recorded(fixedId) with
    {
        Title = Query("title", "title"),
        Description = "description",
        Priority = Query("priority", string.Empty) == "high" ? ToastPriority.High : null,
        Timeout = QueryInt("toastTimeout") is { } ms ? (Duration?)ms : null,
        Positioner = anchored ? new ToastPositionerSettings { Anchor = null } : null,
        ActionAttributes = new Dictionary<string, object> { ["id"] = "action" },
        ActionContent = builder => builder.AddContent(0, "action"),
    });

    private void Show()
    {
        longTitle = true;
        shown = true;
    }

    private void CloseNewest()
    {
        if (Manager.Toasts is { Count: > 0 } toasts)
        {
            Manager.Close(toasts[0].Id);
        }
    }

    private void UpdateNewest()
    {
        if (Manager.Toasts is { Count: > 0 } toasts)
        {
            Manager.Update(toasts[0].Id, toast => toast with
            {
                Title = "Success",
                Description = "This content is longer than before and should cause the height to increase",
            });
        }
    }
}
