@namespace Blazix.Primitives.Fixtures.Client.OtpFieldFixtures
@using Blazix.Primitives
@inherits OtpFieldFixtureBase

@*
    The `otp-field-autosubmit` fixture (tests/browser/otp-field.form.spec.ts; OTP-API-12, OTP-EVT-13, OTP-EVT-14,
    OTP-FRM-07, OTP-FRM-13). Six slots `slot-{i}` in every case. A native form records each submit's `otp` value in
    `window.otpSubmits` and prevents it. `?case=`:
    `default` (a native form, no AutoSubmit), `named` (a native form, Name otp, Required, AutoSubmit), `blazix` (a Form whose
    OnSubmit counts into data-submits and prevents the native submit, a FieldRoot named otp, AutoSubmit), `blazix-invalid` (as `blazix` with a Validate
    that answers "Invalid OTP" and a FieldError `error`), `first-invalid` (a Form with an `email` FieldRoot whose Validate
    answers "Required", its FieldLabel, FieldControl and FieldError, then a FieldRoot otp with AutoSubmit), `external`
    (a native form `verification-form` before the field, which names it in Form; Name otp; AutoSubmit) and `not-form`
    (a div `verification-form`, then a native form around a field that names it in Form; Name otp; AutoSubmit).
*@
<FixtureContainer Name="otp-field-autosubmit" data-attached="@(Attached ? "true" : "false")" data-submits="@submits"
                  data-completes="@string.Join(" ", Completes)">
    @switch (fixtureCase)
    {
        case "default":
            <form data-testid="form" onsubmit="@RecordNative">
                <OtpFieldRoot @ref="Root" Length="6" data-testid="root">@Slots</OtpFieldRoot>
                <button type="submit">Submit</button>
            </form>
            break;
        case "named":
            <form data-testid="form" aria-label="verification" onsubmit="@RecordNative">
                <OtpFieldRoot @ref="Root" Length="6" Name="otp" Required="true" AutoSubmit="true" OnValueComplete="RecordComplete" data-testid="root">@Slots</OtpFieldRoot>
                <button type="submit">Submit</button>
            </form>
            break;
        case "blazix":
        case "blazix-invalid":
            <Form OnSubmit="Submitted">
                <FieldRoot Name="otp" Validate="@(fixtureCase == "blazix-invalid" ? Invalid : null)">
                    <OtpFieldRoot @ref="Root" Length="6" AutoSubmit="true" data-testid="root">@Slots</OtpFieldRoot>
                    <FieldError data-testid="error" />
                </FieldRoot>
            </Form>
            break;
        case "first-invalid":
            <Form>
                <FieldRoot Name="email" Validate="Required">
                    <FieldLabel>Email</FieldLabel>
                    <FieldControl data-testid="email" />
                    <FieldError />
                </FieldRoot>
                <FieldRoot Name="otp">
                    <OtpFieldRoot @ref="Root" Length="6" AutoSubmit="true" data-testid="root">@Slots</OtpFieldRoot>
                </FieldRoot>
            </Form>
            break;
        case "external":
            <form id="verification-form" onsubmit="@RecordNative">
                <button type="submit">Submit</button>
            </form>
            <OtpFieldRoot @ref="Root" Length="6" Form="verification-form" Name="otp" AutoSubmit="true" data-testid="root">@Slots</OtpFieldRoot>
            break;
        default:
            <div id="verification-form"></div>
            <form data-testid="form" onsubmit="@RecordNative">
                <OtpFieldRoot @ref="Root" Length="6" Form="verification-form" Name="otp" AutoSubmit="true" data-testid="root">@Slots</OtpFieldRoot>
            </form>
            break;
    }
</FixtureContainer>

@code {
    // Records the submitted `otp` value outside Blazor's DOM and prevents the native submit.
    private const string RecordNative = "event.preventDefault(); (window.otpSubmits ??= []).push(String(new FormData(this).get('otp')));";

    private string fixtureCase = "default";
    private int submits;

    private RenderFragment Slots => @<text>
        @for (int i = 0; i < 6; i++)
        {
            int index = i;
            <OtpFieldInput data-testid="@($"slot-{index}")" aria-label="@($"Character {index + 1} of 6")" />
        }
    </text>;

    /// <inheritdoc />
    protected override void OnInitialized() => fixtureCase = Query("case", "default");

    // Base UI's handler prevents the native submission; the count is the test's record.
    private void Submitted(FormSubmitEventArgs args)
    {
        submits++;
        args.PreventNativeSubmit();
    }

    private static ValueTask<FieldValidationResult?> Invalid(FieldValidationArguments arguments) =>
        ValueTask.FromResult<FieldValidationResult?>("Invalid OTP");

    private static ValueTask<FieldValidationResult?> Required(FieldValidationArguments arguments) =>
        ValueTask.FromResult<FieldValidationResult?>("Required");
}
