@namespace Blazix.Primitives.Fixtures.Client.AutocompleteFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.ComboboxFixtures
@inherits ComboboxL4FixtureBase

@*
    The `autocomplete-root` fixture (M5 track 11, issue 196): AutocompleteRoot.test.tsx at L4. The root's items are apple,
    banana and cherry. The query: `mode` (list, both, inline, none), `defaultValue`, `readOnly`, `openOnInputClick`, `submit`
    (SubmitOnItemClick inside a form whose input is named `tag`; the page reads its FormData), `keepHighlight`, `insidePopup`
    (a Trigger showing the Value, the Input inside the popup). Recorded through `Records`: `value-changes` (`text:reason`),
    `highlights` (`value:reason:index`), `highlight-events` (each highlight's event type), `item-clicks` (the Items' consumer
    onclick), and the base's open changes. A button follows the Input (Base UI's Tab target) and the form has a submit button. `autoHighlight` (true or always) sets AutoHighlight, `required` sets Required, `defaultOpen` sets DefaultOpen, `externalForm` sets Form to the empty external form beside it. `many` gives 50 items (`item 0`..`item 49`) in a list 100 px high that scrolls.
*@
<FixtureContainer Name="autocomplete-root" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes" @attributes="Records">
    @SyncButton
    <button type="button" data-testid="outside" data-key-control>outside</button>
    <form id="external-form" data-testid="external-form" onsubmit="event.preventDefault()"></form>
    <form data-testid="form" onsubmit="event.preventDefault()">
        <AutocompleteRoot TValue="string" @ref="root" @attributes="RootParameters">
            @if (insidePopup)
            {
                <AutocompleteTrigger @ref="trigger" data-testid="trigger"><AutocompleteValue /></AutocompleteTrigger>
            }
            else
            {
                <AutocompleteInput @ref="input" data-testid="input" />
                <button type="button" data-testid="after">after</button>
            }
            <AutocompletePortal>
                <AutocompletePositioner style="position: relative; z-index: 1">
                    <AutocompletePopup data-testid="popup">
                        @if (insidePopup)
                        {
                            <AutocompleteInput @ref="input" data-testid="input" />
                        }
                        <AutocompleteList TValue="string" data-testid="list" style="@listStyle">
                            <ItemContent>
                                <AutocompleteItem TValue="string" Value="@context.Value" data-testid="@("item-" + context.Value)" @key="context.Value"
                                                  @onclick="@(() => Record("item-clicks", context.Value))">@context.Value</AutocompleteItem>
                            </ItemContent>
                        </AutocompleteList>
                    </AutocompletePopup>
                </AutocompletePositioner>
            </AutocompletePortal>
        </AutocompleteRoot>
        <button type="submit" data-testid="submit">Submit</button>
    </form>
</FixtureContainer>

@code {
    private static readonly string[] s_items = ["apple", "banana", "cherry"];
    private static readonly string[] s_many = [.. Enumerable.Range(0, 50).Select(i => "item " + i.ToString(System.Globalization.CultureInfo.InvariantCulture))];
    private AutocompleteRoot<string>? root;
    private AutocompleteInput? input;
    private AutocompleteTrigger? trigger;
    private bool insidePopup;
    private string? listStyle;
    private Dictionary<string, object?> rootParameters = [];

    private IReadOnlyDictionary<string, object?> RootParameters => rootParameters;

    protected override IEnumerable<Task> Attachments =>
        [root?.SessionAttached ?? Task.CompletedTask, input?.TwinAttached ?? Task.CompletedTask, trigger?.TwinAttached ?? Task.CompletedTask];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        insidePopup = QueryFlag("insidePopup") == true;
        listStyle = QueryFlag("many") == true ? "max-height: 100px; overflow-y: auto" : null;
        rootParameters = new()
        {
            ["Items"] = QueryFlag("many") == true ? s_many : s_items,
            ["Mode"] = Query("mode") switch { "both" => AutocompleteMode.Both, "inline" => AutocompleteMode.Inline, "none" => AutocompleteMode.None, _ => AutocompleteMode.List },
            ["ReadOnly"] = QueryFlag("readOnly") == true,
            ["OpenOnInputClick"] = QueryFlag("openOnInputClick") == true,
            ["SubmitOnItemClick"] = QueryFlag("submit") == true,
            ["KeepHighlight"] = QueryFlag("keepHighlight") == true,
            ["Required"] = QueryFlag("required") == true,
            ["DefaultOpen"] = QueryFlag("defaultOpen") == true,
            ["Form"] = QueryFlag("externalForm") == true ? "external-form" : null,
            ["AutoHighlight"] = Query("autoHighlight") switch { "true" => (AutoHighlightValue?)true, "always" => AutoHighlightValue.Always, _ => null },
            ["Name"] = "tag",
            ["OnValueChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<string>>(this, RecordValueChange),
            ["OnOpenChange"] = EventCallback.Factory.Create<ValueChangeEventArgs<bool>>(this, RecordOpenChange),
            ["OnItemHighlighted"] = EventCallback.Factory.Create<AutocompleteItemHighlightedEventArgs<string>>(this, RecordAutocompleteHighlight),
        };
        if (Query("defaultValue") is { } text)
        {
            rootParameters["DefaultValue"] = text;
        }
    }

    private void RecordAutocompleteHighlight(AutocompleteItemHighlightedEventArgs<string> args)
    {
        Record("highlights", string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{Format(args.Value)}:{args.Details.Reason.ToLiteral()}:{args.Details.Index}"));
        Record("highlight-events", args.Details.Event.Type == EventSnapshot.PlaceholderType ? "none" : args.Details.Event.Type);
    }
}
