@namespace Iodine.Headless.Fixtures.Client.ScrollAreaFixtures
@using Iodine.Headless
@using Iodine.Headless.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `scroll-area-probe-select` fixture (tests/browser/scroll-area.probes.spec.ts; design point 12 (a) of the ScrollArea
    track, a probe no requirement row covers): Base UI's experiment `scroll-area/inside-select.tsx`. A Select whose value
    starts at `item-1`, an unaligned Positioner (`AlignItemWithTrigger="false"`, 8 px from the trigger), and in the Popup a
    ScrollArea whose Viewport (`tabindex="-1"`, 200 px at most) is the scroll container of 50 items of 30 px ("Item 1" ..
    "Item 50", values `item-<n>`), with a vertical scrollbar and its thumb. Test ids: `trigger`, `value`, `positioner`,
    `popup`, `root`, `viewport`, `scrollbar`, `thumb`.
*@
<FixtureContainer Name="scroll-area-probe-select" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges">
    <SelectRoot TValue="string" @ref="root" DefaultValue="@("item-1")" OnOpenChange="RecordOpenChange">
        <SelectTrigger @ref="trigger" data-testid="trigger" style="min-width: 144px; height: 40px">
            <SelectValue data-testid="value" />
        </SelectTrigger>
        <SelectPortal>
            <SelectPositioner data-testid="positioner" SideOffset="8" AlignItemWithTrigger="false">
                <SelectPopup data-testid="popup" style="position: relative; z-index: 1; box-sizing: border-box; padding-block: 4px; background: white; outline: 1px solid #ccc; max-height: var(--available-height)">
                    <ScrollAreaRoot data-testid="root">
                        <ScrollAreaViewport data-testid="viewport" tabindex="-1" style="max-height: 200px">
                            @for (int i = 1; i <= ItemCount; i++)
                            {
                                int n = i;
                                <SelectItem @key="n" Value="@("item-" + n)" style="box-sizing: border-box; height: 30px; padding: 0 16px; scroll-margin-block: 16px">
                                    <SelectItemText>Item @n</SelectItemText>
                                </SelectItem>
                            }
                        </ScrollAreaViewport>
                        <ScrollAreaScrollbar data-testid="scrollbar" style="width: 4px; margin: 8px; background: #ddd">
                            <ScrollAreaThumb data-testid="thumb" style="width: 100%; background: gray" />
                        </ScrollAreaScrollbar>
                    </ScrollAreaRoot>
                </SelectPopup>
            </SelectPositioner>
        </SelectPortal>
    </SelectRoot>
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
</FixtureContainer>

@code {
    private const int ItemCount = 50;
    private SelectRoot<string>? root;
    private SelectTrigger<string>? trigger;

    /// <inheritdoc />
    protected override IEnumerable<Task> Attachments => [root!.SessionAttached, trigger!.TwinsAttached];
}
