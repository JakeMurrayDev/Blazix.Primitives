@namespace Blazix.Primitives.Fixtures.Client.ScrollAreaFixtures
@using Blazix.Primitives
@using Blazix.Primitives.Fixtures.Client.PopupFixtures
@inherits PopupSuiteFixtureBase

@*
    The `scroll-area-probe-combobox` fixture (tests/browser/scroll-area.probes.spec.ts; design point 12 (a) of the ScrollArea
    track, a probe no requirement row covers): Base UI's command-palette layout (autocomplete demo `command-palette`) on a
    Combobox. An input, and in the Popup a ScrollArea whose Viewport (200 px at most) is the scroll container of the List
    inside its Content: 50 items of 30 px ("Item 1" .. "Item 50", the root's `Items`, filtered by the input), with a
    vertical scrollbar and its thumb. Test ids: `input`, `positioner`, `popup`, `root`, `viewport`, `list`, `scrollbar`, `thumb`.
*@
<FixtureContainer Name="scroll-area-probe-combobox" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges">
    <ComboboxRoot TValue="string" @ref="root" Items="@s_items" OnOpenChange="RecordOpenChange">
        <ComboboxInput @ref="input" data-testid="input" aria-label="Item" />
        <ComboboxPortal>
            <ComboboxPositioner data-testid="positioner" SideOffset="4">
                <ComboboxPopup data-testid="popup" style="position: relative; z-index: 1; box-sizing: border-box; width: 200px; background: white; outline: 1px solid #ccc; max-height: var(--available-height)">
                    <ScrollAreaRoot data-testid="root" style="display: flex; max-height: 200px; overflow: hidden">
                        <ScrollAreaViewport data-testid="viewport" style="flex: 1; min-height: 0; overscroll-behavior: contain">
                            <ScrollAreaContent style="min-width: 100%">
                                <ComboboxList TValue="string" data-testid="list">
                                    <ItemContent>
                                        <ComboboxItem TValue="string" Value="@context.Value" @key="context.Value" style="box-sizing: border-box; height: 30px; padding: 0 16px; scroll-margin-block: 4px">@context.Value</ComboboxItem>
                                    </ItemContent>
                                </ComboboxList>
                            </ScrollAreaContent>
                        </ScrollAreaViewport>
                        <ScrollAreaScrollbar data-testid="scrollbar" style="width: 4px; background: #ddd">
                            <ScrollAreaThumb data-testid="thumb" style="width: 100%; background: gray" />
                        </ScrollAreaScrollbar>
                    </ScrollAreaRoot>
                </ComboboxPopup>
            </ComboboxPositioner>
        </ComboboxPortal>
    </ComboboxRoot>
    <button type="button" tabindex="-1" data-sync-button data-key-control @onclick="() => Sync++" @onkeydown="OnShift(() => Sync++)">Sync</button>
</FixtureContainer>

@code {
    private static readonly string[] s_items = [.. Enumerable.Range(1, 50).Select(i => $"Item {i}")];
    private ComboboxRoot<string>? root;
    private ComboboxInput? input;

    /// <inheritdoc />
    protected override IEnumerable<Task> Attachments => [root!.SessionAttached, input!.TwinAttached];
}
