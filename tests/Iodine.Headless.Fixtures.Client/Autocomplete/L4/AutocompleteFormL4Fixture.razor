@namespace Iodine.Headless.Fixtures.Client.AutocompleteFixtures
@using Iodine.Headless
@using Iodine.Headless.Fixtures.Client.ComboboxFixtures
@inherits ComboboxL4FixtureBase

@*
    The `autocomplete-form` fixture (M6 track 11, issues 248 and 257): the Autocomplete titles of AutocompleteRoot.test.tsx,
    ComboboxRoot.test.tsx, ComboboxTrigger.test.tsx and ComboboxClear.test.tsx that the `autocomplete-root` fixture's single
    layout cannot host, one Base UI render per `case`:
    - `validation-ref`: a native form around a root over alpha with SubmitOnItemClick, and an unrelated Switch after the form;
    - `field-submit`: a form (`form=base` makes it Base UI's Form) around a Field named `q`, over alpha and alpine with
      SubmitOnItemClick, the List's test id `listbox`;
    - `on-submit`: a Form around a Field whose `validate` returns "error" for `one`, over a required root with the items one
      (Option 1) and two (Option 2), and a submit button;
    - `no-form`: a root with DefaultOpen and SubmitOnItemClick over apple, in no form;
    - `no-request-submit`: the same in a form labelled `search` (the page removes its `requestSubmit`);
    - `popup-validate`: a Field validating on blur around a root with DefaultOpen and DefaultValue `query`, a Trigger, and the
      Input inside the popup;
    - `trigger-validate`: a Field validating on blur around a root with DefaultValue `query` and a Trigger only;
    - `clear` (issue 257, ComboboxClear.test.tsx): a root with DefaultValue `apple`, an Input and a Clear;
    - `inline-always`: an inline root over apple, banana and cherry with AutoHighlight always, KeepHighlight and Open, an Input
      and a List, and an `outside` button after it.
    Recorded: `validations` (each value the Field validates), `form-submits` (each submission Base UI's Form hands its
    callback), and the base's open changes. The page counts native submits itself, with a listener on `form`.
*@
<FixtureContainer Name="autocomplete-form" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-open-changes="@OpenChanges" data-open-change-completes="@OpenChangeCompletes" @attributes="Records">
    @SyncButton
    @switch (Case)
    {
        case "validation-ref":
            <form data-testid="form" onsubmit="event.preventDefault()">
                <AutocompleteRoot TValue="string" @ref="root" Items="s_alpha" SubmitOnItemClick="true">
                    <AutocompleteInput @ref="input" />
                    @Popup(null)
                </AutocompleteRoot>
            </form>
            <SwitchRoot aria-label="Unrelated switch" />
            break;
        case "field-submit":
            if (Query("form") == "base")
            {
                <Form @ref="form" OnFormSubmit="@(() => Record("form-submits", "submitted"))" data-testid="form">
                    @FieldSubmit
                </Form>
            }
            else
            {
                <form data-testid="form" onsubmit="event.preventDefault()">
                    @FieldSubmit
                </form>
            }
            break;
        case "on-submit":
            <Form @ref="form">
                <FieldRoot Validate="Validate" ValidationMode="ValidationMode.OnSubmit">
                    <AutocompleteRoot TValue="string" @ref="root" Required="true">
                        <AutocompleteInput @ref="input" data-testid="input" />
                        <AutocompletePortal>
                            <AutocompletePositioner>
                                <AutocompletePopup>
                                    <AutocompleteList TValue="string">
                                        <AutocompleteItem TValue="string" Value="@("one")">Option 1</AutocompleteItem>
                                        <AutocompleteItem TValue="string" Value="@("two")">Option 2</AutocompleteItem>
                                    </AutocompleteList>
                                </AutocompletePopup>
                            </AutocompletePositioner>
                        </AutocompletePortal>
                    </AutocompleteRoot>
                </FieldRoot>
                <button type="submit">submit</button>
            </Form>
            break;
        case "no-form":
            <AutocompleteRoot TValue="string" @ref="root" Items="s_apple" DefaultOpen="true" SubmitOnItemClick="true">
                <AutocompleteInput @ref="input" />
                @Popup(null)
            </AutocompleteRoot>
            break;
        case "no-request-submit":
            <form aria-label="search" data-testid="form" onsubmit="event.preventDefault()">
                <AutocompleteRoot TValue="string" @ref="root" Items="s_apple" DefaultOpen="true" SubmitOnItemClick="true">
                    <AutocompleteInput @ref="input" />
                    @Popup(null)
                </AutocompleteRoot>
            </form>
            break;
        case "popup-validate":
            <FieldRoot ValidationMode="ValidationMode.OnBlur" Validate="Validate">
                <AutocompleteRoot TValue="string" @ref="root" DefaultOpen="true" DefaultValue="query">
                    <AutocompleteTrigger @ref="trigger" data-testid="trigger">Open</AutocompleteTrigger>
                    <AutocompletePortal>
                        <AutocompletePositioner>
                            <AutocompletePopup data-testid="popup">
                                <AutocompleteInput @ref="input" data-testid="input" />
                            </AutocompletePopup>
                        </AutocompletePositioner>
                    </AutocompletePortal>
                </AutocompleteRoot>
            </FieldRoot>
            break;
        case "trigger-validate":
            <FieldRoot ValidationMode="ValidationMode.OnBlur" Validate="Validate">
                <AutocompleteRoot TValue="string" @ref="root" DefaultValue="query">
                    <AutocompleteTrigger @ref="trigger" data-testid="trigger" />
                </AutocompleteRoot>
            </FieldRoot>
            break;
        case "clear":
            <AutocompleteRoot TValue="string" @ref="root" DefaultValue="apple">
                <AutocompleteInput @ref="input" data-testid="input" />
                <AutocompleteClear data-testid="clear" />
            </AutocompleteRoot>
            break;
        case "inline-always":
            <AutocompleteRoot TValue="string" @ref="root" Items="s_fruits" AutoHighlight="AutoHighlightValue.Always" KeepHighlight="true"
                              Open="true" Inline="true">
                <AutocompleteInput @ref="input" data-testid="input" />
                <AutocompleteList TValue="string">
                    <ItemContent>
                        <AutocompleteItem TValue="string" Value="@context.Value" @key="context.Value">@context.Value</AutocompleteItem>
                    </ItemContent>
                </AutocompleteList>
            </AutocompleteRoot>
            <button type="button" data-testid="outside">outside</button>
            break;
    }
</FixtureContainer>

@code {
    private static readonly string[] s_alpha = ["alpha"];
    private static readonly string[] s_apple = ["apple"];
    private static readonly string[] s_alphaAlpine = ["alpha", "alpine"];
    private static readonly string[] s_fruits = ["apple", "banana", "cherry"];
    private AutocompleteRoot<string>? root;
    private AutocompleteInput? input;
    private AutocompleteTrigger? trigger;
    private Form? form;

    protected override IEnumerable<Task> Attachments =>
        [root?.SessionAttached ?? Task.CompletedTask, input?.TwinAttached ?? Task.CompletedTask, trigger?.TwinAttached ?? Task.CompletedTask,
         form?.TwinAttached ?? Task.CompletedTask];

    private RenderFragment FieldSubmit =>
        @<FieldRoot Name="q">
            <AutocompleteRoot TValue="string" @ref="root" Items="s_alphaAlpine" SubmitOnItemClick="true">
                <AutocompleteInput @ref="input" />
                @Popup("listbox")
            </AutocompleteRoot>
        </FieldRoot>;

    private RenderFragment Popup(string? listId) =>
        @<AutocompletePortal>
            <AutocompletePositioner>
                <AutocompletePopup>
                    <AutocompleteList TValue="string" data-testid="@listId">
                        <ItemContent>
                            <AutocompleteItem TValue="string" Value="@context.Value" @key="context.Value">@context.Value</AutocompleteItem>
                        </ItemContent>
                    </AutocompleteList>
                </AutocompletePopup>
            </AutocompletePositioner>
        </AutocompletePortal>;

    private ValueTask<FieldValidationResult?> Validate(FieldValidationArguments arguments)
    {
        Record("validations", Format(arguments.Value as string));
        return ValueTask.FromResult<FieldValidationResult?>(arguments.Value as string == "one" ? "error" : null);
    }
}
