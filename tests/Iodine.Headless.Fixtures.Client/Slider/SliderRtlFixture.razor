@namespace Iodine.Headless.Fixtures.Client.SliderFixtures
@using Iodine.Headless
@inherits SliderFixtureBase

@*
    The `slider-rtl` fixture (tests/browser/slider.control.spec.ts): one horizontal single-thumb slider inside
    `dir="rtl"` and a right-to-left DirectionProvider, DefaultValue from `?value=` (default 30). The Control's content box
    is 100 px by 10 px, with a 1 px border and unequal padding (7 px on the right, the inline start; 3 px on the left), so
    SLD-PTR-04's offsets are not symmetric; the Track fills the content box and positions the 10 px thumb.
*@
<FixtureContainer Name="slider-rtl" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-changes="@string.Join(" ", Changes)" data-commits="@string.Join(" ", Commits)">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <div dir="rtl" style="width: 300px; padding: 24px 0">
        <DirectionProvider Direction="TextDirection.Rtl">
            <SliderRoot @ref="Root" DefaultValue="@defaultValue"
                        Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                        OnValueChange="RecordChange" OnValueCommitted="RecordCommit" data-testid="root">
                <SliderControl data-testid="control"
                               style="box-sizing: content-box; width: 100px; height: 10px; position: relative; padding: 0 7px 0 3px; border: 1px solid black">
                    <SliderTrack data-testid="track" style="position: relative; width: 100%; height: 100%">
                        <SliderIndicator data-testid="indicator" />
                        <SliderThumb data-testid="thumb" aria-label="Volume" style="width: 10px; height: 10px; background: red" />
                    </SliderTrack>
                </SliderControl>
            </SliderRoot>
        </DirectionProvider>
    </div>
</FixtureContainer>

@code {
    private double? defaultValue;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        defaultValue = double.Parse(Query("value", "30"), System.Globalization.CultureInfo.InvariantCulture);
    }
}
