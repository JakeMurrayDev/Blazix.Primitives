@namespace Iodine.Headless.Fixtures.Client.SliderFixtures
@using Iodine.Headless
@inherits SliderFixtureBase

@*
    The `slider-range` fixture (tests/browser/slider.control.spec.ts): one range slider, DefaultValues from `?values=`
    (comma-separated, default `20,40`; one number is a one-element array), `?collision=` (push | swap | none, default
    push), `?minSteps=` (MinStepsBetweenValues, default 0) and `?thumbs=` (how many thumbs are rendered, default one per
    value). A 100 px Control with no padding, its Track filling it, 10 px thumbs `thumb-0`.. with `Index`; an `after`
    button and an `elsewhere` box below the slider. Records OnValuesChange (`data-changes`) and OnValuesCommitted
    (`data-commits`).
*@
<FixtureContainer Name="slider-range" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-changes="@string.Join(" ", Changes)" data-commits="@string.Join(" ", Commits)">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <div style="padding: 24px 0">
        <SliderRoot @ref="Root" DefaultValues="@defaultValues" ThumbCollisionBehavior="@collision" MinStepsBetweenValues="@minSteps"
                    Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                    OnValuesChange="RecordChanges" OnValuesCommitted="RecordCommits" data-testid="root">
            <SliderControl data-testid="control" style="box-sizing: content-box; width: 100px; height: 10px; position: relative">
                <SliderTrack data-testid="track" style="position: relative; width: 100%; height: 100%">
                    <SliderIndicator data-testid="indicator" />
                    @for (int i = 0; i < thumbs; i++)
                    {
                        int index = i;
                        <SliderThumb Index="@index" data-testid="@($"thumb-{index}")" aria-label="@($"Thumb {index}")"
                                     style="width: 10px; height: 10px; background: red" />
                    }
                </SliderTrack>
            </SliderControl>
        </SliderRoot>
    </div>
    <button type="button" data-testid="after">After</button>
    <div data-testid="elsewhere" style="width: 100px; height: 40px; margin-top: 20px; background: #eee"></div>
</FixtureContainer>

@code {
    private double[] defaultValues = [];
    private SliderThumbCollisionBehavior collision;
    private double minSteps;
    private int thumbs;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        defaultValues = Query("values", "20,40")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(text => double.Parse(text, System.Globalization.CultureInfo.InvariantCulture))
            .ToArray();
        collision = Query("collision", "push") switch
        {
            "swap" => SliderThumbCollisionBehavior.Swap,
            "none" => SliderThumbCollisionBehavior.None,
            _ => SliderThumbCollisionBehavior.Push,
        };
        minSteps = double.Parse(Query("minSteps", "0"), System.Globalization.CultureInfo.InvariantCulture);
        thumbs = int.Parse(Query("thumbs", defaultValues.Length.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            System.Globalization.CultureInfo.InvariantCulture);
    }
}
