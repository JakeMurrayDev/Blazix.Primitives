@namespace Blazix.Primitives.Fixtures.Client.SliderFixtures
@using Blazix.Primitives
@inherits SliderFixtureBase

@*
    The `slider-relaxations` fixture (tests/browser/slider.relaxations.spec.ts): ADR 01's relaxation rows for the Slider,
    measured per render mode. One single-thumb slider, DefaultValue 25 (or a controlled Value of 25 with `?controlled=1`,
    following OnValueChange), inside a DirectionProvider, a 100 px Control with a 10 px thumb, a Value part. Query:
    `pointerVeto=1` (the Control's consumer `onpointerdown` calls PreventPartHandler(), counted as `data-pointer-vetoes`),
    `keyVeto=1` (the thumb's consumer `onkeydown` calls PreventPartHandler(), counted as `data-key-vetoes`), `cancel=1`
    (OnValueChange calls Cancel()), `field=1` (inside a FieldRoot `field`). The buttons, pressed with a DOM click so focus
    stays, change an update-carried value: `set-min` (Min 20), `set-max` (Max 50), `set-step` (Step 10),
    `toggle-disabled`, `toggle-orientation` (vertical), `toggle-direction` (right to left), `set-value` (the controlled
    Value 70); the wrapper renders the direction as `data-direction`, the render's marker. Records OnValueChange
    (`data-changes`) and OnValueCommitted (`data-commits`).
*@
<FixtureContainer Name="slider-relaxations" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-changes="@string.Join(" ", Changes)" data-commits="@string.Join(" ", Commits)"
                  data-pointer-vetoes="@pointerVetoes" data-key-vetoes="@keyVetoes">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <button type="button" data-testid="set-min" @onclick="() => min = 20">Min</button>
    <button type="button" data-testid="set-max" @onclick="() => max = 50">Max</button>
    <button type="button" data-testid="set-step" @onclick="() => step = 10">Step</button>
    <button type="button" data-testid="toggle-disabled" @onclick="() => disabled = !disabled">Disabled</button>
    <button type="button" data-testid="toggle-orientation" @onclick="ToggleOrientation">Orientation</button>
    <button type="button" data-testid="toggle-direction" @onclick="ToggleDirection">Direction</button>
    <button type="button" data-testid="set-value" @onclick="() => value = 70">Value</button>
    <div style="padding: 24px 0" data-direction="@direction">
        <DirectionProvider Direction="@direction">
            @if (field)
            {
                <FieldRoot data-testid="field">
                    @Slider
                </FieldRoot>
            }
            else
            {
                @Slider
            }
        </DirectionProvider>
    </div>
</FixtureContainer>

@code {
    private double min;
    private double max = 100;
    private double step = 1;
    private bool disabled;
    private Orientation orientation = Orientation.Horizontal;
    private TextDirection direction = TextDirection.Ltr;
    private double? value = 25;
    private bool controlled;
    private bool pointerVeto;
    private bool keyVeto;
    private bool cancel;
    private bool field;
    private int pointerVetoes;
    private int keyVetoes;

    private RenderFragment Slider => __builder =>
    {
        if (controlled)
        {
            <SliderRoot @ref="Root" Value="@value" ValueChanged="@((double? next) => value = next)" Min="@min" Max="@max"
                        Step="@step" Disabled="@disabled" Orientation="@orientation"
                        Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                        OnValueChange="OnChange" OnValueCommitted="RecordCommit" data-testid="root">
                @Parts
            </SliderRoot>
        }
        else
        {
            <SliderRoot @ref="Root" DefaultValue="25" Min="@min" Max="@max" Step="@step" Disabled="@disabled"
                        Orientation="@orientation" Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                        OnValueChange="OnChange" OnValueCommitted="RecordCommit" data-testid="root">
                @Parts
            </SliderRoot>
        }
    };

    private RenderFragment Parts => __builder =>
    {
        <SliderValue data-testid="value" />
        @if (pointerVeto)
        {
            <SliderControl data-testid="control" style="width: 100px; height: 10px; position: relative" @onpointerdown="VetoPointer">
                @Track
            </SliderControl>
        }
        else
        {
            <SliderControl data-testid="control" style="width: 100px; height: 10px; position: relative">
                @Track
            </SliderControl>
        }
    };

    private RenderFragment Track => __builder =>
    {
        <SliderTrack data-testid="track" style="width: 100%; height: 100%">
            <SliderIndicator data-testid="indicator" />
            @if (keyVeto)
            {
                <SliderThumb data-testid="thumb" aria-label="Volume" style="width: 10px; height: 10px; background: red"
                             @onkeydown="VetoKey" />
            }
            else
            {
                <SliderThumb data-testid="thumb" aria-label="Volume" style="width: 10px; height: 10px; background: red" />
            }
        </SliderTrack>
    };

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        controlled = Query("controlled", "0") == "1";
        pointerVeto = Query("pointerVeto", "0") == "1";
        keyVeto = Query("keyVeto", "0") == "1";
        cancel = Query("cancel", "0") == "1";
        field = Query("field", "0") == "1";
    }

    private void OnChange(ValueChangeEventArgs<double> args)
    {
        RecordChange(args);
        if (cancel)
        {
            args.Details.Cancel();
        }
    }

    private void VetoPointer(PointerEventArgs e)
    {
        pointerVetoes++;
        e.PreventPartHandler();
    }

    private void VetoKey(KeyboardEventArgs e)
    {
        keyVetoes++;
        e.PreventPartHandler();
    }

    private void ToggleOrientation() =>
        orientation = orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;

    private void ToggleDirection() =>
        direction = direction == TextDirection.Ltr ? TextDirection.Rtl : TextDirection.Ltr;
}
