@namespace Iodine.Headless.Fixtures.Client.SliderFixtures
@using Iodine.Headless
@inherits SliderFixtureBase

@*
    The `slider-field` fixture (tests/browser/slider.field.spec.ts): a slider inside a FieldRoot (`field`), for the SLD-FRM,
    SLD-FOC-04/06/07 and SLD-EDGE-10 titles. Query: `value=` (single DefaultValue; absent: no default, the minimum) or
    `values=` (range DefaultValues, comma-separated; one number is a one-element array); `thumbs=` (default one per value);
    `mode=` (onBlur | onChange | onSubmit, default none); `validate=` (none | gt1: "error" above 1 | record: valid | error:
    always "error"; every call's value recorded as `data-validations`, space-separated); `name=` (the FieldRoot's Name);
    `format=usd` (Format "C"); `form=1` (inside a Form with a `submit` button); `label=1` (a SliderLabel "Volume" before the
    Control); `unrelated=1` (an unlabelled-by-the-slider `<input type="range" aria-label="Unrelated range">` first in the
    Control); `help=1` (a Help button last in the Control). Range thumbs carry `Index` and `aria-label` "Thumb i" (none
    with `label=1`); every thumb is keyed by its index, so unmounting the first keeps the others' elements (as React's
    positional slots do). The toggles (pressed with a DOM click, so focus stays): `first-disabled` (the first thumb's Disabled)
    and `first-mounted` (the first thumb's presence); an Outside button follows the field.
*@
<FixtureContainer Name="slider-field" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-validations="@string.Join(" ", validations)" data-changes="@string.Join(" ", Changes)">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <button type="button" data-toggle="first-disabled" @onclick="() => firstDisabled = !firstDisabled">First disabled</button>
    <button type="button" data-toggle="first-mounted" @onclick="() => firstMounted = !firstMounted">First mounted</button>
    @if (inForm)
    {
        <Form @ref="FormPart" data-testid="form">
            @Body
            <button type="submit">submit</button>
        </Form>
    }
    else
    {
        @Body
    }
    <button type="button">Outside</button>
</FixtureContainer>

@code {
    private readonly List<string> validations = [];
    private double? defaultValue;
    private double[]? defaultValues;
    private int thumbs;
    private ValidationMode? mode;
    private string validate = "none";
    private string? name;
    private string? format;
    private bool inForm;
    private bool label;
    private bool unrelated;
    private bool help;
    private bool firstDisabled;
    private bool firstMounted = true;

    private Func<FieldValidationArguments, ValueTask<FieldValidationResult?>>? Validator => validate == "none" ? null : Validate;

    private RenderFragment Body => __builder =>
    {
        <FieldRoot Name="@name" ValidationMode="@mode" Validate="@Validator" data-testid="field">
            @if (defaultValues is null)
            {
                <SliderRoot @ref="Root" DefaultValue="@defaultValue" Format="@format" Culture="@Culture"
                            OnValueChange="RecordChange" data-testid="root">
                    @Parts
                </SliderRoot>
            }
            else
            {
                <SliderRoot @ref="Root" DefaultValues="@defaultValues" Format="@format" Culture="@Culture"
                            OnValuesChange="RecordChanges" data-testid="root">
                    @Parts
                </SliderRoot>
            }
            <FieldError data-testid="error" />
        </FieldRoot>
    };

    private RenderFragment Parts => __builder =>
    {
        if (label)
        {
            <SliderLabel @ref="Label" data-testid="label">Volume</SliderLabel>
        }
        <SliderControl data-testid="control" style="width: 100px; height: 10px; position: relative">
            @if (unrelated)
            {
                <input aria-label="Unrelated range" type="range" />
            }
            <SliderTrack data-testid="track" style="width: 100%; height: 100%">
                @for (int i = 0; i < thumbs; i++)
                {
                    int index = i;
                    if (index == 0 && !firstMounted)
                    {
                        continue;
                    }

                    if (defaultValues is null)
                    {
                        <SliderThumb @key="index" Disabled="@(index == 0 && firstDisabled)" data-testid="@($"thumb-{index}")"
                                     style="width: 10px; height: 10px; background: red" />
                    }
                    else
                    {
                        <SliderThumb @key="index" Index="@index" Disabled="@(index == 0 && firstDisabled)" data-testid="@($"thumb-{index}")"
                                     aria-label="@(label ? null : $"Thumb {index}")" style="width: 10px; height: 10px; background: red" />
                    }
                }
            </SliderTrack>
            @if (help)
            {
                <button type="button">Help</button>
            }
        </SliderControl>
    };

    private static System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.GetCultureInfo("en-US");

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        System.Globalization.CultureInfo invariant = System.Globalization.CultureInfo.InvariantCulture;
        string single = Query("value", "");
        string range = Query("values", "");
        if (range.Length > 0)
        {
            defaultValues = range.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(text => double.Parse(text, invariant)).ToArray();
        }
        else if (single.Length > 0)
        {
            defaultValue = double.Parse(single, invariant);
        }

        thumbs = int.Parse(Query("thumbs", (defaultValues?.Length ?? 1).ToString(invariant)), invariant);
        mode = Query("mode", "") switch
        {
            "onBlur" => ValidationMode.OnBlur,
            "onChange" => ValidationMode.OnChange,
            "onSubmit" => ValidationMode.OnSubmit,
            _ => null,
        };
        validate = Query("validate", "none");
        name = Query("name", "") is { Length: > 0 } text ? text : null;
        format = Query("format", "") == "usd" ? "C" : null;
        inForm = Query("form", "") == "1";
        label = Query("label", "") == "1";
        unrelated = Query("unrelated", "") == "1";
        help = Query("help", "") == "1";
    }

    private ValueTask<FieldValidationResult?> Validate(FieldValidationArguments arguments)
    {
        validations.Add(arguments.Value switch
        {
            double number => Show(number),
            IReadOnlyList<double> list => Show(list),
            null => "null",
            object other => other.GetType().Name,
        });
        StateHasChanged();
        return validate switch
        {
            "gt1" => new(arguments.Value is double value && value > 1 ? "error" : null),
            "error" => new("error"),
            _ => new((FieldValidationResult?)null),
        };
    }
}
