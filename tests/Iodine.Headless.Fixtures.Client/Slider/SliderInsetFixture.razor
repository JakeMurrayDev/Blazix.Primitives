@namespace Iodine.Headless.Fixtures.Client.SliderFixtures
@using Iodine.Headless
@inherits SliderFixtureBase

@*
    The `slider-inset` fixture (tests/browser/slider.control.spec.ts): one inset slider, `?alignment=` (edge |
    edge-client-only, default edge), `?orientation=` (horizontal | vertical), `?thumb=` (the thumb's length along the
    axis in px, default 10) and `?values=` (one number is a single-thumb DefaultValue, a comma-separated list range
    DefaultValues; default 30). The Control is 100 px along the axis and 10 px across, its Track fills it; thumbs are
    `thumb-0`... With `?hidden=1` the slider starts inside a `display: none` box that the `show` button reveals
    (SliderThumb.test.tsx "recomputes inset positions when the slider becomes visible"). Records the callbacks of either
    shape as `data-changes` and `data-commits`.
*@
<FixtureContainer Name="slider-inset" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-changes="@string.Join(" ", Changes)" data-commits="@string.Join(" ", Commits)">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <button type="button" data-testid="show" @onclick="() => visible = true">show</button>
    <div data-testid="frame" style="display: @(visible ? "block" : "none"); padding: 24px 0">
        @if (values.Length > 1)
        {
            <SliderRoot @ref="Root" DefaultValues="@values" ThumbAlignment="@alignment" Orientation="@orientation"
                        Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                        OnValuesChange="RecordChanges" OnValuesCommitted="RecordCommits" data-testid="root">
                @Parts
            </SliderRoot>
        }
        else
        {
            <SliderRoot @ref="Root" DefaultValue="@values[0]" ThumbAlignment="@alignment" Orientation="@orientation"
                        Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                        OnValueChange="RecordChange" OnValueCommitted="RecordCommit" data-testid="root">
                @Parts
            </SliderRoot>
        }
    </div>
</FixtureContainer>

@code {
    private double[] values = [];
    private SliderThumbAlignment alignment;
    private Orientation orientation;
    private int thumb;
    private bool visible;

    private string ControlStyle => orientation == Orientation.Vertical
        ? "box-sizing: content-box; width: 10px; height: 100px; position: relative"
        : "box-sizing: content-box; width: 100px; height: 10px; position: relative";

    private string ThumbStyle => orientation == Orientation.Vertical
        ? $"width: 10px; height: {thumb}px; background: red"
        : $"width: {thumb}px; height: 10px; background: red";

    private RenderFragment Parts => @<SliderControl data-testid="control" style="@ControlStyle">
        <SliderTrack data-testid="track" style="position: relative; width: 100%; height: 100%">
            <SliderIndicator data-testid="indicator" />
            @for (int i = 0; i < values.Length; i++)
            {
                int index = i;
                <SliderThumb Index="@index" data-testid="@($"thumb-{index}")" style="@ThumbStyle" />
            }
        </SliderTrack>
    </SliderControl>;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        values = Query("values", "30")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(text => double.Parse(text, System.Globalization.CultureInfo.InvariantCulture))
            .ToArray();
        alignment = Query("alignment", "edge") == "edge-client-only" ? SliderThumbAlignment.EdgeClientOnly : SliderThumbAlignment.Edge;
        orientation = Query("orientation", "horizontal") == "vertical" ? Orientation.Vertical : Orientation.Horizontal;
        thumb = int.Parse(Query("thumb", "10"), System.Globalization.CultureInfo.InvariantCulture);
        visible = Query("hidden", "0") != "1";
    }
}
