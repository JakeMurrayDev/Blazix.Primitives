@namespace Iodine.Headless.Fixtures.Client.SliderFixtures
@using Iodine.Headless
@inherits SliderFixtureBase

@*
    The `slider-controlled` fixture (tests/browser/slider.control.spec.ts): a controlled range slider whose `Values` start
    from `?values=` (comma-separated, default `10,20,30`) and follow OnValuesChange only with `?follow=1`; one thumb
    `thumb-0`.. per value. The `shrink` and `grow` buttons set the values to `[10, 20]` and `[10, 20, 30]`
    (SliderControl.test.tsx's range-changes-mid-drag pages). A 100 px Control, 10 px thumbs. Records OnValuesChange
    (`data-changes`) and OnValuesCommitted (`data-commits`).
*@
<FixtureContainer Name="slider-controlled" data-attached="@(Attached ? "true" : "false")" data-sync="@Sync"
                  data-changes="@string.Join(" ", Changes)" data-commits="@string.Join(" ", Commits)">
    <button type="button" data-sync-button @onclick="() => Sync++">Sync</button>
    <div style="padding: 24px 0">
        <SliderRoot @ref="Root" Values="@values" Culture="@System.Globalization.CultureInfo.GetCultureInfo("en-US")"
                    OnValuesChange="OnChange" OnValuesCommitted="RecordCommits" data-testid="root">
            <SliderControl data-testid="control" style="box-sizing: content-box; width: 100px; height: 10px; position: relative">
                <SliderTrack data-testid="track" style="position: relative; width: 100%; height: 100%">
                    <SliderIndicator data-testid="indicator" />
                    @for (int i = 0; i < values.Count; i++)
                    {
                        int index = i;
                        <SliderThumb @key="index" Index="@index" data-testid="@($"thumb-{index}")"
                                     style="width: 10px; height: 10px; background: red" />
                    }
                </SliderTrack>
            </SliderControl>
        </SliderRoot>
    </div>
    <button type="button" data-testid="shrink" @onclick="() => values = [10, 20]">shrink</button>
    <button type="button" data-testid="grow" @onclick="() => values = [10, 20, 30]">grow</button>
</FixtureContainer>

@code {
    private IReadOnlyList<double> values = [];
    private bool follow;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        values = Query("values", "10,20,30")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(text => double.Parse(text, System.Globalization.CultureInfo.InvariantCulture))
            .ToArray();
        follow = Query("follow", "0") == "1";
    }

    private void OnChange(ValueChangeEventArgs<IReadOnlyList<double>> args)
    {
        RecordChanges(args);
        if (follow)
        {
            values = args.Value;
        }
    }
}
