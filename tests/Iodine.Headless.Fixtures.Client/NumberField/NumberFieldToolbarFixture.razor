@namespace Blazix.Primitives.Fixtures.Client.NumberFieldFixtures
@using System.Globalization
@using Blazix.Primitives

@*
    The `number-field-toolbar` fixture (tests/browser/toolbar.spec.ts, its NumberField block; ToolbarInput.test.tsx's
    "rendering NumberField" titles): a horizontal toolbar whose input is substituted by a number field's input, between the
    field's steppers (min 1, max 10, defaultValue 5). `?case=disabled` disables the toolbar input. Every OnValueChange is
    recorded as `value/reason` in data-changes; data-attached is rendered once the number-field module and the toolbar's
    input item are attached.
*@
<FixtureContainer Name="number-field-toolbar" data-attached="@(attached ? "true" : "false")" data-changes="@string.Join(' ', changes)">
    <ToolbarRoot>
        <NumberFieldRoot Min="1" Max="10" DefaultValue="5" Culture="s_enUs" OnValueChange="Change">
            <NumberFieldGroup>
                <NumberFieldDecrement />
                <ToolbarInput @ref="toolbarInput" Disabled="@(Case == "disabled")" Render="substitute" />
                <NumberFieldIncrement />
            </NumberFieldGroup>
        </NumberFieldRoot>
    </ToolbarRoot>
</FixtureContainer>

@code {
    private static readonly CultureInfo s_enUs = CultureInfo.GetCultureInfo("en-US");
    private readonly List<string> changes = [];
    private ToolbarInput? toolbarInput;
    private NumberFieldInput? input;
    private bool attached;
    private RenderFragment? substitute;

    [SupplyParameterFromQuery(Name = "case")]
    public string? Case { get; set; }

    protected override void OnInitialized()
    {
        substitute = @<NumberFieldInput @ref="input" />;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        await Task.WhenAll(input!.TwinAttached, toolbarInput!.TwinAttached);
        attached = true;
        StateHasChanged();
    }

    private void Change(ValueChangeEventArgs<double?> e)
    {
        string value = e.Value is double number ? number.ToString(CultureInfo.InvariantCulture) : "null";
        changes.Add($"{value}/{e.Details.Reason.ToLiteral()}");
    }
}
