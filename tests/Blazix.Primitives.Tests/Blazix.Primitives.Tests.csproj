<Project Sdk="Microsoft.NET.Sdk">

  <!-- L1 (ADR 06 §1): xUnit, no Blazor. References the library only, never bUnit; the reference graph enforces the layer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- ADR 06 §1: C# timers under a FakeTimeProvider (the Avatar fallback delay). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blazix.Primitives\Blazix.Primitives.csproj" />
    <!-- The generators run on this project's own state records ([PartState], [StoreState]), as they do in a consumer's project. -->
    <ProjectReference Include="..\..\src\Blazix.Primitives.Generators\Blazix.Primitives.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
