@namespace Blazix.Primitives.Tests.Components
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@*
    The test consumer of CheckboxGroup.test.tsx's Field titles: a Field.Root around one group, with an optional Field.Label
    and Field.Description in the field's scope, and each box optionally inside a Field.Item with its own label (wrapping or
    sibling) and description. A controlled host keeps the value a Base UI test keeps with useState.
*@
<FieldRoot data-testid="root" Name="@FieldName" ValidationMode="ValidationMode" Validate="Validate" @ref="Field">
    @if (ShowLabel)
    {
        <FieldLabel data-testid="field-label">Apples</FieldLabel>
    }
    @if (EditContext is not null)
    {
        <CascadingValue Value="EditContext" IsFixed="true">
            @RenderGroup
        </CascadingValue>
    }
    else
    {
        @RenderGroup
    }
</FieldRoot>

@code {
    [Parameter] public string? FieldName { get; set; }
    [Parameter] public ValidationMode? ValidationMode { get; set; }
    [Parameter] public Func<FieldValidationArguments, ValueTask<FieldValidationResult?>>? Validate { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public bool ShowGroupDescription { get; set; }
    [Parameter] public ItemLayout Items { get; set; }
    [Parameter] public IReadOnlyList<GroupBox> Boxes { get; set; } = [];
    [Parameter] public IReadOnlyList<string>? AllValues { get; set; }
    [Parameter] public IReadOnlyList<string>? DefaultValue { get; set; }
    [Parameter] public bool Controlled { get; set; }
    [Parameter] public IReadOnlyList<string>? Value { get; set; }
    [Parameter] public bool GroupDisabled { get; set; }
    [Parameter] public Dictionary<string, object>? GroupAttributes { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public Expression<Func<IReadOnlyList<string>>>? ValueExpression { get; set; }

    public FieldRoot? Field { get; private set; }

    /// <summary>How each box is placed.</summary>
    public enum ItemLayout
    {
        None,
        WrappingLabel,
        SiblingLabel,
    }

    private RenderFragment RenderGroup => builder =>
    {
        builder.OpenComponent<CheckboxGroup>(0);
        builder.AddMultipleAttributes(1, GroupAttributes ?? new Dictionary<string, object> { ["data-testid"] = "group" });
        builder.AddComponentParameter(2, nameof(CheckboxGroup.AllValues), AllValues);
        builder.AddComponentParameter(3, nameof(CheckboxGroup.DefaultValue), DefaultValue);
        builder.AddComponentParameter(4, nameof(CheckboxGroup.Disabled), GroupDisabled);
        if (Controlled)
        {
            builder.AddComponentParameter(5, nameof(CheckboxGroup.Value), Value);
            builder.AddComponentParameter(6, nameof(CheckboxGroup.ValueChanged), EventCallback.Factory.Create<IReadOnlyList<string>>(this, next => Value = next));
        }

        if (ValueExpression is not null)
        {
            builder.AddComponentParameter(7, nameof(CheckboxGroup.ValueExpression), ValueExpression);
        }

        builder.AddComponentParameter(8, nameof(CheckboxGroup.ChildContent), (RenderFragment)(content =>
        {
            if (ShowGroupDescription)
            {
                content.OpenComponent<FieldDescription>(0);
                content.AddAttribute(1, "data-testid", "group-description");
                content.CloseComponent();
            }

            foreach (GroupBox box in Boxes)
            {
                if (box.Mounted)
                {
                    content.AddContent(2, RenderItem(box));
                }
            }
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderItem(GroupBox box) => builder =>
    {
        if (Items == ItemLayout.None)
        {
            builder.AddContent(0, RenderBox(box));
            return;
        }

        builder.OpenComponent<FieldItem>(1);
        builder.SetKey(box.TestId);
        builder.AddComponentParameter(2, nameof(FieldItem.ChildContent), (RenderFragment)(item =>
        {
            if (Items == ItemLayout.WrappingLabel)
            {
                item.OpenComponent<FieldLabel>(0);
                item.AddAttribute(1, "data-testid", "label");
                item.AddAttribute(2, "ChildContent", (RenderFragment)(label =>
                {
                    label.AddContent(0, RenderBox(box));
                    label.AddContent(1, box.TestId);
                }));
                item.CloseComponent();
            }
            else
            {
                item.AddContent(3, RenderBox(box));
                item.OpenComponent<FieldLabel>(4);
                item.AddAttribute(5, "data-testid", "label");
                item.AddAttribute(6, "ChildContent", (RenderFragment)(label => label.AddContent(0, box.TestId)));
                item.CloseComponent();
                item.OpenComponent<FieldDescription>(7);
                item.AddAttribute(8, "data-testid", "description");
                item.CloseComponent();
            }
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderBox(GroupBox box) => builder =>
    {
        builder.OpenComponent<CheckboxRoot>(0);
        builder.SetKey(box.TestId);
        Dictionary<string, object> attributes = new() { ["data-testid"] = box.TestId };
        if (box.Id is not null)
        {
            attributes["id"] = box.Id;
        }

        if (box.DescribedBy is not null)
        {
            attributes["aria-describedby"] = box.DescribedBy;
        }

        builder.AddMultipleAttributes(1, attributes);
        builder.AddComponentParameter(2, nameof(CheckboxRoot.Name), box.Name);
        builder.AddComponentParameter(3, nameof(CheckboxRoot.Value), box.Value);
        builder.AddComponentParameter(4, nameof(CheckboxRoot.Parent), box.Parent);
        builder.AddComponentParameter(5, nameof(CheckboxRoot.Disabled), box.Disabled);
        builder.AddComponentParameter(6, nameof(CheckboxRoot.Required), box.Required);
        builder.AddComponentParameter(7, nameof(CheckboxRoot.NativeButton), box.NativeButton);
        builder.AddComponentParameter(8, nameof(CheckboxRoot.OnCheckedChange), EventCallback.Factory.Create<ValueChangeEventArgs<bool>>(this, args => box.Changes.Add(args.Value)));
        if (box.NativeButton)
        {
            builder.AddComponentParameter(9, nameof(CheckboxRoot.Render), (RenderFragment)(b =>
            {
                b.OpenElement(0, "button");
                b.CloseElement();
            }));
        }

        builder.CloseComponent();
    };
}
