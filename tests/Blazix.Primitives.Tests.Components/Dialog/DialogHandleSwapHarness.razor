@namespace Blazix.Primitives.Tests.Components
@* DialogRoot.detached-triggers.test.tsx, the handle-swap titles: a detached trigger and a non-modal root whose handles are
   parameters (Base UI's state setters), uncontrolled with pointer dismissal disabled, or controlled open with the trigger
   as its active trigger when ControlledOpen is set. *@
<div>
    @if (TriggerPayload is { } triggerPayload)
    {
        <DialogTrigger TPayload="int?" Handle="TriggerHandle" id="@TriggerId" Payload="triggerPayload">Trigger</DialogTrigger>
    }
    else
    {
        <DialogTrigger TPayload="int?" Handle="TriggerHandle" id="@TriggerId">Trigger</DialogTrigger>
    }
    @if (ControlledOpen is { } open)
    {
        <DialogRoot TPayload="int?" @ref="Root" Handle="RootHandle" Open="open" TriggerId="@TriggerId" Modal="false">
            <DialogPortal>
                <DialogPopup data-testid="popup">Dialog Content</DialogPopup>
            </DialogPortal>
        </DialogRoot>
    }
    else
    {
        <DialogRoot TPayload="int?" @ref="Root" Handle="RootHandle" Modal="false" DisablePointerDismissal="true">
            <DialogPortal>
                <DialogPopup data-testid="popup">Dialog Content</DialogPopup>
            </DialogPortal>
        </DialogRoot>
    }
</div>

@code {
    public DialogRoot<int?>? Root { get; private set; }

    [Parameter] public DialogHandle<int?>? TriggerHandle { get; set; }

    [Parameter] public DialogHandle<int?>? RootHandle { get; set; }

    [Parameter] public string TriggerId { get; set; } = "trigger";

    [Parameter] public int? TriggerPayload { get; set; }

    [Parameter] public bool? ControlledOpen { get; set; }
}
