   the second trigger's id, in the root's own first render batch. *@
<DialogTrigger TPayload="int?" Handle="Handle" id="other" Payload="9">Other</DialogTrigger>
<DialogTrigger TPayload="int?" Handle="Handle" id="trigger" Payload="5">Trigger</DialogTrigger>
