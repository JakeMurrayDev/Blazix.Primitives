@namespace Blazix.Primitives.Tests.Components
@*
    The contained-trigger tooltip of TooltipRoot.test.tsx (ContainedTriggerTooltip, :1-40), with wrapper slots between the
    parts (TIP-STR-11) and every root parameter a test sets.
*@

<TooltipRoot TPayload="NoPayload" @ref="Root" DefaultOpen="DefaultOpen" Disabled="Disabled" DisableHoverablePopup="DisableHoverablePopup"
             TrackCursorAxis="TrackCursorAxis" OnOpenChange="OnOpenChange" OnOpenChangeComplete="OnOpenChangeComplete">
    <span data-testid="before-trigger"></span>
    <TooltipTrigger id="trigger" Disabled="TriggerDisabled" Delay="Delay" CloseDelay="CloseDelay" CloseOnClick="CloseOnClick">Toggle</TooltipTrigger>
    <span data-testid="between-trigger-and-portal"></span>
    <TooltipPortal KeepMounted="KeepMounted">
        <TooltipPositioner data-testid="positioner">
            <TooltipPopup data-testid="popup">
                Content
                <TooltipArrow data-testid="arrow" />
            </TooltipPopup>
        </TooltipPositioner>
    </TooltipPortal>
    <span data-testid="after-portal"></span>
</TooltipRoot>

@code {
    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool? TriggerDisabled { get; set; }

    [Parameter]
    public bool DisableHoverablePopup { get; set; }

    [Parameter]
    public TooltipTrackCursorAxis TrackCursorAxis { get; set; }

    [Parameter]
    public bool KeepMounted { get; set; }

    [Parameter]
    public Duration? Delay { get; set; }

    [Parameter]
    public Duration? CloseDelay { get; set; }

    [Parameter]
    public bool CloseOnClick { get; set; } = true;

    [Parameter]
    public EventCallback<ValueChangeEventArgs<bool>> OnOpenChange { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChangeComplete { get; set; }

    internal TooltipRoot<NoPayload>? Root { get; private set; }
}
