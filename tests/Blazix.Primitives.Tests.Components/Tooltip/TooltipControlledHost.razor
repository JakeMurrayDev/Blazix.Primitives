@namespace Blazix.Primitives.Tests.Components
@*
    A tooltip whose open state the host controls (TooltipRoot.test.tsx "controlled open"): OnOpenChange records each
    request and applies it unless Accept is false; Open is supplied at the first render (TIP-STA-03).
*@

<TooltipRoot TPayload="NoPayload" @ref="Root" Open="Open" OnOpenChange="HandleOpenChange" Disabled="Disabled">
    <TooltipTrigger id="trigger" Disabled="TriggerDisabled">Toggle</TooltipTrigger>
    <TooltipPortal>
        <TooltipPositioner>
            <TooltipPopup data-testid="popup">Content</TooltipPopup>
        </TooltipPositioner>
    </TooltipPortal>
</TooltipRoot>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool Accept { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool? TriggerDisabled { get; set; }

    internal TooltipRoot<NoPayload>? Root { get; private set; }

    internal List<(bool Open, EventReason Reason, bool WasOpen)> Calls { get; } = [];

    private void HandleOpenChange(ValueChangeEventArgs<bool> args)
    {
        Calls.Add((args.Value, args.Details.Reason, Root!.Store.IsOpen));
        if (Accept)
        {
            Open = args.Value;
        }
    }
}
