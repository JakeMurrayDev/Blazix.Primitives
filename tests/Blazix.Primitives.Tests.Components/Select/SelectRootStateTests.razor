    [Fact(DisplayName = "sets a hidden input id when name is not provided")]
    [Trait("Requirement", "SEL-API-10")]
    [Trait("Requirement", "SEL-DOM-48")]
    public void Sets_a_hidden_input_id_when_name_is_not_provided()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Id="test-id">
