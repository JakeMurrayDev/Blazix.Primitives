@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using AngleSharp.Dom
@using Bunit
@using Microsoft.AspNetCore.Components.Web
@*
    L2: SelectRoot.test.tsx's "prop: disabled", "prop: readOnly" and "prop: id" blocks, and the L2-cited title of its
    "select inside popover" block (M5 track 9). A press is the interactions module's report, an item activation the
    select module's, a closed or open typeahead the composite module's; the Tab and key presses themselves, the focus and
    the popover's outside-press tree are L4 (tests/browser/select.spec.ts). Not ported here: the "scroll arrows" titles
    (L3 geometry, L4), the other five "select inside popover" titles (L4) and "opens the popup with $name" (L4).
*@

@code {
    [Fact(DisplayName = "sets the disabled state")]
    [Trait("Requirement", "SEL-API-13")]
    [Trait("Requirement", "SEL-DOM-03")]
    [Trait("Requirement", "SEL-DOM-07")]
    public async Task Sets_the_disabled_state()
    {
        int openChanges = 0;
        bool disabled = true;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" DefaultValue="@("b")" OnOpenChange="_ => openChanges++" Disabled="disabled">
            <SelectTrigger>
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        IElement trigger = Trigger(cut);
        Assert.True(trigger.HasAttribute("disabled"));
        Assert.True(trigger.HasAttribute("data-disabled"));

        // The Tab press that skips the trigger is the browser's: a native `disabled` button is out of the tab order (L4).
        // The click that must not open the popup is the interactions module's report, which a disabled trigger's handle
        // is never given a press to make.
        Assert.DoesNotContain("\"click\":", TriggerInteractionOptions(cut), StringComparison.Ordinal);
        Assert.Equal(0, openChanges);

        // List navigation and the typeahead are the composite module's and are turned off with the root.
        Assert.Contains("\"enabled\":false", ReferenceListOptions(), StringComparison.Ordinal);
        Assert.DoesNotContain("\"typeahead\":", ReferenceListOptions(), StringComparison.Ordinal);

        // The positive control of the absences above: enabled, the same handles carry the press, the navigation and the typeahead.
        disabled = false;
        await RefreshAsync(cut);
        Assert.Contains("\"click\":", TriggerInteractionOptions(cut), StringComparison.Ordinal);
        Assert.DoesNotContain("\"enabled\":false", ReferenceListOptions(), StringComparison.Ordinal);
        Assert.Contains("\"typeahead\":", ReferenceListOptions(), StringComparison.Ordinal);
    }

    [Fact(DisplayName = "updates the disabled state when the disabled prop changes")]
    [Trait("Requirement", "SEL-API-13")]
    public async Task Updates_the_disabled_state_when_the_disabled_prop_changes()
    {
        int openChanges = 0;
        bool disabled = true;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" DefaultValue="@("b")" OnOpenChange="_ => openChanges++" Disabled="disabled">
            <SelectTrigger>
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        IElement trigger = Trigger(cut);
        Assert.True(trigger.HasAttribute("disabled"));
        Assert.True(trigger.HasAttribute("data-disabled"));
        Assert.DoesNotContain("\"click\":", TriggerInteractionOptions(cut), StringComparison.Ordinal);
        Assert.Equal(0, openChanges);

        // Base UI's toggle button sets the state the tree reads.
        disabled = !disabled;
        await RefreshAsync(cut);

        trigger = Trigger(cut);
        Assert.False(trigger.HasAttribute("disabled"));
        Assert.False(trigger.HasAttribute("data-disabled"));

        // The Tab press that focuses the trigger is the browser's (L4); the press that opens it is the module's report,
        // which the enabled trigger's handle makes.
        Assert.Contains("\"click\":", TriggerInteractionOptions(cut), StringComparison.Ordinal);
        await PressAsync(cut);
        Assert.Equal(1, openChanges);
    }

    [Fact(DisplayName = "sets the readOnly state")]
    [Trait("Requirement", "SEL-API-12")]
    [Trait("Requirement", "SEL-ARIA-06")]
    [Trait("Requirement", "SEL-DOM-03")]
    public void Sets_the_readOnly_state()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" DefaultValue="@("b")" ReadOnly="true">
            <SelectTrigger>
                <SelectValue />
            </SelectTrigger>
        </SelectRoot>);

        // The trigger stays in the tab order (the Tab press is L4): nothing but the value is locked.
        IElement trigger = Trigger(cut);
        Assert.Equal("true", trigger.GetAttribute("aria-readonly"));
        Assert.True(trigger.HasAttribute("data-readonly"));
        Assert.Equal("0", trigger.GetAttribute("tabindex"));
        Assert.False(trigger.HasAttribute("disabled"));
    }

    [Fact(DisplayName = "opens the popup when clicked")]
    [Trait("Requirement", "SEL-API-12")]
    [Trait("Requirement", "SEL-DOM-23")]
    public async Task Opens_the_popup_when_clicked()
    {
        int openChanges = 0;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" OnOpenChange="_ => openChanges++" ReadOnly="true">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);

        IElement listbox = cut.Find("[role=\"listbox\"]");
        Assert.Equal("true", listbox.GetAttribute("aria-readonly"));
        Assert.Equal(1, openChanges);
    }

    [Fact(DisplayName = "marks the listbox as readonly when rendered with Select.List")]
    [Trait("Requirement", "SEL-API-12")]
    [Trait("Requirement", "SEL-DOM-31")]
    public async Task Marks_the_listbox_as_readonly_when_rendered_with_Select_List()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" ReadOnly="true">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectList>
                            <SelectItem Value="@("a")">a</SelectItem>
                        </SelectList>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);

        // The listbox role moves to the list, and with it `aria-readonly`.
        IElement listbox = cut.Find("[role=\"listbox\"]");
