    }

    [Fact(DisplayName = "does not commit a value when an item is clicked in a popup the user opened")]
    [Trait("Requirement", "SEL-API-12")]
    public async Task Does_not_commit_a_value_when_an_item_is_clicked_in_a_popup_the_user_opened()
    {
        int valueChanges = 0;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" OnValueChange="_ => valueChanges++" ReadOnly="true">
            <SelectTrigger data-testid="trigger">
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);

        await ClickOptionAsync(cut, "b");

        Assert.Equal(0, valueChanges);
        Assert.False(OptionNamed(cut, "b").HasAttribute("data-selected"));
        Assert.Equal(string.Empty, cut.Find("[data-testid=\"value\"]").TextContent);
    }

    [Fact(DisplayName = "does not commit a value with Enter on a highlighted item")]
    [Trait("Requirement", "SEL-API-12")]
    public async Task Does_not_commit_a_value_with_Enter_on_a_highlighted_item()
    {
        int valueChanges = 0;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" OnValueChange="_ => valueChanges++" ReadOnly="true">
            <SelectTrigger data-testid="trigger">
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")" ClassValue="Mirror">a</SelectItem>
                        <SelectItem Value="@("b")" ClassValue="Mirror">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // ArrowDown on the focused trigger opens the popup and highlights the first item (the composite module's, L4); the
        // popup open and the highlight reported:
        await OpenAsync(cut);
        await HighlightAsync(cut, 0);

        // `data-highlighted` is the composite module's write; C# renders the highlight it reports as the item's state.
        Assert.Contains(HighlightedClass, OptionNamed(cut, "a").ClassList);

        // Enter on the highlighted item is the button mechanism's click on it, which the select module classifies and
        // reports as a virtual activation (the keyboard path itself is L4).
        await ClickOptionAsync(cut, OptionNamed(cut, "a"), pointerType: string.Empty);

        Assert.Equal(0, valueChanges);
        Assert.Equal(string.Empty, cut.Find("[data-testid=\"value\"]").TextContent);
        Assert.False(OptionNamed(cut, "a").HasAttribute("data-selected"));
    }

    [Fact(DisplayName = "does not commit a value with typeahead on a closed trigger")]
    [Trait("Requirement", "SEL-API-12")]
    public async Task Does_not_commit_a_value_with_typeahead_on_a_closed_trigger()
    {
        int valueChanges = 0;
        bool readOnly = true;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" OnValueChange="_ => valueChanges++" ReadOnly="readOnly">
            <SelectTrigger data-testid="trigger">
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("apple")">apple</SelectItem>
                        <SelectItem Value="@("banana")">banana</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await cut.Find("[data-testid=\"trigger\"]").FocusAsync(new FocusEventArgs());

        // The key 'b' is the composite module's typeahead on the trigger's handle; a read-only select leaves that
        // typeahead off, so the module reports no match and nothing is committed (the key press itself is L4).
        Assert.NotNull(ReferenceListOptions());
        Assert.DoesNotContain("\"typeahead\":", ReferenceListOptions(), StringComparison.Ordinal);
        Assert.Equal(0, valueChanges);
        Assert.Equal(string.Empty, cut.Find("[data-testid=\"value\"]").TextContent);

        // The positive control of that absence: the same trigger of a select that is not read-only carries the typeahead.
        readOnly = false;
        await RefreshAsync(cut);
        Assert.Contains("\"typeahead\":", ReferenceListOptions(), StringComparison.Ordinal);
    }

    [Fact(DisplayName = "moves the highlight with typeahead while the popup is open")]
    [Trait("Requirement", "SEL-API-12")]
    public async Task Moves_the_highlight_with_typeahead_while_the_popup_is_open()
    {
        int valueChanges = 0;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" DefaultOpen="true" OnValueChange="_ => valueChanges++" ReadOnly="true">
            <SelectTrigger data-testid="trigger">
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("apple")" ClassValue="Mirror">apple</SelectItem>
                        <SelectItem Value="@("banana")" ClassValue="Mirror">banana</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await PublishOrderAsync(cut);

        // The typeahead on the open popup is the composite module's and stays on while the select is read-only (SEL-API-12:
        // the popup can be browsed); the key 'b' and the highlight it moves are L4. The module's highlight report for the
        // matched item is what C# renders: `data-highlighted` is the module's write, the item's state the mirror.
        Assert.Contains("\"typeahead\":", PopupListOptions(), StringComparison.Ordinal);
        await HighlightAsync(cut, 1);

        Assert.Contains(HighlightedClass, OptionNamed(cut, "banana").ClassList);
        Assert.DoesNotContain(HighlightedClass, OptionNamed(cut, "apple").ClassList);
        Assert.Equal(0, valueChanges);
        Assert.Equal(string.Empty, cut.Find("[data-testid=\"value\"]").TextContent);
    }

