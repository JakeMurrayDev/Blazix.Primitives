    // The popover is the enclosing floating node of the select, so its outside-press tree and the scroll lock's absence are the
    // modules' (L4); what C# decides: a non-modal select renders no internal backdrop, hands its session to the popover's as
    // the parent, and choosing an item closes the select alone.
    [Fact(DisplayName = "keeps a modal popover open when choosing a non-modal aligned select item")]
    [Trait("Requirement", "SEL-API-16")]
    public async Task Keeps_a_modal_popover_open_when_choosing_a_non_modal_aligned_select_item()
    {
        int popoverOpenChanges = 0;
        string? selected = null;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<PopoverRoot TPayload="int" DefaultOpen="true" Modal="true" OnOpenChange="_ => popoverOpenChanges++">
            <PopoverTrigger TPayload="int">Open popover</PopoverTrigger>
            <PopoverPortal>
                <PopoverPositioner>
                    <PopoverPopup data-testid="popover-popup">
                        <SelectRoot TValue="string" Modal="false" OnValueChange="e => selected = e.Value">
                            <SelectTrigger data-testid="select-trigger">
                                <SelectValue>
                                    <Placeholder>Pick one</Placeholder>
                                </SelectValue>
                            </SelectTrigger>
                            <SelectPortal>
                                <SelectPositioner AlignItemWithTrigger="true">
                                    <SelectPopup>
                                        <SelectItem Value="@("one")">One</SelectItem>
                                        <SelectItem Value="@("two")">Two</SelectItem>
                                    </SelectPopup>
                                </SelectPositioner>
                            </SelectPortal>
                        </SelectRoot>
                    </PopoverPopup>
                </PopoverPositioner>
            </PopoverPortal>
        </PopoverRoot>);

        await OpenAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));

        // The select's session joins the popover's tree as its child (the module decides the outside press with it, L4).
        string selectId = cut.Find("[data-testid=\"select-trigger\"]").Id!;
        Assert.Contains("\"parentToken\":", SessionOptions(selectId), StringComparison.Ordinal);

        await ClickOptionAsync(cut, "Two");
        await CompleteTransitionAsync<string>(cut);

        Assert.Equal("two", selected);
        Assert.Empty(cut.FindAll("[role=\"listbox\"]"));
        Assert.NotEmpty(cut.FindAll("[data-testid=\"popover-popup\"]"));
        Assert.Equal(0, popoverOpenChanges);
    }

    // The latest options of the trigger's `interactions` handle: its attach's, or its latest update's.
    private string TriggerInteractionOptions(IRenderedComponent<SelectHost> cut)
    {
        string triggerId = Trigger(cut).Id!;
        string marker = "\"triggerId\":\"" + triggerId + "\"";
        string options = (string)Interactions.Invocations["attach"].Last(i => i.Arguments[1] is string json && json.Contains(marker, StringComparison.Ordinal)).Arguments[1]!;
        foreach (JSRuntimeInvocation update in InteractionsHandle.Invocations["update"])
        {
            if (update.Arguments[0] is string json && json.Contains(marker, StringComparison.Ordinal))
            {
                options = json;
            }
        }

        return options;
    }

    // The options of the `interactions` session attach of the root whose popup id is `floatingId`.
    private string SessionOptions(string floatingId) =>
        (string)Interactions.Invocations["attach"].Last(i => i.Arguments[1] is string json && json.Contains("\"floatingId\":\"" + floatingId + "\"", StringComparison.Ordinal)).Arguments[1]!;

    // The latest options of the composite handle on the trigger (its reference role) or on the popup (its floating role).
    private string? ReferenceListOptions() => LastCompositeOptions("\"reference\":");

    private string? PopupListOptions() => LastCompositeOptions("\"floating\":");

    private string? LastCompositeOptions(string marker)
    {
        string? options = Composite.Invocations["attach"].Select(i => i.Arguments[1] as string).LastOrDefault(json => json is not null && json.Contains(marker, StringComparison.Ordinal));
        foreach (JSRuntimeInvocation update in CompositeHandle.Invocations["update"])
        {
            if (update.Arguments[0] is string json && json.Contains(marker, StringComparison.Ordinal))
            {
                options = json;
            }
        }

        return options;
    }

    private const string HighlightedClass = "mirrors-highlight";

    private static string? Mirror(SelectItemState state) => state.Highlighted ? HighlightedClass : null;

    private static IElement OptionNamed(IRenderedComponent<SelectHost> cut, string text) =>
        cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == text);

    private static IElement HiddenInput(IRenderedComponent<SelectHost> cut) => cut.Find("input[aria-hidden=\"true\"]");
}
