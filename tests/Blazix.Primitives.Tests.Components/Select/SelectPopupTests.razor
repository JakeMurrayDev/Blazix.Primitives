@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using AngleSharp.Dom
@using Bunit
@using Microsoft.JSInterop
@*
    L2: SelectPopup.test.tsx's titles bUnit observes (M5 track 9). The aligned geometry, the scroll resizing and the focus
    props (popupFocusPropsTests, SEL-API-39) are the `select` and `focus-manager` modules' with real layout and focus (L4:
    tests/browser/select.spec.ts); the popup's ARIA, its listbox role and the options it sends to the `popup` module are C#.
*@

@code {
    private const string PopupPath = "./_content/Blazix.Primitives/js/popup.js";

    private BunitJSModuleInterop SetUpPopupModule()
    {
        BunitJSModuleInterop popup = JSInterop.SetupModule(PopupPath);
        BunitJSModuleInterop handle = popup.SetupModule("attach", _ => true);
        handle.SetupVoid("update", _ => true).SetVoidResult();
        handle.SetupVoid("dispose", _ => true).SetVoidResult();
        return popup;
    }

    [Fact(DisplayName = "throws a descriptive error when rendered outside <Select.Positioner>")]
    [Trait("Requirement", "SEL-STR-03")]
    [Trait("Requirement", "SEL-EDGE-01")]
    public void Throws_a_descriptive_error_when_rendered_outside_a_positioner()
    {
        InvalidOperationException error = Assert.Throws<InvalidOperationException>(() => RenderSelect(@<SelectRoot TValue="string" Open="true">
            <SelectPopup />
        </SelectRoot>));

        Assert.Equal("Blazix: `SelectPositionerContext` is missing. SelectPositioner parts must be placed within `<SelectPositioner>`.", error.Message);
    }

    // The trigger is a Toolbar.Button's substitute and the popup is rendered inline, inside the toolbar's subtree. Opening
    // with Enter focusing the selected item, the roving focus not moving on ArrowRight and the toolbar's keydown not firing
    // are the composite and `popup` modules' (L4); C# keeps the trigger's role and asks the `popup` module to stop the keys.
    [Fact(DisplayName = "keeps arrow keys inside the popup when the trigger lives in a toolbar")]
    [Trait("Requirement", "SEL-ARIA-01")]
    [Trait("Requirement", "SEL-EDGE-12")]
    [Trait("Requirement", "SEL-KEY-14")]
    public async Task Keeps_arrow_keys_inside_the_popup_when_the_trigger_lives_in_a_toolbar()
    {
        BunitJSModuleInterop popup = SetUpPopupModule();
        IRenderedComponent<SelectHost> cut = RenderSelect(@<ToolbarRoot>
            <SelectRoot TValue="string" DefaultValue="@("a")">
                <ToolbarButton>
                    <Render><SelectTrigger data-testid="trigger" /></Render>
                    <ChildContent><SelectValue /></ChildContent>
                </ToolbarButton>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectRoot>
            <ToolbarButton data-testid="next">Next</ToolbarButton>
        </ToolbarRoot>);

        IElement trigger = cut.Find("[data-testid=\"trigger\"]");
        Assert.Equal("combobox", trigger.GetAttribute("role"));
        Assert.Equal("a", trigger.TextContent);

        await OpenAsync(cut);

        Assert.Equal("listbox", cut.Find("[role=\"listbox\"]").GetAttribute("role"));
        Assert.Equal("combobox", cut.Find("[data-testid=\"trigger\"]").GetAttribute("role"));
        string options = (string)popup.Invocations["attach"].Last(attach => attach.Arguments[1] is string json && json.Contains("\"popup\":", StringComparison.Ordinal)).Arguments[1]!;
        Assert.Contains("\"popup\":{\"stopCompositeKeys\":true}", options, StringComparison.Ordinal);
    }

    [Fact(DisplayName = "has aria attributes when no Select.List is present")]
    [Trait("Requirement", "SEL-ARIA-02")]
    [Trait("Requirement", "SEL-ARIA-04")]
    [Trait("Requirement", "SEL-ARIA-08")]
    [Trait("Requirement", "SEL-DOM-23")]
    [Trait("Requirement", "SEL-STR-08")]
    public async Task Has_aria_attributes_when_no_list_is_present()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true">
            <SelectTrigger>Trigger</SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup data-testid="popup">Popup</SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        IElement trigger = Trigger(cut);

        Assert.False(trigger.HasAttribute("aria-controls"));
        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));

        await OpenAsync(cut);

        IElement popup = cut.Find("[data-testid=\"popup\"]");
        IElement listbox = cut.Find("[role=\"listbox\"]");
        trigger = Trigger(cut);

        Assert.Equal(listbox.Id, popup.Id);
        Assert.False(string.IsNullOrEmpty(popup.Id));
        Assert.Equal("true", popup.GetAttribute("aria-multiselectable"));
        Assert.Equal(popup.Id, trigger.GetAttribute("aria-controls"));
        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.Equal("listbox", trigger.GetAttribute("aria-haspopup"));
    }

    [Fact(DisplayName = "places aria attributes on Select.List instead if it is present")]
    [Trait("Requirement", "SEL-ARIA-03")]
    [Trait("Requirement", "SEL-ARIA-04")]
    [Trait("Requirement", "SEL-DOM-24")]
    [Trait("Requirement", "SEL-DOM-31")]
    [Trait("Requirement", "SEL-DOM-34")]
    [Trait("Requirement", "SEL-STR-08")]
    public async Task Places_aria_attributes_on_the_list_instead_if_it_is_present()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true">
            <SelectTrigger>Trigger</SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup data-testid="popup">
                        <SelectList data-testid="list">
                            <SelectItem Value="@("1")">Item 1</SelectItem>
                            <SelectItem Value="@("2")">Item 2</SelectItem>
                        </SelectList>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        IElement trigger = Trigger(cut);

        Assert.False(trigger.HasAttribute("aria-controls"));
        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.Equal("listbox", trigger.GetAttribute("aria-haspopup"));

        await OpenAsync(cut);

        IElement popup = cut.Find("[data-testid=\"popup\"]");
        IElement list = cut.Find("[data-testid=\"list\"]");
        IElement listbox = cut.Find("[role=\"listbox\"]");
        trigger = Trigger(cut);

        Assert.Equal(listbox.Id, list.Id);
        Assert.True(list.HasAttribute("aria-multiselectable"));
        Assert.Equal("presentation", popup.GetAttribute("role"));
        Assert.False(popup.HasAttribute("aria-multiselectable"));
        Assert.False(string.IsNullOrEmpty(list.Id));
        Assert.Equal(list.Id, trigger.GetAttribute("aria-controls"));
        Assert.NotEqual(popup.Id, trigger.GetAttribute("aria-controls"));
        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.Equal("listbox", trigger.GetAttribute("aria-haspopup"));
    }
}
