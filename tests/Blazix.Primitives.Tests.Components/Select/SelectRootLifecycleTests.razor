    [Fact(DisplayName = "unmounts the select when the `unmount` method is called")]
    [Trait("Requirement", "SEL-API-17")]
    public async Task Unmounts_the_select_when_the_unmount_method_is_called()
    {
        cut = RenderSelect(@<SelectRoot TValue="string" OnOpenChange="args => ((OpenChangeEventDetails)args.Details).PreventUnmountOnClose()">
            <SelectTrigger data-testid="trigger">Open</SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem>1</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);
        Assert.NotEmpty(Listbox());

        await PressAsync(cut, open: false);
        await CompleteTransitionAsync<string>(cut);
        Assert.NotEmpty(Listbox());

        await cut.InvokeAsync(RootOf().Unmount);
        Assert.Empty(Listbox());
    }

    // Blazor has no Strict Mode (ADR 06 Amendments 2026-10-18 rule 2): the title's two runs are one run here. The arrows'
    // `data-visible` and the list's scroll listener are the `select` module's (L3, L4); the module's report is simulated.
    [Fact(DisplayName = "clears scroll arrow visibility when manually unmounted (strict: %s)")]
    [Trait("Requirement", "SEL-ANI-07")]
    public async Task Clears_scroll_arrow_visibility_when_manually_unmounted()
    {
        cut = RenderSelect(@<SelectRoot TValue="string" OnOpenChange="PreventUnmount">
            <SelectTrigger>Open</SelectTrigger>
            <SelectPortal>
                <SelectPositioner AlignItemWithTrigger="false">
                    <SelectPopup>
                        <SelectScrollUpArrow KeepMounted="true" />
                        <SelectList>
                            <SelectItem Value="@("one")">One</SelectItem>
                            <SelectItem Value="@("two")">Two</SelectItem>
                        </SelectList>
                        <SelectScrollDownArrow KeepMounted="true" />
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);
        SelectTwin twin = SelectTwinOf("\"part\":\"positioner\"")!;
        await cut.InvokeAsync(() => twin.OnArrowsChange("""{"up":true,"down":true}"""));
        Assert.True(StoreOf<string>(cut).State.ScrollUpArrowVisible);
        Assert.True(StoreOf<string>(cut).State.ScrollDownArrowVisible);

        // Only the unmount cleanup resets the visibility (SEL-ANI-07), not the close.
        await PressAsync(cut, open: false);
        await CompleteTransitionAsync<string>(cut);
        Assert.NotEmpty(Listbox());
        Assert.True(StoreOf<string>(cut).State.ScrollUpArrowVisible);
        Assert.True(StoreOf<string>(cut).State.ScrollDownArrowVisible);

        await cut.InvokeAsync(RootOf().Unmount);

        Assert.Empty(Listbox());
        Assert.False(StoreOf<string>(cut).State.ScrollUpArrowVisible);
        Assert.False(StoreOf<string>(cut).State.ScrollDownArrowVisible);
    }

    // The Tab press, the real focus and the module-written `tabindex="0"` of the focused option are L4; C# renders the
    // options with `tabindex="-1"` and the popup open or closed.
    [Fact(DisplayName = "does not leave a tabbable option while closed and kept mounted after tabbing out")]
    [Trait("Requirement", "SEL-DOM-36")]
    public async Task Does_not_leave_a_tabbable_option_while_closed_and_kept_mounted_after_tabbing_out()
    {
        cut = RenderSelect(@<div>
            <input />
            <SelectRoot TValue="string" DefaultValue="@("1")" Modal="false" OnOpenChange="PreventUnmount">
                <SelectTrigger>Open</SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("1")">1</SelectItem>
                            <SelectItem Value="@("2")">2</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
            <input data-testid="after" />
        </div>);

        await OpenAsync(cut);
        Assert.True(cut.Find("[role=\"listbox\"]").HasAttribute("data-open"));
        Assert.Equal("-1", cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == "1").GetAttribute("tabindex"));

        // Tabbing out of the popup is a focus-out dismissal; the opt-out keeps the closed popup mounted.
        await SessionRequestAsync(cut, open: false, "focus-out");
        await CompleteTransitionAsync<string>(cut);

        IElement listbox = cut.Find("[role=\"listbox\"]");
        Assert.False(listbox.HasAttribute("data-open"));
        Assert.Equal("-1", cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == "1").GetAttribute("tabindex"));
    }
