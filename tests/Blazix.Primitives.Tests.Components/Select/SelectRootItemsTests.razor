    [Fact(DisplayName = "passes item as the first comparator argument in multiple mode")]
    [Trait("Requirement", "SEL-API-22")]
    [Trait("Requirement", "SEL-EVT-05")]
    [Trait("Requirement", "SEL-EVT-15")]
    public async Task Passes_item_as_the_first_comparator_argument_in_multiple_mode()
    {
        Account[] users = [new(1, "Alice", "item"), new(2, "Bob", "item")];
        Account[] defaults = [new(2, "Bob", "selected")];
        List<(Account? Item, Account? Selected)> calls = [];
        List<ValueChangeEventArgs<IReadOnlyList<Account>>> changes = [];
        bool Equal(Account item, Account selected)
        {
            calls.Add((item, selected));
            return item.Id == selected.Id && item.Source == "item" && selected.Source == "selected";
        }

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Account" Multiple="true" DefaultOpen="true" DefaultValues="defaults" ItemToStringLabel="item => item.Name" ItemToStringValue="item => item.Id.ToString()" IsItemEqualToValue="Equal" OnValuesChange="changes.Add">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Account user in users)
                        {
                            <SelectItem @key="user.Id" Value="@user">@user.Name</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.True(IsSelected(cut, "Bob"));
        Assert.False(IsSelected(cut, "Alice"));

        await ClickOptionAsync(cut, "Bob");

        // The click removed the selected value, which only matches with the item first (SEL-EVT-05).
        Assert.Single(changes);
        Assert.Empty(changes[0].Value);
        Assert.Equal(EventReason.ItemPress, changes[0].Details.Reason);
        Assert.False(IsSelected(cut, "Bob"));

        // SEL-EVT-15, SEL-API-22: in every call the item came first, a selected value second, and neither was null.
        Assert.NotEmpty(calls);
        Assert.All(calls, call =>
        {
            Assert.NotNull(call.Item);
            Assert.NotNull(call.Selected);
            Assert.Equal("item", call.Item!.Source);
            Assert.Equal("selected", call.Selected!.Source);
        });
    }

    [Fact(DisplayName = "does not carry an ArrowUp opening over to a later pointer opening")]
    [Trait("Requirement", "SEL-DOM-25")]
    public async Task Does_not_carry_an_arrow_up_opening_over_to_a_later_pointer_opening()
    {
        // A selected item claims the keyboard opening, so the ArrowUp is never consumed.
        string value = "b";
        IRenderedComponent<SelectHost> cut = RenderSelect(@<div>
            <SelectRoot TValue="string" Value="@value" OnValueChange="e => value = e.Value">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner AlignItemWithTrigger="false">
                        <SelectPopup>
                            <SelectItem Value="@("a")">a</SelectItem>
                            <SelectItem Value="@("b")">b</SelectItem>
                            <SelectItem Value="@("c")">c</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </div>);
        SelectStore<string> store = StoreOf<string>(cut);

        // The ArrowUp is the composite module's request to open (CMP-EVT-06, reason list-navigation); the list opens on
        // the selected item. The key it records for the opening is the module's own (L4); C# records no open method for it.
        await FocusTriggerAsync(cut);
        await OpenWithKeyAsync(cut, "ArrowUp");
        Assert.Equal("true", Trigger(cut).GetAttribute("aria-expanded"));
        Assert.Equal(1, SentSelectedIndex());

        // Escape: the popup closes and its exit completes; the recorded open method goes with it (SEL-STA-08).
        await SessionRequestAsync(cut, false, "escape-key", Key("Escape"));
        await CompleteTransitionAsync<string>(cut);
        Assert.Equal("false", Trigger(cut).GetAttribute("aria-expanded"));
        Assert.Null(store.State.Lifecycle.OpenMethod);

        // "Clear", then a pointer opening.
        value = null!;
        await RefreshAsync(cut);
        await ClickTriggerAsync(cut);

        // The popup is the focus element of the opening (SEL-DOM-25; the focus itself and the highlight are L4): the
        // listbox is focusable, nothing is selected to claim the opening, and the open method is the pointer's.
        IElement listbox = cut.Find("[role=\"listbox\"]");
        Assert.Equal("-1", listbox.GetAttribute("tabindex"));
        Assert.True(listbox.HasAttribute("data-base-ui-focusable"));
        Assert.Null(SentSelectedIndex());
        Assert.Equal(InteractionType.Mouse, store.State.Lifecycle.OpenMethod);
        Assert.Null(store.List!.HighlightedIndex);
        Assert.DoesNotContain(cut.FindAll("[role=\"option\"]"), option => option.HasAttribute("data-highlighted"));
    }

    // docs/components/select.md §14: a render-count optimization, non-normative, so no requirement row. The trigger's class
    // function runs once per render of the part; the highlight is the composite module's report.
    [Fact(DisplayName = "does not re-render the trigger while navigating the list")]
    public async Task Does_not_re_render_the_trigger_while_navigating_the_list()
    {
        int triggerRenders = 0;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string">
            <SelectTrigger ClassValue="@(state => { triggerRenders++; return null; })">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (int index in Enumerable.Range(0, 10))
                        {
                            <SelectItem @key="index" Value="@(index.ToString())">@($"Item {index}")</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));
        Assert.Equal(10, cut.FindAll("[role=\"option\"]").Count);

        // The count works: the opening itself rendered the trigger.
        Assert.True(triggerRenders > 0);
        IRenderedComponent<SelectTrigger<string>> trigger = cut.FindComponent<SelectTrigger<string>>();
        IReadOnlyList<IRenderedComponent<SelectItem<string>>> items = cut.FindComponents<SelectItem<string>>();
        int rendersBefore = trigger.RenderCount;
        int[] itemRendersBefore = [.. items.Select(item => item.RenderCount)];
        triggerRenders = 0;

        // ArrowDown three times: the module reports each move of the highlight.
        await HighlightAsync(cut, 0);
        await HighlightAsync(cut, 1);
        await HighlightAsync(cut, 2);

        // The reports reached the root's mirror, and the shared list navigation did not rebuild the trigger's props.
        Assert.Equal(2, StoreOf<string>(cut).List!.HighlightedIndex);
        Assert.Equal(0, triggerRenders);
        Assert.Equal(rendersBefore, trigger.RenderCount);

        // Only the items the highlight touched rendered again (items 0 to 2); the other seven did not.
        int[] itemRendersAfter = [.. items.Select(item => item.RenderCount)];
        Assert.All(Enumerable.Range(0, 3), index => Assert.True(itemRendersAfter[index] > itemRendersBefore[index]));
        Assert.All(Enumerable.Range(3, 7), index => Assert.Equal(itemRendersBefore[index], itemRendersAfter[index]));
    }
}
