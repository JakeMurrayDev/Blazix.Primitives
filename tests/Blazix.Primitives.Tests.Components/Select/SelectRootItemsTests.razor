        string value = "c";
        List<ValueChangeEventArgs<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@value" OnValueChange="e => { value = e.Value; changes.Add(e); }">
