                        {
                            <SelectItem @key="item" Value="@item">@item</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        Assert.Equal(["a", "b", "c"], cut.FindAll("[role=\"option\"]").Select(option => option.TextContent.Trim()));

