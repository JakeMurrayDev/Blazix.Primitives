@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using System.Text.Json
@using AngleSharp.Dom
@using Bunit
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Time.Testing
@using Microsoft.JSInterop
@*
    L2: SelectRoot.test.tsx's titles from "dynamic items" to the end that bUnit observes (M5 track 9): the item registry
    and its reconciliation (the composite module's order report is PublishOrderAsync), the closed-trigger typeahead's
    C# half, isItemEqualToValue, the opening method and the trigger's render count. Typeahead matching, keys, focus,
    hover highlighting, geometry and the animated exit are the modules' (tests/browser/select.spec.ts).
*@

@code {
    // `user.click(trigger)` focuses the trigger first, whose onfocus force-mounts the list 0 ms later (SEL-STA-09); the
    // timer runs under this clock, which FocusTriggerAsync advances.
    private readonly FakeTimeProvider clock = new();

    public SelectRootItemsTests()
    {
        Services.AddSingleton<TimeProvider>(clock);
    }

    private sealed record User(int Id, string Name);

    private sealed record Account(int Id, string Name, string Source);

    private async Task FocusTriggerAsync(IRenderedComponent<SelectHost> cut)
    {
        await cut.InvokeAsync(() => Trigger(cut).Focus());
        clock.Advance(TimeSpan.FromMilliseconds(1));
        await cut.InvokeAsync(() => { });
    }

    // A user's click: the pointer focuses the trigger, then presses it.
    private async Task ClickTriggerAsync(IRenderedComponent<SelectHost> cut)
    {
        await FocusTriggerAsync(cut);
        await OpenAsync(cut);
    }

    // ArrowDown or ArrowUp on the focused closed trigger: the composite module's request to open the list (CMP-EVT-06).
    private async Task OpenWithKeyAsync(IRenderedComponent<SelectHost> cut, string key)
    {
        string request = $$"""{"open":true,"reason":"list-navigation","event":{{Key(key)}},"triggerId":"{{Trigger(cut).Id}}"}""";
        await cut.InvokeAsync(() => CompositeTwinOf("\"reference\":")!.OnListOpenRequest(request));
        await PublishOrderAsync(cut);
    }

    private static IElement Option(IRenderedComponent<SelectHost> cut, string text) =>
        cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == text);

    private static bool IsSelected(IRenderedComponent<SelectHost> cut, string text) => Option(cut, text).HasAttribute("data-selected");

    // The latest options the composite module received on a handle whose attach carries the marker: its attach's, or its
    // latest update's (the same record goes to every handle of the list, so the trigger's reference handle stands for it).
    private string? LastComposite(string marker)
    {
        string? options = Composite.Invocations["attach"].Select(invocation => invocation.Arguments[1] as string).LastOrDefault(json => json is not null && json.Contains(marker, StringComparison.Ordinal));
        foreach (JSRuntimeInvocation update in CompositeHandle.Invocations["update"])
        {
            if (update.Arguments[0] is string json && json.Contains(marker, StringComparison.Ordinal))
            {
                options = json;
            }
        }

        return options;
    }

    // The selected index (the anchor the module opens on) C# last sent to the list's handles.
    private int? SentSelectedIndex()
    {
        using JsonDocument document = JsonDocument.Parse(LastComposite("\"reference\":")!);
        return document.RootElement.TryGetProperty("list", out JsonElement list) && list.TryGetProperty("selectedIndex", out JsonElement index) ? index.GetInt32() : null;
    }

    [Fact(DisplayName = "unselects the selected item if removed")]
    [Trait("Requirement", "SEL-STA-12")]
    public async Task Unselects_the_selected_item_if_removed()
    {
        string[] items = ["a", "b", "c"];
        string selectedItem = "a";
        List<ValueChangeEventArgs<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<div>
            <div data-testid="value">@selectedItem</div>
            <SelectRoot TValue="string" Value="@selectedItem" OnValueChange="e => { selectedItem = e.Value; changes.Add(e); }">
                <SelectTrigger>Toggle</SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            @foreach (string item in items)
                            {
                                <SelectItem @key="item" Value="@item">@item</SelectItem>
                            }
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </div>);

        // The key is the module's (L4); the popup opens as its request reports.
        await FocusTriggerAsync(cut);
        await OpenWithKeyAsync(cut, "ArrowDown");

        Assert.True(IsSelected(cut, "a"));
        Assert.Equal("a", cut.Find("[data-testid=\"value\"]").TextContent);

        // "Remove": the item leaves the list; the registry publishes the new order.
        items = ["b", "c"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        // The reconciliation reset the controlled value through onValueChange, and no remaining option is selected.
        Assert.Single(changes);
        Assert.Null(changes[0].Value);
        await RefreshAsync(cut);
        Assert.Equal("", cut.Find("[data-testid=\"value\"]").TextContent);
        Assert.False(IsSelected(cut, "b"));

        // "Add": the removed item returns, and it is not selected because the value was reset.
        items = ["a", "b", "c"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        Assert.Equal(3, cut.FindAll("[role=\"option\"]").Count);
        Assert.False(IsSelected(cut, "a"));
        Assert.Single(changes);
    }

    [Fact(DisplayName = "resets the value when the selected item is replaced and the item count is unchanged")]
    [Trait("Requirement", "SEL-STA-12")]
    [Trait("Requirement", "SEL-EVT-02")]
    public async Task Resets_the_value_when_the_selected_item_is_replaced_and_the_item_count_is_unchanged()
    {
        string[] items = ["a", "b", "c"];
        string value = "c";
        List<ValueChangeEventArgs<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@value" OnValueChange="e => { value = e.Value; changes.Add(e); }">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (string item in items)
                        {
                            <SelectItem @key="item" Value="@item">@item</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Contains("c", cut.Find("[data-testid=\"trigger\"]").TextContent, StringComparison.Ordinal);

        // The items only register once the popup has mounted.
        await ClickTriggerAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));
        Assert.Empty(changes);

        // Replace "c" with "d" while the popup is open, keeping the count at three.
        items = ["a", "b", "d"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        // The reconciliation asks for null with the reason `none` (SEL-EVT-02), and the controlled consumer applies it.
        Assert.Single(changes);
        Assert.Null(changes[^1].Value);
        Assert.Equal(EventReason.None, changes[^1].Details.Reason);
        await RefreshAsync(cut);
        Assert.DoesNotContain("c", cut.Find("[data-testid=\"trigger\"]").TextContent, StringComparison.Ordinal);
    }

