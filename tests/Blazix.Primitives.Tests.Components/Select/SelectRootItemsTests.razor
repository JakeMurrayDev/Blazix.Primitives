    [Fact(DisplayName = "commits typeahead on a closed trigger when items are provided")]
    [Trait("Requirement", "SEL-STA-09")]
    [Trait("Requirement", "SEL-STR-06")]
    public async Task Commits_typeahead_on_a_closed_trigger_when_items_are_provided()
    {
        string value = null!;
        Dictionary<string, string?> labels = new() { ["apple"] = "Apple", ["cherry"] = "Cherry" };
        List<ValueChangeEventArgs<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" ItemLabels="labels" Value="@value" OnValueChange="e => { value = e.Value; changes.Add(e); }">
            <SelectTrigger data-testid="trigger">
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("apple")">Apple</SelectItem>
                        <SelectItem Value="@("cherry")">Cherry</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // SEL-STR-06: the popup is never opened, and before the focus the list does not exist.
        Assert.Empty(cut.FindAll("[role=\"option\"]"));

        // The trigger's own onfocus force-mounts the list 0 ms later (SEL-STA-09), so the closed trigger can match items
        // even though `items` is provided; the typeahead match itself is the composite module's report (L4).
        await FocusTriggerAsync(cut);
        Assert.Equal(2, cut.FindAll("[role=\"option\"]").Count);
        Assert.DoesNotContain(cut.FindAll("[role=\"listbox\"]"), listbox => listbox.HasAttribute("data-open"));
        await PublishOrderAsync(cut);

        await MatchAsync(cut, 1, "c");

        Assert.Single(changes);
        Assert.Equal("cherry", changes[0].Value);
        Assert.Equal(EventReason.None, changes[0].Details.Reason);
        await RefreshAsync(cut);
        Assert.Equal("Cherry", cut.Find("[data-testid=\"value\"]").TextContent);
    }

    [Fact(DisplayName = "does not jump matches after a closed-state value reset")]
    [Trait("Requirement", "SEL-STA-04")]
    public async Task Does_not_jump_matches_after_a_closed_state_value_reset()
    {
        string value = "dog";
        List<ValueChangeEventArgs<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<div>
            <SelectRoot TValue="string" Value="@value" OnValueChange="e => { value = e.Value; changes.Add(e); }">
                <SelectTrigger data-testid="trigger">
                    <SelectValue data-testid="value" />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("car")">car</SelectItem>
                            <SelectItem Value="@("cat")">cat</SelectItem>
                            <SelectItem Value="@("dog")">dog</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </div>);

        Assert.Equal("dog", cut.Find("[data-testid=\"value\"]").TextContent);

        // "Set car": a controlled change while closed, before the list ever mounted.
        value = "car";
        await RefreshAsync(cut);
        Assert.Equal("car", cut.Find("[data-testid=\"value\"]").TextContent);

        await FocusTriggerAsync(cut);
        await PublishOrderAsync(cut);

        // The closed typeahead starts from the selected index (the module's search), which follows the value: "car" is
        // item 0, not the stale "dog" (2).
        Assert.Equal(0, SentSelectedIndex());

        // The first "c" lands on the next match after "car" and commits it; the later "a" keeps it (the module's search, L4).
        await MatchAsync(cut, 1, "c");
        Assert.Single(changes);
        Assert.Equal("cat", changes[0].Value);
        await RefreshAsync(cut);
        Assert.Equal("cat", cut.Find("[data-testid=\"value\"]").TextContent);
        Assert.Equal(1, SentSelectedIndex());
    }

