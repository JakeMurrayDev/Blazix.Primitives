    [Fact(DisplayName = "should serialize multiple values correctly for form submission")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-DOM-53")]
    [Trait("Requirement", "SEL-FRM-21")]
    [Trait("Requirement", "SEL-STR-01")]
    public void Should_serialize_multiple_values_correctly_for_form_submission()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Name="select" Values="@(new[] { "a", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        IReadOnlyList<IElement> hiddenInputs = cut.FindAll("[name=\"select\"]");
        Assert.Equal(2, hiddenInputs.Count);
