@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using System.Text.Json
@using AngleSharp.Dom
@using Bunit
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Time.Testing
@using Microsoft.JSInterop
@*
    L2: SelectRoot.test.tsx's "prop: multiple" titles that bUnit observes (M5 track 9). The anchor (SEL-STA-06) is the
    selected index C# sends to the list's handles; the module highlights it on opening, scrolls to it, and continues the
    arrow keys from it (tests/browser/select.spec.ts). A deselection by the keyboard is the item's activation.
*@

@code {
    // `user.click(trigger)` focuses the trigger first, whose onfocus force-mounts the list 0 ms later (SEL-STA-09); the
    // timer runs under this clock, which FocusTriggerAsync advances. `fireEvent.click(trigger)` focuses nothing.
    private readonly FakeTimeProvider clock = new();

    public SelectRootMultipleTests()
    {
        Services.AddSingleton<TimeProvider>(clock);
    }

    private async Task FocusTriggerAsync(IRenderedComponent<SelectHost> cut)
    {
        await cut.InvokeAsync(() => Trigger(cut).Focus());
        clock.Advance(TimeSpan.FromMilliseconds(1));
        await cut.InvokeAsync(() => { });
    }

    // A user's click: the pointer focuses the trigger, then presses it.
    private async Task ClickTriggerAsync(IRenderedComponent<SelectHost> cut)
    {
        await FocusTriggerAsync(cut);
        await OpenAsync(cut);
    }

    private static IElement Option(IRenderedComponent<SelectHost> cut, string text) =>
        cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == text);

    private static bool IsSelected(IRenderedComponent<SelectHost> cut, string text) => Option(cut, text).HasAttribute("data-selected");

    private static string[] Texts(IRenderedComponent<SelectHost> cut) => [.. cut.FindAll("[role=\"option\"]").Select(option => option.TextContent.Trim())];

    // The latest options the composite module received on a handle whose attach carries the marker: its attach's, or its
    // latest update's (the same record goes to every handle of the list, so the trigger's reference handle stands for it).
    private string? LastComposite(string marker)
    {
        string? options = Composite.Invocations["attach"].Select(invocation => invocation.Arguments[1] as string).LastOrDefault(json => json is not null && json.Contains(marker, StringComparison.Ordinal));
        foreach (JSRuntimeInvocation update in CompositeHandle.Invocations["update"])
        {
            if (update.Arguments[0] is string json && json.Contains(marker, StringComparison.Ordinal))
            {
                options = json;
            }
        }

        return options;
    }

    // The selected index (the anchor the module opens on) C# last sent to the list's handles.
    private int? SentSelectedIndex()
    {
        using JsonDocument document = JsonDocument.Parse(LastComposite("\"reference\":")!);
        return document.RootElement.TryGetProperty("list", out JsonElement list) && list.TryGetProperty("selectedIndex", out JsonElement index) ? index.GetInt32() : null;
    }

    // The id of the text element the positioner's `select` handle was told to align the popup with.
    private string? SentSelectedTextId()
    {
        using JsonDocument document = JsonDocument.Parse(LastSelectOptions("\"part\":\"positioner\"")!);
        return document.RootElement.TryGetProperty("selectedTextId", out JsonElement id) ? id.GetString() : null;
    }

    // ArrowDown or ArrowUp on the focused closed trigger: the composite module's request to open the list (CMP-EVT-06).
    private async Task OpenWithKeyAsync(IRenderedComponent<SelectHost> cut, string key)
    {
        string request = $$"""{"open":true,"reason":"list-navigation","event":{{Key(key)}},"triggerId":"{{Trigger(cut).Id}}"}""";
        await cut.InvokeAsync(() => CompositeTwinOf("\"reference\":")!.OnListOpenRequest(request));
        await PublishOrderAsync(cut);
    }

    [Fact(DisplayName = "removes selections that no longer exist")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-13")]
    public async Task Removes_selections_that_no_longer_exist()
    {
        string[] items = ["a", "b", "c"];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "a", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (string item in items)
                        {
                            <SelectItem @key="item" Value="@item">@item</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        Assert.True(IsSelected(cut, "a"));
        Assert.True(IsSelected(cut, "c"));
        Assert.Equal("a, c", cut.Find("[data-testid=\"trigger\"]").TextContent);

        // Remove one of the selected items; the remaining selection should persist (the click outside closed the popup).
        await CloseAsync<string>(cut);
        items = ["a", "b"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);
        await ClickTriggerAsync(cut);

        Assert.True(IsSelected(cut, "a"));
        Assert.DoesNotContain("c", Texts(cut));
        Assert.Equal("a", cut.Find("[data-testid=\"trigger\"]").TextContent);

        // Remove the last selected item; the selection should become empty.
        await CloseAsync<string>(cut);
        items = ["b"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);
        await ClickTriggerAsync(cut);

        Assert.Equal(["b"], Texts(cut));
        Assert.False(IsSelected(cut, "b"));
        Assert.Equal("", cut.Find("[data-testid=\"trigger\"]").TextContent);
    }

    [Fact(DisplayName = "removes selections replaced without changing the item count")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-13")]
    public async Task Removes_selections_replaced_without_changing_the_item_count()
    {
        string[] items = ["a", "b", "c"];
        IReadOnlyList<string> value = ["a", "c"];
        List<IReadOnlyList<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultOpen="true" Values="@value" OnValuesChange="e => { value = e.Value; changes.Add(e.Value); }">
            <SelectTrigger>
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (string item in items)
                        {
                            <SelectItem @key="item" Value="@item">@item</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // The popup is open on the first render; the module reports the items' order once they attached.
        await PublishOrderAsync(cut);
        Assert.True(IsSelected(cut, "a"));
        Assert.True(IsSelected(cut, "c"));
        Assert.Empty(changes);

        // "Replace C with D".
        items = ["a", "b", "d"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        Assert.Single(changes);
        Assert.Equal(["a"], changes[^1]);
        await RefreshAsync(cut);
        Assert.True(IsSelected(cut, "a"));
        Assert.False(IsSelected(cut, "d"));
    }

    [Fact(DisplayName = "should allow multiple selections when multiple is true")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-EVT-05")]
    public async Task Should_allow_multiple_selections_when_multiple_is_true()
    {
        IReadOnlyList<string> value = [];
        List<ValueChangeEventArgs<IReadOnlyList<string>>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Values="@value" OnValuesChange="e => { value = e.Value; changes.Add(e); }">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        await ClickOptionAsync(cut, "a");
        await RefreshAsync(cut);

        Assert.Equal(["a"], changes[0].Value);
        Assert.Equal(EventReason.ItemPress, changes[0].Details.Reason);
        Assert.True(IsSelected(cut, "a"));

        await ClickOptionAsync(cut, "b");
        await RefreshAsync(cut);

        Assert.Equal(["a", "b"], changes[1].Value);
        Assert.True(IsSelected(cut, "a"));
        Assert.True(IsSelected(cut, "b"));

        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));
    }

    [Fact(DisplayName = "keeps the selection when items are added and none of the selected ones are removed")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-13")]
    public async Task Keeps_the_selection_when_items_are_added_and_none_of_the_selected_ones_are_removed()
    {
        string[] items = ["a", "b"];
        List<ValueChangeEventArgs<IReadOnlyList<string>>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Open="true" DefaultValues="@(new[] { "a" })" OnValuesChange="changes.Add">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (string item in items)
                        {
                            <SelectItem @key="item" Value="@item">@item</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await PublishOrderAsync(cut);
        Assert.True(IsSelected(cut, "a"));

        // "Add C".
        items = ["a", "b", "c"];
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        Assert.Equal(["a", "b", "c"], Texts(cut));

        // Growing the list must not rewrite a still-valid selection.
        Assert.Empty(changes);
        Assert.True(IsSelected(cut, "a"));
    }

