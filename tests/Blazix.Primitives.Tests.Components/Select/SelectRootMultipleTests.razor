    [Fact(DisplayName = "keeps the active index on a deselected item in multiple mode")]
    [Trait("Requirement", "SEL-API-14")]
    public async Task Keeps_the_active_index_on_a_deselected_item_in_multiple_mode()
    {
        // The highlight is the module's (SEL-STA-07, SEL-PTR-14: L4); C#'s half is that activating an item in multiple
        // mode neither closes the popup nor asks the module to move or clear the highlight.
        List<ValueChangeEventArgs<IReadOnlyList<string>>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Values="@(new[] { "a" })" OnValuesChange="changes.Add">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        // The pointer moved over "b" (the module's report), then pressed it: the value request goes to the consumer, who
        // keeps `Values` as it was.
        await HighlightAsync(cut, 1);
        await ClickOptionAsync(cut, "b");
        Assert.Single(changes);
        Assert.Equal(["a", "b"], changes[0].Value);
        Assert.Equal(1, StoreOf<string>(cut).List!.HighlightedIndex);

        await ClickOptionAsync(cut, "b");
        Assert.Equal(2, changes.Count);
        Assert.Equal(1, StoreOf<string>(cut).List!.HighlightedIndex);

        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));
        Assert.DoesNotContain("\"highlight\":", LastComposite("\"reference\":")!, StringComparison.Ordinal);
    }

    [Fact(DisplayName = "highlights the first selected item in rendered order regardless of value order")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-04")]
    public async Task Highlights_the_first_selected_item_in_rendered_order_regardless_of_value_order()
    {
        // `a` renders first but sits in the middle of the value array, so neither end of that array points at it and only
        // the rendered order does. The highlight on opening is the module's (L4); C# sends the anchor it highlights.
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "b", "a", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        Assert.Equal(0, SentSelectedIndex());
        Assert.Equal("a", Texts(cut)[SentSelectedIndex()!.Value]);
    }

    [Fact(DisplayName = "re-elects the anchor when the anchor item value changes in place")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-06")]
    public async Task Re_elects_the_anchor_when_the_anchor_item_value_changes_in_place()
    {
        bool replaceA = false;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "a", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@(replaceA ? "x" : "a")">@(replaceA ? "x" : "a")</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // The list only mounts on the first open, and stays mounted once closed. Opening first is what makes the swap
        // below happen in place, on items that already registered their values and elected an anchor.
        await ClickTriggerAsync(cut);
        Assert.Equal(0, SentSelectedIndex());
        await SessionRequestAsync(cut, false, "escape-key", Key("Escape"));
        await CompleteTransitionAsync<string>(cut);
        Assert.Equal("false", Trigger(cut).GetAttribute("aria-expanded"));

        replaceA = true;
        await RefreshAsync(cut);

        await ClickTriggerAsync(cut);

        // The anchor moved to "c"; "x" is no longer selected.
        Assert.Equal(["x", "b", "c"], Texts(cut));
        Assert.Equal(2, SentSelectedIndex());
        Assert.False(IsSelected(cut, "x"));
        Assert.True(IsSelected(cut, "c"));
    }

    [Fact(DisplayName = "moves the anchor to the next selected item when the anchor item leaves the list")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-06")]
    public async Task Moves_the_anchor_to_the_next_selected_item_when_the_anchor_item_leaves_the_list()
    {
        bool trimmed = false;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "a", "b", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @if (!trimmed)
                        {
                            <SelectItem Value="@("a")">a</SelectItem>
                        }
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // The items have to register under the full list before one of them can leave it.
        await ClickTriggerAsync(cut);
        Assert.Equal(["a", "b", "c"], Texts(cut));
        Assert.Equal(0, SentSelectedIndex());
        await SessionRequestAsync(cut, false, "escape-key", Key("Escape"));
        await CompleteTransitionAsync<string>(cut);
        Assert.Equal("false", Trigger(cut).GetAttribute("aria-expanded"));

        trimmed = true;
        await RefreshAsync(cut);
        await PublishOrderAsync(cut);

        await ClickTriggerAsync(cut);

        // "b" is the first item and the first selected one now; "c" is selected but not the anchor. The reconciliation
        // dropped "a" from the value (SEL-STA-13).
        Assert.Equal("b, c", cut.Find("[data-testid=\"trigger\"]").TextContent);
        Assert.Equal(["b", "c"], Texts(cut));
        Assert.Equal(0, SentSelectedIndex());
        Assert.Equal("b", Texts(cut)[SentSelectedIndex()!.Value]);
    }

    [Fact(DisplayName = "re-anchors backwards when a new isItemEqualToValue identity re-runs every item")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-06")]
    public async Task Re_anchors_backwards_when_a_new_is_item_equal_to_value_identity_re_runs_every_item()
    {
        // An inline comparer gives every render a new identity, so all item effects re-run. The anchor moving to an earlier
        // item must survive the old anchor's own effect.
        int generation = 0;
        Func<Choice, Choice, bool> Comparer()
        {
            int identity = ++generation;
            return (a, b) => a.Id == b.Id && identity > 0;
        }

        Choice[] options = [new(0), new(1), new(2), new(3)];
        IReadOnlyList<Choice> value = [new(2), new(3)];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Choice" Multiple="true" Values="@value" IsItemEqualToValue="@Comparer()">
            <SelectTrigger data-testid="trigger">
                <SelectValue>
                    <ValuesContent Context="selected">value</ValuesContent>
                </SelectValue>
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Choice option in options)
                        {
                            <SelectItem @key="option.Id" Value="@option">
                                <SelectItemText>@($"opt-{option.Id}")</SelectItemText>
                            </SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        Assert.Equal(2, SentSelectedIndex());
        Assert.True(IsSelected(cut, "opt-2"));
        await SessionRequestAsync(cut, false, "escape-key", Key("Escape"));
        await CompleteTransitionAsync<Choice>(cut);
        Assert.Equal("false", Trigger(cut).GetAttribute("aria-expanded"));

        value = [new(0), new(1)];
        await RefreshAsync(cut);

        await ClickTriggerAsync(cut);

        Assert.Equal(0, SentSelectedIndex());
        Assert.True(IsSelected(cut, "opt-0"));
        Assert.True(IsSelected(cut, "opt-1"));
        Assert.False(IsSelected(cut, "opt-2"));
    }

    [Fact(DisplayName = "aligns the first selected item with the trigger when alignItemWithTrigger is active")]
    [Trait("Requirement", "SEL-API-14")]
    public async Task Aligns_the_first_selected_item_with_the_trigger_when_align_item_with_trigger_is_active()
    {
        // The measured alignment (the anchor's vertical center within a pixel of the trigger's) is the select module's
        // (SEL-POS-07, L4). C# renders `data-side="none"` while aligned and names the first selected item in rendered order
        // as the item whose text the popup is aligned with.
        string[] options = [.. Enumerable.Range(0, 40).Select(index => $"opt-{index}")];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "opt-10", "opt-30" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup data-testid="popup">
                        @foreach (string option in options)
                        {
                            <SelectItem @key="option" Value="@option">
                                <SelectItemText>@option</SelectItemText>
                            </SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        await PlaceAsync(cut, "bottom");

        Assert.Equal(10, SentSelectedIndex());
        Assert.Equal("none", cut.Find("[data-testid=\"popup\"]").GetAttribute("data-side"));
        string anchorTextId = Option(cut, "opt-10").QuerySelector("[id]")!.Id!;
        Assert.Equal(anchorTextId, SentSelectedTextId());
    }

