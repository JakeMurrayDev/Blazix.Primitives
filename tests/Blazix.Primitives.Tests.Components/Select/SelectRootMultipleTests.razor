    [Fact(DisplayName = "should not close popup when selecting items in multiple mode")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-DIS-07")]
    public async Task Should_not_close_popup_when_selecting_items_in_multiple_mode()
    {
        List<ValueChangeEventArgs<bool>> openChanges = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" OnOpenChange="openChanges.Add">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));

        await ClickOptionAsync(cut, "a");
        Assert.True(IsSelected(cut, "a"));
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));

        await ClickOptionAsync(cut, "b");
        Assert.True(IsSelected(cut, "b"));
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));

        // Only the opening was requested; no activation asked to close.
        Assert.Single(openChanges);
        Assert.True(openChanges[0].Value);
    }

    [Fact(DisplayName = "should close popup in single select mode")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-DIS-07")]
    public async Task Should_close_popup_in_single_select_mode()
    {
        List<ValueChangeEventArgs<bool>> openChanges = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" OnOpenChange="openChanges.Add">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));

        await ClickOptionAsync(cut, "a");

        // The activation asked to close with the reason `item-press`; the popup unmounts once its exit completed.
        Assert.Equal(2, openChanges.Count);
        Assert.False(openChanges[1].Value);
        Assert.Equal(EventReason.ItemPress, openChanges[1].Details.Reason);
        await CompleteTransitionAsync<string>(cut);
        Assert.Equal("false", Trigger(cut).GetAttribute("aria-expanded"));
    }

    [Fact(DisplayName = "should update selected items when value prop changes")]
    [Trait("Requirement", "SEL-API-14")]
    public async Task Should_update_selected_items_when_value_prop_changes()
    {
        IReadOnlyList<string> value = ["a"];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Values="@value">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await OpenAsync(cut);

        Assert.True(IsSelected(cut, "a"));
        Assert.False(IsSelected(cut, "b"));

        value = ["a", "b", "c"];
        await RefreshAsync(cut);

        Assert.True(IsSelected(cut, "a"));
        Assert.True(IsSelected(cut, "b"));
        Assert.True(IsSelected(cut, "c"));
    }

