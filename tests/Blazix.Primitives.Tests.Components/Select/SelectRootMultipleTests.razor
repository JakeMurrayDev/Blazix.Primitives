    [Fact(DisplayName = "continues arrow navigation from the anchor rather than the top of the list")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-06")]
    public async Task Continues_arrow_navigation_from_the_anchor_rather_than_the_top_of_the_list()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "b", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                        <SelectItem Value="@("d")">d</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        // The module starts its arrow keys at the selected index C# sent: "b", not "a" at the top.
        Assert.Equal(1, SentSelectedIndex());
        await HighlightAsync(cut, 1);
        Assert.Equal(1, StoreOf<string>(cut).List!.HighlightedIndex);

        // ArrowDown: the next item after the anchor; ArrowUp: back to it. The anchor itself does not follow the highlight.
        await HighlightAsync(cut, 2);
        Assert.Equal(2, StoreOf<string>(cut).List!.HighlightedIndex);
        Assert.Equal(1, SentSelectedIndex());
        await HighlightAsync(cut, 1);
        Assert.Equal(1, StoreOf<string>(cut).List!.HighlightedIndex);
        Assert.Equal(1, SentSelectedIndex());
    }

    [Fact(DisplayName = "keeps the highlight on an item deselected with the keyboard")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-ARIA-09")]
    public async Task Keeps_the_highlight_on_an_item_deselected_with_the_keyboard()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "b", "c" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                        <SelectItem Value="@("c")">c</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        await HighlightAsync(cut, 1);
        Assert.Equal("true", Option(cut, "b").GetAttribute("aria-selected"));

        // Enter on the highlighted item is its activation, from the keyboard (the key itself is the module's, L4).
        await ClickOptionAsync(cut, Option(cut, "b"), "keyboard");

        // The item is deselected, in `aria-selected` as well, and nothing moved the highlight off it or closed the popup.
        Assert.Equal("false", Option(cut, "b").GetAttribute("aria-selected"));
        Assert.Equal("true", Option(cut, "c").GetAttribute("aria-selected"));
        Assert.Equal(1, StoreOf<string>(cut).List!.HighlightedIndex);
        Assert.NotEmpty(cut.FindAll("[role=\"listbox\"]"));
    }

    [Fact(DisplayName = "anchors to the first selected item in rendered order across groups")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-STA-04")]
    public async Task Anchors_to_the_first_selected_item_in_rendered_order_across_groups()
    {
        // `spinach` renders first but is not the last value, so anchoring to the rendered order and anchoring to the end of
        // the value array give different answers.
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "spinach", "plum" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectGroup>
                            <SelectGroupLabel>Vegetables</SelectGroupLabel>
                            <SelectItem Value="@("artichoke")">artichoke</SelectItem>
                            <SelectItem Value="@("spinach")">spinach</SelectItem>
                        </SelectGroup>
                        <SelectGroup>
                            <SelectGroupLabel>Fruits</SelectGroupLabel>
                            <SelectItem Value="@("apple")">apple</SelectItem>
                            <SelectItem Value="@("plum")">plum</SelectItem>
                        </SelectGroup>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);

        Assert.Equal(["artichoke", "spinach", "apple", "plum"], Texts(cut));
        Assert.Equal(1, SentSelectedIndex());
        Assert.Equal("spinach", Texts(cut)[SentSelectedIndex()!.Value]);
    }

    [Fact(DisplayName = "scrolls the first selected item into view on open")]
    [Trait("Requirement", "SEL-API-14")]
    public async Task Scrolls_the_first_selected_item_into_view_on_open()
    {
        // The scrolling is the module's (SEL-POS-24, SEL-FOC-03: L4), without aligned placement, which translates the popup
        // instead. C#'s half: the module is told not to align, and which item is the anchor it scrolls to.
        string[] options = [.. Enumerable.Range(0, 100).Select(index => $"item {index}")];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" DefaultValues="@(new[] { "item 80", "item 90" })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner AlignItemWithTrigger="false">
                    <SelectPopup data-testid="popup">
                        @foreach (string option in options)
                        {
                            <SelectItem @key="option" Value="@option">
                                <SelectItemText>@option</SelectItemText>
                            </SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        await ClickTriggerAsync(cut);
        await PlaceAsync(cut, "bottom");

        Assert.Equal("bottom", cut.Find("[data-testid=\"popup\"]").GetAttribute("data-side"));
        Assert.Equal(80, SentSelectedIndex());
        Assert.Equal("item 80", Texts(cut)[SentSelectedIndex()!.Value]);
    }

