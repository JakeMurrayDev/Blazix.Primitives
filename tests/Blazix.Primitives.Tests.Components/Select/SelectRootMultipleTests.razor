    [Fact(DisplayName = "does not submit multiple values when disabled")]
    [Trait("Requirement", "SEL-API-13")]
    [Trait("Requirement", "SEL-API-14")]
    [Trait("Requirement", "SEL-DOM-53")]
    [Trait("Requirement", "SEL-FRM-11")]
    public void Does_not_submit_multiple_values_when_disabled()
    {
        // The submit and its FormData are the browser's (L4); C#'s half is that every input of the select carries
        // `disabled`, which keeps it out of the form data.
        IRenderedComponent<SelectHost> cut = RenderSelect(@<form>
            <SelectRoot TValue="string" Multiple="true" Disabled="true" Name="select" Values="@(new[] { "a", "c" })">
                <SelectTrigger>
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("a")">a</SelectItem>
                            <SelectItem Value="@("b")">b</SelectItem>
                            <SelectItem Value="@("c")">c</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
            <button type="submit">Submit</button>
        </form>);

        IReadOnlyList<IElement> hiddenInputs = cut.FindAll("[name=\"select\"]");
        Assert.Equal(2, hiddenInputs.Count);
        Assert.All(hiddenInputs, input => Assert.True(input.HasAttribute("disabled")));
        Assert.True(cut.Find("input[aria-hidden=\"true\"]").HasAttribute("disabled"));
    }

