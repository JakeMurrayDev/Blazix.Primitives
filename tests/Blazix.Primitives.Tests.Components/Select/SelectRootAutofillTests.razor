@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using System.Text.Json
@using AngleSharp.Dom
@using Blazix.Primitives.Interop
@using Bunit
@using Microsoft.JSInterop
@*
    L2: SelectRoot.test.tsx's browser autofill, `autoComplete`, multiple-mode `[data-dirty]` and forced-open disabled and
    read-only titles (M5 track 9, final review B1). A browser autofill is the form module's report of the hidden input's
    `change` (FormTwin.OnAutofill, as the module sends it on Server); the module's restore of the input's value after an
    autofill the root does not take, and the browser filling the input, are the module's (L3 in form.test.ts, L4).
*@

@code {
    private sealed record Country(string Name, string Code);

    // A reference type without value equality, as Base UI's `{ value, label }` objects compare by reference.
    private sealed class ObjectItem(string value, string label)
    {
        public string Value { get; } = value;

        public string Label { get; } = label;
    }

    private static IElement HiddenInput(IRenderedComponent<SelectHost> cut) => cut.Find("input[aria-hidden=\"true\"]");

    private static IElement OptionNamed(IRenderedComponent<SelectHost> cut, string text) =>
        cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == text);

    // The hidden input's `change` with the browser's text, as the form module reports an autofill on Server, then the
    // refreshes the commit starts answered as the module answers them.
    private async Task AutofillAsync(IRenderedComponent<SelectHost> cut, string text)
    {
        JSRuntimeInvocation attach = Form.Invocations["attach"]
            .Last(invocation => JsonSerializer.Deserialize((string)invocation.Arguments[1]!, BlazixJsonContext.Default.FormOptions)!.Control is { ReportAutofill: true });
        FormTwin twin = ((DotNetObjectReference<FormTwin>)attach.Arguments[2]!).Value;
        string json = "{\"text\":\"" + JsonEncodedText.Encode(text).ToString() + "\",\"defaultPrevented\":false,\"event\":{\"kind\":\"Event\",\"type\":\"change\",\"isTrusted\":true}}";
        await cut.InvokeAsync(() => twin.OnAutofill(json));
        await this.SettleFormAsync(cut);
    }

    [Fact(DisplayName = "should handle browser autofill")]
    [Trait("Requirement", "SEL-API-07")]
    [Trait("Requirement", "SEL-STA-09")]
    [Trait("Requirement", "SEL-DOM-47")]
    [Trait("Requirement", "SEL-FRM-18")]
    public async Task Should_handle_browser_autofill()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Name="select">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);

        Assert.Equal("select", HiddenInput(cut).GetAttribute("name"));

        // SEL-STA-09: the items are not rendered before the first focus or open; the autofill force-mounts them so they
        // register for the match.
        Assert.Empty(cut.FindAll("[role=\"option\"]"));
        await AutofillAsync(cut, "b");
        Assert.Equal(2, cut.FindAll("[role=\"option\"]").Count);

        await OpenAsync(cut);

        Assert.Equal(string.Empty, OptionNamed(cut, "b").GetAttribute("data-selected"));
    }

    [Fact(DisplayName = "ignores browser autofill in multiple mode")]
    [Trait("Requirement", "SEL-FRM-19")]
    public async Task Ignores_browser_autofill_in_multiple_mode()
    {
        List<IReadOnlyList<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Name="select" OnValuesChange="e => changes.Add(e.Value)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);

        // The hidden input reports its autofill to the root in multiple mode too; the drop is the root's.
        Assert.True(this.InputOptions()!.ReportAutofill);

        // Autofill only ever writes a single scalar, which can't be meaningfully applied to a multi-selection, so it must
        // be dropped rather than collapsing the value to one item.
        await AutofillAsync(cut, "b");

        Assert.Empty(changes);
        Assert.Empty(StoreOf<string>(cut).Values);
    }

    // SEL-STA-09, SEL-FRM-18 (SelectRoot.tsx:526-541): Base UI force-mounts on any autofill that is not prevented while
    // enabled and editable, and drops the multiple-mode value only in the microtask's match.
    [Fact(DisplayName = "port: an autofill in multiple mode force-mounts the items and changes no value")]
    [Trait("Requirement", "SEL-STA-09")]
    [Trait("Requirement", "SEL-FRM-18")]
    public async Task An_autofill_in_multiple_mode_force_mounts_the_items()
    {
        List<IReadOnlyList<string>> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Multiple="true" Name="select" OnValuesChange="e => changes.Add(e.Value)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);
        Assert.Empty(cut.FindAll("[role=\"option\"]"));

        await AutofillAsync(cut, "b");

        Assert.Equal(2, cut.FindAll("[role=\"option\"]").Count);
        Assert.Empty(changes);
    }

    [Fact(DisplayName = "leaves the value untouched when autofill matches no item")]
    [Trait("Requirement", "SEL-FRM-19")]
    public async Task Leaves_the_value_untouched_when_autofill_matches_no_item()
    {
        List<string> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Name="select" DefaultValue="@("a")" OnValueChange="e => changes.Add(e.Value)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);

        await AutofillAsync(cut, "not-an-option");

        // The root took the report (it force-mounted the items to match against, SEL-FRM-18) and found nothing.
        Assert.Equal(2, cut.FindAll("[role=\"option\"]").Count);
        Assert.Empty(changes);
        Assert.Equal("a", Trigger(cut).TextContent.Trim());
        Assert.Equal("a", this.InputOptions()!.Value);
    }

