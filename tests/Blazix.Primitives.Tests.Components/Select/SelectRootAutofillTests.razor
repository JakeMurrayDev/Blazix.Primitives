    [Fact(DisplayName = "should handle browser autofill with object values")]
    [Trait("Requirement", "SEL-FRM-18")]
    public async Task Should_handle_browser_autofill_with_object_values()
    {
        Country[] items = [new("United States", "US"), new("Canada", "CA")];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Country" Name="country" ItemToStringLabel="@(item => item.Name)" ItemToStringValue="@(item => item.Code)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Country it in items)
                        {
                            <SelectItem @key="it.Code" Value="@it">@it.Name</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);

        Assert.Equal("country", HiddenInput(cut).GetAttribute("name"));
        await AutofillAsync(cut, "CA");

        await OpenAsync(cut);

        Assert.Equal(string.Empty, OptionNamed(cut, "Canada").GetAttribute("data-selected"));
    }

    [Fact(DisplayName = "should handle browser autofill with object values when autofill uses the label")]
    [Trait("Requirement", "SEL-FRM-18")]
    public async Task Should_handle_browser_autofill_with_object_values_when_autofill_uses_the_label()
    {
        // Browsers autofill with the displayed text (label), not the underlying value. For example, Chrome will autofill
        // "United States" (the label), not "US" (the value).
        Country[] items = [new("United States", "US"), new("Canada", "CA")];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Country" Name="country" ItemToStringLabel="@(item => item.Name)" ItemToStringValue="@(item => item.Code)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Country it in items)
                        {
                            <SelectItem @key="it.Code" Value="@it">@it.Name</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await this.SettleFormAsync(cut);

        Assert.Equal("country", HiddenInput(cut).GetAttribute("name"));

        // The browser sends "Canada" (the label), not "CA" (the value).
        await AutofillAsync(cut, "Canada");

        await OpenAsync(cut);

        Assert.Equal(string.Empty, OptionNamed(cut, "Canada").GetAttribute("data-selected"));
    }

    [Fact(DisplayName = "marks the field dirty and validates after successful autofill")]
    [Trait("Requirement", "SEL-EVT-13")]
    [Trait("Requirement", "SEL-FRM-18")]
    public async Task Marks_the_field_dirty_and_validates_after_successful_autofill()
    {
        List<object?> validated = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot ValidationMode="@ValidationMode.OnChange" Validate="@(args => { validated.Add(args.Value); return ValueTask.FromResult<FieldValidationResult?>(Equals(args.Value, "CA") ? null : "error"); })">
            <SelectRoot TValue="string" Name="country">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("US")">United States</SelectItem>
                            <SelectItem Value="@("CA")">Canada</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));

        await AutofillAsync(cut, "CA");

        Assert.NotEmpty(validated);
        Assert.Equal("CA", validated[^1]);
        Assert.Equal(string.Empty, Trigger(cut).GetAttribute("data-dirty"));
    }

    [Fact(DisplayName = "does not update field state when autofill is canceled")]
    [Trait("Requirement", "SEL-EVT-02")]
    [Trait("Requirement", "SEL-EVT-03")]
    [Trait("Requirement", "SEL-FRM-09")]
    public async Task Does_not_update_field_state_when_autofill_is_canceled()
    {
        this.RecordTransitions();
        FormErrors errors = new() { ["country"] = "server error" };
        List<(string Value, EventReason Reason)> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<Form Errors="errors">
            <FieldRoot Name="country">
                <SelectRoot TValue="string" OnValueChange="@(e => { changes.Add((e.Value, e.Details.Reason)); e.Details.Cancel(); })">
                    <SelectTrigger data-testid="trigger">
                        <SelectValue />
                    </SelectTrigger>
                    <SelectPortal>
                        <SelectPositioner>
                            <SelectPopup>
                                <SelectItem Value="@("US")">United States</SelectItem>
                                <SelectItem Value="@("CA")">Canada</SelectItem>
                            </SelectPopup>
                        </SelectPositioner>
                    </SelectPortal>
                </SelectRoot>
                <FieldError data-testid="error" />
            </FieldRoot>
        </Form>);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));
        Assert.Equal("server error", cut.Find("[data-testid=\"error\"]").TextContent.Trim());

        await AutofillAsync(cut, "CA");

        // SEL-EVT-02: the match was requested, with reason `none`, and the consumer canceled it.
        Assert.Equal([("CA", EventReason.None)], changes);
        Assert.False(Trigger(cut).HasAttribute("data-dirty"));
        Assert.Equal("server error", cut.Find("[data-testid=\"error\"]").TextContent.Trim());
    }

    [Fact(DisplayName = "removes [data-dirty] in multiple mode after returning to the initial value")]
    [Trait("Requirement", "SEL-FRM-04")]
    public async Task Removes_data_dirty_in_multiple_mode_after_returning_to_the_initial_value()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <SelectRoot TValue="string" Multiple="true" DefaultOpen="true" DefaultValues="@(new[] { "a" })">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("a")">a</SelectItem>
                            <SelectItem Value="@("b")">b</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);
        await PublishOrderAsync(cut);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));

        await ClickOptionAsync(cut, "b");
        await this.SettleFormAsync(cut);

        Assert.Equal(string.Empty, Trigger(cut).GetAttribute("data-dirty"));

        await ClickOptionAsync(cut, "b");
