    [Fact(DisplayName = "compares object values with isItemEqualToValue when clearing [data-dirty] in multiple mode")]
    [Trait("Requirement", "SEL-API-22")]
    [Trait("Requirement", "SEL-FRM-04")]
    public async Task Compares_object_values_with_isItemEqualToValue_when_clearing_data_dirty_in_multiple_mode()
    {
        ObjectItem[] items = [new("a", "a"), new("b", "b")];

        // A distinct object reference from `items[0]`, but equal to it via `IsItemEqualToValue`.
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <SelectRoot TValue="ObjectItem" Multiple="true" DefaultOpen="true" DefaultValues="@(new[] { new ObjectItem("a", "a") })" IsItemEqualToValue="@((a, b) => a.Value == b.Value)">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@items[0]">a</SelectItem>
                            <SelectItem Value="@items[1]">b</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);
        await PublishOrderAsync(cut);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));

        // Deselect the initial item, then reselect it. The reselected value is `items[0]`, a different object reference
        // than the initial default object, so a reference comparison would incorrectly report dirty.
        await ClickOptionAsync(cut, "a");
        await this.SettleFormAsync(cut);

        Assert.Equal(string.Empty, Trigger(cut).GetAttribute("data-dirty"));

        await ClickOptionAsync(cut, "a");
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));
    }

    [Fact(DisplayName = "does not invoke isItemEqualToValue with the value array in multiple mode when empty")]
    [Trait("Requirement", "SEL-API-22")]
    public async Task Does_not_invoke_isItemEqualToValue_with_the_value_array_in_multiple_mode_when_empty()
    {
        ObjectItem[] items = [new("a", "a"), new("b", "b")];

        // The comparer is `Func<TValue, TValue, bool>`, so the value array cannot reach it in C#; the runtime half of the
        // title is that an empty selection is compared against nothing selected, so the comparer only ever sees two
        // non-null values (SEL-API-22) while the items mount and register.
        List<(ObjectItem? Item, ObjectItem? Selected)> calls = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="ObjectItem" Multiple="true" DefaultOpen="true" DefaultValues="@(Array.Empty<ObjectItem>())" IsItemEqualToValue="@((a, b) => { calls.Add((a, b)); return a.Value == b.Value; })">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@items[0]">a</SelectItem>
                        <SelectItem Value="@items[1]">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await PublishOrderAsync(cut);

        Assert.NotNull(Trigger(cut));
        Assert.Equal(2, cut.FindAll("[role=\"option\"]").Count);
        Assert.All(calls, call =>
        {
            Assert.NotNull(call.Item);
            Assert.NotNull(call.Selected);
        });
    }

    [Fact(DisplayName = "keeps [data-dirty] in multiple mode when the same values return in a different order")]
    [Trait("Requirement", "SEL-FRM-04")]
    public async Task Keeps_data_dirty_in_multiple_mode_when_the_same_values_return_in_a_different_order()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <SelectRoot TValue="string" Multiple="true" DefaultOpen="true" DefaultValues="@(new[] { "a", "b" })">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("a")">a</SelectItem>
                            <SelectItem Value="@("b")">b</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);
        await PublishOrderAsync(cut);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("data-dirty"));

        // Deselect `a` (the value becomes ["b"]), then reselect it (the value becomes ["b", "a"]). The set of values
        // matches the initial ["a", "b"], but the order differs, so the field stays dirty: the comparison is order-sensitive.
        await ClickOptionAsync(cut, "a");
        await this.SettleFormAsync(cut);
        await ClickOptionAsync(cut, "a");
        await this.SettleFormAsync(cut);

        Assert.Equal(["b", "a"], StoreOf<string>(cut).Values);
        Assert.Equal(string.Empty, Trigger(cut).GetAttribute("data-dirty"));
    }

    [Theory(DisplayName = "ignores hidden-input autofill when $lockState $label")]
    [InlineData("readOnly", "inside Field", true)]
    [InlineData("disabled", "inside Field", true)]
    [InlineData("readOnly", "outside Field", false)]
    [InlineData("disabled", "outside Field", false)]
    [Trait("Requirement", "SEL-DOM-47")]
    [Trait("Requirement", "SEL-FRM-12")]
    [Trait("Requirement", "SEL-FRM-19")]
    public async Task Ignores_hidden_input_autofill(string lockState, string label, bool withField)
    {
        _ = label;
        this.RecordTransitions();
        List<string> changes = [];
        FormErrors errors = new() { ["select"] = "test" };
        RenderFragment select = @<SelectRoot TValue="string" Name="@(withField ? null : "select")" ReadOnly="@(lockState == "readOnly")" Disabled="@(lockState == "disabled")" OnValueChange="e => changes.Add(e.Value)">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>;

        IRenderedComponent<SelectHost> cut = withField
            ? RenderSelect(@<Form Errors="errors">
                <FieldRoot Name="select">
                    @select
                    <FieldError data-testid="error" />
                </FieldRoot>
            </Form>)
            : RenderSelect(select);
        await this.SettleFormAsync(cut);

        Assert.Equal("select", HiddenInput(cut).GetAttribute("name"));

        // Only the Field wrapper renders an error.
        string? expectedError = withField ? "test" : null;
        Assert.Equal(expectedError, cut.FindAll("[data-testid=\"error\"]").SingleOrDefault()?.TextContent.Trim());

        await AutofillAsync(cut, "b");

        // The value C# hands the form module for the input stays empty; putting it back over the browser's text is the
        // module's (form.test.ts, L4).
        Assert.Empty(changes);
        Assert.Equal(string.Empty, this.InputOptions()!.Value);
        Assert.Equal(expectedError, cut.FindAll("[data-testid=\"error\"]").SingleOrDefault()?.TextContent.Trim());
    }

    [Theory(DisplayName = "does not commit item selection when root is %s and forced open")]
    [InlineData("disabled")]
    [InlineData("readOnly")]
    [Trait("Requirement", "SEL-EDGE-06")]
    public async Task Does_not_commit_item_selection_when_root_is_locked_and_forced_open(string lockState)
    {
        List<string> changes = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Open="true" OnValueChange="e => changes.Add(e.Value)" Disabled="@(lockState == "disabled")" ReadOnly="@(lockState == "readOnly")">
            <SelectTrigger data-testid="trigger">
                <SelectValue />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("a")">a</SelectItem>
                        <SelectItem Value="@("b")">b</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);
        await PublishOrderAsync(cut);

        // The forced-open popup renders its items. The activation is reported as the select module reports a click; while
        // disabled the module would not report it (the items are disabled, L4), so this checks the commit's own re-check
        // of both flags, which SEL-EDGE-06 requires independently of the interaction gates.
        await ClickOptionAsync(cut, "b");

        Assert.Empty(changes);
        Assert.False(OptionNamed(cut, "b").HasAttribute("data-selected"));
    }
}
