        Assert.Equal("Select an option", ValueOf(cut).TextContent);
    }

    [Fact(DisplayName = "null key label in object items takes precedence over placeholder")]
    [Trait("Requirement", "SEL-API-30")]
    [Trait("Requirement", "SEL-EDGE-19")]
    public void Null_key_label_in_object_items_takes_precedence_over_placeholder()
    {
        IReadOnlyDictionary<string, string?> items = new Dictionary<string, string?>
        {
            ["null"] = "None",
            ["option1"] = "Option 1",
        };

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" ItemLabels="items">
            <SelectValue data-testid="value">
                <Placeholder>Select an option</Placeholder>
            </SelectValue>
        </SelectRoot>);

        Assert.Equal("None", ValueOf(cut).TextContent);
    }

    [Fact(DisplayName = "supports ReactNode as placeholder")]
    [Trait("Requirement", "SEL-API-30")]
    public void Supports_ReactNode_as_placeholder()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string">
            <SelectValue data-testid="value">
                <Placeholder><span data-testid="placeholder">Select an option</span></Placeholder>
            </SelectValue>
        </SelectRoot>);

        Assert.Equal("Select an option", cut.Find("[data-testid=\"placeholder\"]").TextContent);
        Assert.Equal("value", cut.Find("[data-testid=\"placeholder\"]").ParentElement!.GetAttribute("data-testid"));
    }
