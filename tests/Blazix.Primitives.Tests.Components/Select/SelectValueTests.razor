    [Fact(DisplayName = "changes text when the value changes")]
    [Trait("Requirement", "SEL-DOM-10")]
    public async Task Changes_text_when_the_value_changes()
    {
        string value = null!;

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@value">
            <SelectTrigger>
                <SelectValue data-testid="value">
                    <ValueContent Context="current">@(current ?? "initial")</ValueContent>
                </SelectValue>
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("1")">1</SelectItem>
                        <SelectItem Value="@("2")">2</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("initial", ValueOf(cut).TextContent);
        await OpenAsync(cut);

        value = "1";
        await RefreshAsync(cut);
        Assert.Equal("1", ValueOf(cut).TextContent);

        value = "2";
        await RefreshAsync(cut);
        Assert.Equal("2", ValueOf(cut).TextContent);

        value = null!;
        await RefreshAsync(cut);
        Assert.Equal("initial", ValueOf(cut).TextContent);
    }

