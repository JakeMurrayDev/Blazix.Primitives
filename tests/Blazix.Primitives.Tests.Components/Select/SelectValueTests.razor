@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using AngleSharp.Dom
@using Bunit
@*
    L2: SelectValue.test.tsx's titles bUnit observes (M5 track 9). The value part is C# only: the label it resolves from the
    root's items, the templates and the placeholder. A label is a string in the port (design point N1), so the ReactNode
    label titles are not ported; the object `label`/`value` member fallback is replaced by ItemToStringLabel and
    ItemToStringValue (ADR 16 rule 1), which a port title below covers.
*@

@code {
    private sealed record Country(string Name, string Code)
    {
        public override string ToString() => Code;
    }

    private static string? Record(List<string?> calls, string? value)
    {
        calls.Add(value);
        return value;
    }

    private static string RecordAll(List<IReadOnlyList<string>> calls, IReadOnlyList<string> values)
    {
        calls.Add(values);
        return "Selected: " + string.Join(" + ", values);
    }

    private static IElement ValueOf(IRenderedComponent<SelectHost> cut) => cut.Find("[data-testid=\"value\"]");

    // prop: children

    [Fact(DisplayName = "accepts a function with a value parameter")]
    [Trait("Requirement", "SEL-API-29")]
    [Trait("Requirement", "SEL-EVT-14")]
    public async Task Accepts_a_function_with_a_value_parameter()
    {
        List<string?> calls = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@("1")">
            <SelectTrigger>
                <SelectValue>
                    <ValueContent Context="value">@Record(calls, value)</ValueContent>
                </SelectValue>
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("1")">one</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        // Base UI clicks the trigger's text; the open press is the interactions module's report.
        await OpenAsync(cut);

        Assert.Equal("1", calls[0]);
        Assert.Equal("1", Trigger(cut).TextContent);
    }

    [Fact(DisplayName = "overrides the text when children is a string")]
    [Trait("Requirement", "SEL-API-29")]
    public void Overrides_the_text_when_children_is_a_string()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@("1")">
            <SelectValue data-testid="value">one</SelectValue>
        </SelectRoot>);

        Assert.Equal("one", ValueOf(cut).TextContent);
    }

    // prop: items (object format)

    [Fact(DisplayName = "displays the label from items object when no children are provided")]
    [Trait("Requirement", "SEL-API-19")]
    public void Displays_the_label_from_items_object_when_no_children_are_provided()
    {
        IReadOnlyDictionary<string, string?> items = new Dictionary<string, string?>
        {
            ["sans"] = "Sans-serif",
            ["serif"] = "Serif",
            ["mono"] = "Monospace",
        };

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@("sans")" ItemLabels="items">
            <SelectTrigger>
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("sans")">Sans-serif</SelectItem>
                        <SelectItem Value="@("serif")">Serif</SelectItem>
                        <SelectItem Value="@("mono")">Monospace</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("Sans-serif", ValueOf(cut).TextContent);
    }

    [Fact(DisplayName = "updates the label when value changes with items object")]
    [Trait("Requirement", "SEL-API-19")]
    public async Task Updates_the_label_when_value_changes_with_items_object()
    {
        IReadOnlyDictionary<string, string?> items = new Dictionary<string, string?>
        {
            ["sans"] = "Sans-serif",
            ["serif"] = "Serif",
            ["mono"] = "Monospace",
        };
        string value = "sans";

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@value" ItemLabels="items">
            <SelectTrigger>
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        <SelectItem Value="@("sans")">Sans-serif</SelectItem>
                        <SelectItem Value="@("serif")">Serif</SelectItem>
                        <SelectItem Value="@("mono")">Monospace</SelectItem>
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("Sans-serif", ValueOf(cut).TextContent);

        value = "serif";
        await RefreshAsync(cut);
        Assert.Equal("Serif", ValueOf(cut).TextContent);

        value = "mono";
        await RefreshAsync(cut);
        Assert.Equal("Monospace", ValueOf(cut).TextContent);
    }

