    // "supports ReactNode labels in items array": not ported, as "supports ReactNode labels in items object" (string labels).

    [Fact(DisplayName = "is not stale after being updated")]
    [Trait("Requirement", "SEL-API-19")]
    public async Task Is_not_stale_after_being_updated()
    {
        string value = "a";
        LabeledValue<string>[] items = [new("a", "a"), new("b", "b")];

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Value="@value" Items="items">
            <SelectTrigger>
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (LabeledValue<string> item in items)
                        {
                            <SelectItem @key="item.Value" Value="@item.Value">@item.Label</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("a", ValueOf(cut).TextContent);

        items = [new("a", "a new"), new("b", "b new"), new("c", "c")];
        await RefreshAsync(cut);
        Assert.Equal("a new", ValueOf(cut).TextContent);

        value = "c";
        await RefreshAsync(cut);
        Assert.Equal("c", ValueOf(cut).TextContent);
    }

    // prop: itemToStringLabel

    [Fact(DisplayName = "uses custom itemToStringLabel function")]
    [Trait("Requirement", "SEL-API-20")]
    public void Uses_custom_itemToStringLabel_function()
    {
        Country[] items = [new("United States", "US"), new("Canada", "CA")];

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Country" Value="@items[1]" ItemToStringLabel="country => country.Name" ItemToStringValue="country => country.Code">
            <SelectTrigger>
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Country country in items)
                        {
                            <SelectItem @key="country.Code" Value="country">@country.Name</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("Canada", ValueOf(cut).TextContent);
    }

    // The port never reads an object's `label` and `value` members (ADR 16 rule 1; UTL, track 4's design point 2): without
    // the two functions the label and the submitted text are the value's invariant text, here the record's ToString.
    [Fact(DisplayName = "port: falls back to the value's invariant text when the functions are not provided")]
    [Trait("Requirement", "SEL-DOM-51")]
    [Trait("Requirement", "SEL-DOM-10")]
    public void Port_falls_back_to_the_values_invariant_text_when_the_functions_are_not_provided()
    {
        Country[] items = [new("United States", "US"), new("Canada", "CA")];

        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="Country" Name="country" Value="@items[1]">
            <SelectTrigger>
                <SelectValue data-testid="value" />
            </SelectTrigger>
            <SelectPortal>
                <SelectPositioner>
                    <SelectPopup>
                        @foreach (Country country in items)
                        {
                            <SelectItem @key="country.Code" Value="country">@country.Name</SelectItem>
                        }
                    </SelectPopup>
                </SelectPositioner>
            </SelectPortal>
        </SelectRoot>);

        Assert.Equal("CA", ValueOf(cut).TextContent);
        Assert.Equal("CA", cut.Find("input[name=\"country\"]").GetAttribute("value"));
    }

