    [Fact(DisplayName = "prop: validateMode=onSubmit")]
    [Trait("Requirement", "SEL-FRM-17")]
    public async Task Prop_validateMode_onSubmit()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<Form>
            <FieldRoot Validate="@(args => ValueTask.FromResult<FieldValidationResult?>(Equals(args.Value, "2") ? "error" : null))">
                <SelectRoot TValue="string" Required="true">
                    <SelectTrigger />
                    <SelectPortal>
                        <SelectPositioner>
                            <SelectPopup>
                                <SelectItem Value="@("1")">Option 1</SelectItem>
                                <SelectItem Value="@("2")">Option 2</SelectItem>
                            </SelectPopup>
                        </SelectPositioner>
                    </SelectPortal>
                </SelectRoot>
            </FieldRoot>
            <button type="submit">submit</button>
        </Form>);
        await this.SettleFormAsync(cut);

        Assert.False(Trigger(cut).HasAttribute("aria-invalid"));

        await this.SubmitFormAsync(cut);
        Assert.Equal("true", Trigger(cut).GetAttribute("aria-invalid"));

        // ArrowDown to highlight Option 1 (valid), and Enter, are the modules' (L4); the activation is the click.
        await OpenAsync(cut);
        await ClickOptionAsync(cut, "Option 1");
        await this.SettleFormAsync(cut);
        Assert.False(Trigger(cut).HasAttribute("aria-invalid"));

        await CompleteTransitionAsync<string>(cut);
        await OpenAsync(cut);
        await ClickOptionAsync(cut, "Option 2");
        await this.SettleFormAsync(cut);
        Assert.Equal("true", Trigger(cut).GetAttribute("aria-invalid"));

        await CompleteTransitionAsync<string>(cut);
        await OpenAsync(cut);
        await ClickOptionAsync(cut, "Option 1");
        await this.SettleFormAsync(cut);
        Assert.False(Trigger(cut).HasAttribute("aria-invalid"));
    }

