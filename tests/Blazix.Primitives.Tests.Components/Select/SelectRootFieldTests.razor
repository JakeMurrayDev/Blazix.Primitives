    [Fact(DisplayName = "does not add [data-filled] attribute when a non-string value serializes to empty string")]
    [Trait("Requirement", "SEL-DOM-06")]
    [Trait("Requirement", "SEL-FRM-05")]
    [Trait("Requirement", "SEL-STA-02")]
    public async Task Does_not_add_data_filled_attribute_when_a_non_string_value_serializes_to_empty_string()
    {
        EmptyOption emptyValue = new(1, "Empty option");
        EmptyOption option = new(2, "Option 1");
        EmptyOption current = emptyValue;

        // Base UI serializes every option to ''; here only the first does, so the same tree can show a value that fills the field.
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <SelectRoot TValue="EmptyOption" Value="@current" ItemToStringLabel="@(item => item.Label)" ItemToStringValue="@(item => item.Id == 1 ? string.Empty : item.Id.ToString(CultureInfo.InvariantCulture))">
                <SelectTrigger data-testid="trigger" />
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@emptyValue">Empty option</SelectItem>
                            <SelectItem Value="@option">Option 1</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);

        Assert.False(Trigger(cut).HasAttribute("data-filled"));

        // The positive control of that absence: a value that serializes to text fills the field.
        current = option;
        await RefreshAsync(cut);
        Assert.True(Trigger(cut).HasAttribute("data-filled"));
    }

