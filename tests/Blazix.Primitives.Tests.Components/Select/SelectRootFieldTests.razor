    [Fact(DisplayName = "does not set fallback aria-labelledby when no label is rendered")]
    [Trait("Requirement", "SEL-ARIA-05")]
    public async Task Does_not_set_fallback_aria_labelledby_when_no_label_is_rendered()
    {
        bool labelled = false;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string">
            @if (labelled)
            {
                <SelectLabel data-testid="label" />
            }
            <SelectTrigger data-testid="trigger" aria-label="Font" />
            <SelectPortal>
                <SelectPositioner />
            </SelectPortal>
        </SelectRoot>);

        Assert.False(Trigger(cut).HasAttribute("aria-labelledby"));
        Assert.Equal("Font", Trigger(cut).GetAttribute("aria-label"));

        // The positive control of that absence: a mounted label is the one source of `aria-labelledby`.
        labelled = true;
        await RefreshAsync(cut);
        Assert.Equal(cut.Find("[data-testid=\"label\"]").GetAttribute("id"), Trigger(cut).GetAttribute("aria-labelledby"));
    }

    [Fact(DisplayName = "updates Select.Label linkage when root id changes")]
    [Trait("Requirement", "SEL-API-10")]
    [Trait("Requirement", "SEL-DOM-14")]
    [Trait("Requirement", "SEL-FRM-15")]
    public async Task Updates_Select_Label_linkage_when_root_id_changes()
    {
        string id = "first";
        IRenderedComponent<SelectHost> cut = RenderSelect(@<SelectRoot TValue="string" Id="@id">
            <SelectLabel data-testid="label">Theme</SelectLabel>
            <SelectTrigger data-testid="trigger" />
            <SelectPortal>
                <SelectPositioner />
            </SelectPortal>
        </SelectRoot>);
        Assert.Equal("first-label", cut.Find("[data-testid=\"label\"]").GetAttribute("id"));

        id = "second";
        await RefreshAsync(cut);

        IElement label = cut.Find("[data-testid=\"label\"]");
        IElement trigger = Trigger(cut);
        Assert.Equal("second-label", trigger.GetAttribute("aria-labelledby"));
        Assert.Equal("second", trigger.GetAttribute("id"));
        Assert.Equal("second-label", label.GetAttribute("id"));
    }

    // The click on the label, which the browser forwards to the control and which moves focus to the popup, is L4.
    [Fact(DisplayName = "Field.Label links to trigger and focuses it")]
    [Trait("Requirement", "SEL-FRM-14")]
    public void Field_Label_links_to_trigger_and_focuses_it()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <FieldLabel data-testid="label">Font</FieldLabel>
            <SelectRoot TValue="string">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("sans")">Sans-serif</SelectItem>
                            <SelectItem Value="@("serif")">Serif</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </FieldRoot>);

        IElement label = cut.Find("[data-testid=\"label\"]");
        IElement trigger = cut.Find("[data-testid=\"trigger\"]");

        Assert.False(string.IsNullOrEmpty(trigger.Id));
        Assert.Equal(trigger.Id, label.GetAttribute("for"));
        Assert.Equal(label.GetAttribute("for"), trigger.GetAttribute("id"));
        Assert.Equal(label.GetAttribute("id"), trigger.GetAttribute("aria-labelledby"));
    }

