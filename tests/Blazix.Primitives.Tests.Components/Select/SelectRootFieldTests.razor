    [Fact(DisplayName = "resets selected index when value is set to null without a null item")]
    [Trait("Requirement", "SEL-STA-03")]
    public async Task Resets_selected_index_when_value_is_set_to_null_without_a_null_item()
    {
        string value = null!;
        IRenderedComponent<SelectHost> cut = RenderSelect(@<div>
            <SelectRoot TValue="string" Value="@value" OnValueChange="e => value = e.Value">
                <SelectTrigger data-testid="trigger">
                    <SelectValue data-testid="value" ValueContent="InitialOrValue" />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("1")">1</SelectItem>
                            <SelectItem Value="@("2")">2</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </div>);

        await OpenAsync(cut);
        await CloseAsync<string>(cut);

        // The buttons of the Base UI test set the state the tree reads.
        value = "1";
        await RefreshAsync(cut);
        Assert.Equal("1", cut.Find("[data-testid=\"value\"]").TextContent);

        value = "2";
        await RefreshAsync(cut);
        Assert.Equal("2", cut.Find("[data-testid=\"value\"]").TextContent);

        // The positive control of the absence below: the popup shows the controlled value as the selected item.
        await OpenAsync(cut);
        Assert.True(OptionNamed(cut, "2").HasAttribute("data-selected"));
        await CloseAsync<string>(cut);

        value = null!;
        await RefreshAsync(cut);
        Assert.Equal("initial", cut.Find("[data-testid=\"value\"]").TextContent);

        await OpenAsync(cut);
        Assert.NotEmpty(cut.FindAll("[role=\"option\"]"));
        Assert.All(cut.FindAll("[role=\"option\"]"), option =>
        {
            Assert.False(option.HasAttribute("data-selected"));
            Assert.Equal("false", option.GetAttribute("aria-selected"));
        });
    }

    [Fact(DisplayName = "does not force-mount the popup on a programmatic value change")]
    [Trait("Requirement", "SEL-STR-06")]
    public async Task Does_not_force_mount_the_popup_on_a_programmatic_value_change()
    {
        string withItems = null!;
        string withoutItems = null!;
        Dictionary<string, string?> labels = new() { ["a"] = "Apple", ["b"] = "Banana" };
        IRenderedComponent<SelectHost> cut = RenderSelect(@<div>
            <SelectRoot TValue="string" ItemLabels="labels" Value="@withItems" OnValueChange="e => withItems = e.Value">
                <SelectTrigger>
                    <SelectValue data-testid="items-value" />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("a")">Apple</SelectItem>
                            <SelectItem Value="@("b")">Banana</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
            <SelectRoot TValue="string" Value="@withoutItems" OnValueChange="e => withoutItems = e.Value">
                <SelectTrigger>
                    <SelectValue data-testid="plain-value" />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("a")">a</SelectItem>
                            <SelectItem Value="@("b")">b</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </div>);

        Assert.Empty(cut.FindAll("[role=\"listbox\"]"));

        // The button of the Base UI test sets both values.
        withItems = "b";
        withoutItems = "b";
        await RefreshAsync(cut);

        // A programmatic value change must not force-mount the popup (which would leave it in the DOM permanently). The label
        // resolves without the list mounted, with or without `items`.
        Assert.Empty(cut.FindAll("[role=\"listbox\"]"));
        Assert.Equal("Banana", cut.Find("[data-testid=\"items-value\"]").TextContent);
        Assert.Equal("b", cut.Find("[data-testid=\"plain-value\"]").TextContent);
    }

    [Fact(DisplayName = "submits stringified value to onFormSubmit when itemToStringValue is provided")]
    [Trait("Requirement", "SEL-API-21")]
    [Trait("Requirement", "SEL-FRM-01")]
    [Trait("Requirement", "SEL-FRM-02")]
    public async Task Submits_stringified_value_to_onFormSubmit_when_itemToStringValue_is_provided()
    {
        Country[] items = [new("US", "United States"), new("CA", "Canada")];
        List<FormValues> submitted = [];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<Form OnFormSubmit="e => submitted.Add(e.Values)">
            <FieldRoot Name="country">
                <SelectRoot TValue="Country" DefaultValue="@items[0]" ItemToStringLabel="@(item => item.Label)" ItemToStringValue="@(item => item.Code)">
                    <SelectTrigger>
                        <SelectValue />
                    </SelectTrigger>
                    <SelectPortal>
                        <SelectPositioner>
                            <SelectPopup>
                                <SelectItem Value="@items[0]">United States</SelectItem>
                                <SelectItem Value="@items[1]">Canada</SelectItem>
                            </SelectPopup>
                        </SelectPositioner>
                    </SelectPortal>
                </SelectRoot>
            </FieldRoot>
            <button type="submit">Submit</button>
        </Form>);
        await this.SettleFormAsync(cut);

        FormSubmitAnswer answer = await this.SubmitFormAsync(cut);

        FormValues values = Assert.Single(submitted);
        Assert.Equal(["country"], values.Keys);
        Assert.Equal("US", values["country"]);
        Assert.Equal(FormSubmitAnswer.HandledVerdict, answer.Verdict);
    }

    // The FormData the browser builds from the `form` attribute is the browser's (L4); C# renders the attribute, the name and
    // the value on the input the browser submits.
    [Fact(DisplayName = "submits to an external form when `form` is provided")]
    [Trait("Requirement", "SEL-API-08")]
    public void Submits_to_an_external_form_when_form_is_provided()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<text>
            <form id="external-form">
                <button type="submit">Submit</button>
            </form>
            <SelectRoot TValue="string" Name="country" Form="external-form" DefaultValue="@("US")">
                <SelectTrigger>
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("US")">United States</SelectItem>
                            <SelectItem Value="@("CA")">Canada</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </text>);

        IElement input = cut.Find("input[aria-hidden=\"true\"]");
        Assert.Equal("external-form", input.GetAttribute("form"));
        Assert.Equal("country", input.GetAttribute("name"));
        Assert.Equal("US", input.GetAttribute("value"));
    }

    [Fact(DisplayName = "submits multiple values to an external form when `form` is provided")]
    [Trait("Requirement", "SEL-API-08")]
    [Trait("Requirement", "SEL-DOM-53")]
    public void Submits_multiple_values_to_an_external_form_when_form_is_provided()
    {
        string[] values = ["US", "CA"];
        IRenderedComponent<SelectHost> cut = RenderSelect(@<text>
            <form id="external-form">
                <button type="submit">Submit</button>
            </form>
            <SelectRoot TValue="string" Multiple="true" Name="countries" Form="external-form" Values="values">
                <SelectTrigger>
                    <SelectValue />
                </SelectTrigger>
                <SelectPortal>
                    <SelectPositioner>
                        <SelectPopup>
                            <SelectItem Value="@("US")">United States</SelectItem>
                            <SelectItem Value="@("CA")">Canada</SelectItem>
                            <SelectItem Value="@("AU")">Australia</SelectItem>
                        </SelectPopup>
                    </SelectPositioner>
                </SelectPortal>
            </SelectRoot>
        </text>);

        // One hidden input per selected value, in value order, under the name and the form (the FormData is L4).
        IReadOnlyList<IElement> inputs = cut.FindAll("input[type=\"hidden\"]");
        Assert.Equal(["US", "CA"], inputs.Select(input => input.GetAttribute("value")));
        Assert.All(inputs, input =>
        {
            Assert.Equal("countries", input.GetAttribute("name"));
            Assert.Equal("external-form", input.GetAttribute("form"));
        });
    }

    [Fact(DisplayName = "triggers native HTML validation on submit")]
    [Trait("Requirement", "SEL-API-11")]
    public async Task Triggers_native_HTML_validation_on_submit()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<Form>
            <FieldRoot Name="test" data-testid="field">
                <SelectRoot TValue="string" Required="true">
                    <SelectTrigger data-testid="trigger">
                        <SelectValue />
                    </SelectTrigger>
                    <SelectPortal>
                        <SelectPositioner />
                    </SelectPortal>
                </SelectRoot>
                <FieldError Match="@ValidityFlag.ValueMissing" data-testid="error">required</FieldError>
            </FieldRoot>
            <button type="submit">Submit</button>
        </Form>);
        await this.SettleFormAsync(cut);

        Assert.Empty(cut.FindAll("[data-testid=\"error\"]"));

        // The first invalid control receives focus (the module's, L4); C# blocks the submission and shows the error.
        FormSubmitAnswer answer = await this.SubmitFormAsync(cut);

        Assert.Equal(FormSubmitAnswer.BlockedVerdict, answer.Verdict);
        Assert.Equal("required", cut.Find("[data-testid=\"error\"]").TextContent.Trim());
        Assert.Equal([Trigger(cut).Id!], answer.Focus);
    }

    [Fact(DisplayName = "clears external errors on change")]
    [Trait("Requirement", "SEL-ARIA-07")]
    [Trait("Requirement", "SEL-EVT-13")]
    [Trait("Requirement", "SEL-FRM-06")]
    [Trait("Requirement", "SEL-FRM-09")]
    [Trait("Requirement", "SEL-FRM-17")]
    public async Task Clears_external_errors_on_change()
    {
        BunitJSModuleInterop transitions = this.RecordTransitions();
        FormErrors errors = new() { ["select"] = "test" };
        IRenderedComponent<SelectHost> cut = RenderSelect(@<Form Errors="errors">
            <FieldRoot Name="select">
                <SelectRoot TValue="string">
                    <SelectTrigger data-testid="trigger">
                        <SelectValue />
                    </SelectTrigger>
                    <SelectPortal>
                        <SelectPositioner>
                            <SelectPopup>
                                <SelectItem Value="@("a")">a</SelectItem>
                                <SelectItem Value="@("b")">b</SelectItem>
                            </SelectPopup>
                        </SelectPositioner>
                    </SelectPortal>
                </SelectRoot>
                <FieldError data-testid="error" />
            </FieldRoot>
        </Form>);
        await this.SettleFormAsync(cut);

        Assert.Equal("test", cut.Find("[data-testid=\"error\"]").TextContent.Trim());
        Assert.Equal("true", cut.Find("[data-testid=\"trigger\"]").GetAttribute("aria-invalid"));
        TransitionsTwin errorTwin = this.LastTransitionsTwin(transitions);

        await OpenAsync(cut);
        await ClickOptionAsync(cut, "b");
        await this.SettleFormAsync(cut);

        // The message plays its exit before it unmounts (the transitions module's report); `aria-invalid` goes with the verdict.
        Assert.False(cut.Find("[data-testid=\"trigger\"]").HasAttribute("aria-invalid"));
        await this.CompleteExitAsync(cut, errorTwin);
        Assert.Empty(cut.FindAll("[data-testid=\"error\"]"));
    }

