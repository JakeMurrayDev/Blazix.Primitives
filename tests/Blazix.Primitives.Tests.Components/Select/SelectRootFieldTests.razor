@namespace Blazix.Primitives.Tests.Components
@inherits SelectTestBase
@using System.Globalization
@using AngleSharp.Dom
@using Blazix.Primitives.Interop
@using Bunit
@using Microsoft.AspNetCore.Components.Web
@*
    L2: SelectRoot.test.tsx's "with Field.Root parent", "Form" and "Field" blocks and the two titles between them
    (M5 track 9). The field half reads the hidden input's native validity from the form module (SelectRootFieldSupport
    answers its refreshes, as the module does on Server) and the trigger's focus and blur from C# (focus) and the select
    module's report (blur). The key presses, the native label's click, the focus after an invalid submission and the
    FormData of an external form are L4 (tests/browser/select.spec.ts). Not ported here: the three "[data-focused] without
    a blur event" and "focus moves into the popup" titles, "validates when the popup is blurred",
    "prop: validationMode=onBlur" and "Select.Label focuses trigger without opening" (L4).
*@

@code {
    private sealed record Country(string Code, string Label);

    private static IElement OptionNamed(IRenderedComponent<SelectHost> cut, string text) =>
        cut.FindAll("[role=\"option\"]").First(option => option.TextContent.Trim() == text);

    private sealed record EmptyOption(int Id, string Label);

    // Base UI's `(val) => val ?? 'initial'` children function.
    private static readonly RenderFragment<string> InitialOrValue = val => builder => builder.AddContent(0, val ?? "initial");

    [Fact(DisplayName = "applies the root id to the trigger")]
    [Trait("Requirement", "SEL-API-10")]
    [Trait("Requirement", "SEL-FRM-14")]
    [Trait("Requirement", "SEL-FRM-23")]
    public void Applies_the_root_id_to_the_trigger()
    {
        IRenderedComponent<SelectHost> cut = RenderSelect(@<FieldRoot>
            <FieldLabel data-testid="label">Label</FieldLabel>
            <SelectRoot TValue="string" Id="test-id">
                <SelectTrigger data-testid="trigger">
                    <SelectValue />
                </SelectTrigger>
            </SelectRoot>
        </FieldRoot>);

        Assert.Equal("test-id", cut.Find("[data-testid=\"trigger\"]").GetAttribute("id"));
        Assert.Equal("test-id", cut.Find("[data-testid=\"label\"]").GetAttribute("for"));
    }

