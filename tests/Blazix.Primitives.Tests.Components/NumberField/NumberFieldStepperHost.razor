@namespace Blazix.Primitives.Tests.Components
@using System.Globalization
@*
    The test consumer of useNumberFieldStepperButton.test.tsx: one root with a stepper and an input (TestNumberField), the
    stepper an Increment or a Decrement as the test's case says. State a Base UI test keeps with useState is the host's own:
    `Controlled` makes the root's value the host's, and ExternalValue is the "external" button's setValue.
*@
@if (Controlled)
{
    <NumberFieldRoot Value="hostValue" OnValueChange="OnChangeAsync" Culture="Culture" Min="Min" Max="Max" Step="Step" SnapOnStep="SnapOnStep" Disabled="Disabled" ReadOnly="ReadOnly" Format="Format">
        @Parts
    </NumberFieldRoot>
}
else
{
    <NumberFieldRoot DefaultValue="DefaultValue" OnValueChange="OnChangeAsync" Culture="Culture" Min="Min" Max="Max" Step="Step" SnapOnStep="SnapOnStep" Disabled="Disabled" ReadOnly="ReadOnly" Format="Format">
        @Parts
    </NumberFieldRoot>
}

@code {
    private double? hostValue;
    private bool initialized;

    [Parameter] public bool Increment { get; set; } = true;
    [Parameter] public bool Controlled { get; set; }
    [Parameter] public double? DefaultValue { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public StepValue? Step { get; set; }
    [Parameter] public bool SnapOnStep { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool StepperDisabled { get; set; }
    [Parameter] public bool ShowInput { get; set; } = true;
    [Parameter] public NumberFormatOptions? Format { get; set; }
    [Parameter] public CultureInfo Culture { get; set; } = CultureInfo.GetCultureInfo("en-US");
    [Parameter] public Func<NumberFieldIncrementState, string?>? IncrementClass { get; set; }
    [Parameter] public Func<NumberFieldDecrementState, string?>? DecrementClass { get; set; }

    // The host's onValueChange: records the call, lets the test cancel it, and stores the value when controlled.
    [Parameter] public Action<ValueChangeEventArgs<double?>>? OnValueChange { get; set; }

    /// <summary>Gets the values every OnValueChange received, in order.</summary>
    public List<double?> Changes { get; } = [];

    /// <summary>Gets or sets a value indicating whether the next changes are canceled.</summary>
    public bool CancelChanges { get; set; }

    /// <summary>Sets the controlled value from outside, as the test's "external" button.</summary>
    public void ExternalValue(double? value)
    {
        hostValue = value;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!initialized)
        {
            initialized = true;
            hostValue = DefaultValue;
        }
    }

    private RenderFragment Parts => @<text>
        @if (Increment)
        {
            <NumberFieldIncrement Disabled="StepperDisabled" ClassValue="IncrementClass" />
        }
        else
        {
            <NumberFieldDecrement Disabled="StepperDisabled" ClassValue="DecrementClass" />
        }
        @if (ShowInput)
        {
            <NumberFieldInput />
        }
    </text>;

    private void OnChangeAsync(ValueChangeEventArgs<double?> args)
    {
        Changes.Add(args.Value);
        OnValueChange?.Invoke(args);
        if (CancelChanges)
        {
            args.Details.Cancel();
            return;
        }

        if (Controlled)
        {
            hostValue = args.Value;
        }
    }
}
