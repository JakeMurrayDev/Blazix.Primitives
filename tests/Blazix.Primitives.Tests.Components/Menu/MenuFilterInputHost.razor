@namespace Blazix.Primitives.Tests.Components
@* MenuFilterRoot.test.tsx's trees for the input's own element (MNU-API-59, DOM-21): an open filterable menu whose popup
   holds a label, the input and a list. `Disabled` disables the root, `InputDisabled` the input, `DefaultQuery` seeds the
   provider, `OnValueChange` receives its query requests, `Open` is bound to the root, `KeepMounted` keeps the closed popup and `InputClass` is the input's class
   function. *@
<MenuFilterProvider DefaultValue="@DefaultQuery" OnValueChange="OnValueChange">
    <MenuRoot TPayload="NoPayload" @bind-Open="Open" Disabled="Disabled">
        <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
        <MenuPortal KeepMounted="KeepMounted">
            <MenuPositioner>
                <MenuPopup>
                    <label for="action-filter">Filter actions</label>
                    @if (InputId is null)
                    {
                        <MenuInput aria-label="Filter actions" Disabled="InputDisabled" ClassValue="InputClass" />
                    }
                    else
                    {
                        <MenuInput id="@InputId" Disabled="InputDisabled" />
                    }
                    <MenuList>
                        <MenuItem>Rename</MenuItem>
                    </MenuList>
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>
</MenuFilterProvider>

@code {
    [Parameter]
    public string? InputId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool InputDisabled { get; set; }

    [Parameter]
    public string DefaultQuery { get; set; } = "";

    [Parameter]
    public EventCallback<ValueChangeEventArgs<string>> OnValueChange { get; set; }

    [Parameter]
    public bool Open { get; set; } = true;

    [Parameter]
    public bool KeepMounted { get; set; }

    [Parameter]
    public Func<MenuInputState, string?>? InputClass { get; set; }
}
