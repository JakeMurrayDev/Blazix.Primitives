@namespace Blazix.Primitives.Tests.Components
@* MenuFilterRoot.test.tsx's provider trees (MNU-API-54, API-56, I18N-03): an open filterable menu whose items are `Items`,
   without labels (their texts come through the List's handle). `FilterMode` is "default" (no Filter), "custom" (`Filter`)
   or "null" (a supplied null); `Culture` and `DefaultQuery` are the provider's. *@
@if (FilterMode == "custom")
{
    <MenuFilterProvider Filter="Filter" Culture="Culture" DefaultValue="@DefaultQuery">@Menu</MenuFilterProvider>
}
else if (FilterMode == "null")
{
    <MenuFilterProvider Filter="null" Culture="Culture" DefaultValue="@DefaultQuery">@Menu</MenuFilterProvider>
}
else
{
    <MenuFilterProvider Culture="Culture" DefaultValue="@DefaultQuery">@Menu</MenuFilterProvider>
}

@code {
    [Parameter]
    public string FilterMode { get; set; } = "default";

    [Parameter]
    public Func<string, string, bool>? Filter { get; set; }

    [Parameter]
    public System.Globalization.CultureInfo? Culture { get; set; }

    [Parameter]
    public string DefaultQuery { get; set; } = "";

    [Parameter]
    public string[] Items { get; set; } = ["Delete", "Rename"];

    private RenderFragment Menu => @<MenuRoot TPayload="NoPayload" DefaultOpen="true">
        <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
        <MenuPortal>
            <MenuPositioner>
                <MenuPopup>
                    <MenuInput aria-label="Filter actions" />
                    <MenuList>
                        @foreach (string item in Items)
                        {
                            <MenuItem @key="item">@item</MenuItem>
                        }
                    </MenuList>
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>;
}
