@namespace Blazix.Primitives.Tests.Components
@* MenuFilterRoot.test.tsx's renderReasonMenu and "disables filter controls when the root is disabled" (MNU-API-60, DOM-22,
   PTR-21): an open filterable menu with an input, a clear button and a list. `DefaultQuery` seeds the provider,
   `OnValueChange` receives its requests, `Disabled` disables the root and `ClearDisabled` the clear button. *@
<MenuFilterProvider DefaultValue="@DefaultQuery" OnValueChange="OnValueChange">
    <MenuRoot TPayload="NoPayload" DefaultOpen="true" Disabled="Disabled">
        <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
        <MenuPortal>
            <MenuPositioner>
                <MenuPopup>
                    <MenuInput aria-label="Filter actions" />
                    <MenuClear aria-label="Clear filter" Disabled="ClearDisabled" />
                    <MenuList>
                        <MenuItem>Rename</MenuItem>
                    </MenuList>
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>
</MenuFilterProvider>

@code {
    [Parameter]
    public string DefaultQuery { get; set; } = "";

    [Parameter]
    public EventCallback<ValueChangeEventArgs<string>> OnValueChange { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ClearDisabled { get; set; }
}
