@namespace Blazix.Primitives.Tests.Components
@* MenuFilterRoot.scoping.test.tsx's missing-input trees (MNU-EDGE-05): an open filterable menu with a list of one item,
   and a Menu.Input only when `HasInput`; with `Detached`, the trigger and the root share a handle. *@
<MenuFilterProvider>
    <MenuRoot TPayload="NoPayload" DefaultOpen="true" Handle="@(Detached ? handle : null)">
        <MenuTrigger TPayload="NoPayload" Handle="@(Detached ? handle : null)">Actions</MenuTrigger>
        <MenuPortal>
            <MenuPositioner>
                <MenuPopup>
                    @if (HasInput)
                    {
                        <MenuInput aria-label="Filter actions" />
                    }
                    <MenuList>
                        <MenuItem>Rename</MenuItem>
                    </MenuList>
                </MenuPopup>
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>
</MenuFilterProvider>

@code {
    private readonly MenuHandle<NoPayload> handle = new();

    [Parameter]
    public bool HasInput { get; set; }

    [Parameter]
    public bool Detached { get; set; }
}
