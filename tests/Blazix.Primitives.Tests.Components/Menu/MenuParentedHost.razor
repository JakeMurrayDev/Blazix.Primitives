@namespace Blazix.Primitives.Tests.Components
@* A menu under a test-only parent of `Kind` (`MenuTestParent`), open, with the Root's `Modal` when it is set. Base UI
   reaches a nested menu's ignored `modal` through a cast SubmenuRoot; the port's SubmenuRoot has no `Modal` (design point
   1, ADR 08 Amendments 2026-11-04), so the nested Root is one under a bar or a context menu. *@
<CascadingValue TValue="IMenuParentContext" Value="parent" IsFixed="true">
    <MenuRoot TPayload="NoPayload" Open="true" Modal="Modal">
        <MenuPortal>
            <MenuPositioner data-testid="positioner">
                <MenuPopup data-testid="popup" />
            </MenuPositioner>
        </MenuPortal>
    </MenuRoot>
</CascadingValue>

@code {
    private IMenuParentContext parent = null!;

    [Parameter]
    public string Kind { get; set; } = "menubar";

    [Parameter]
    public bool? Modal { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() =>
        parent = new MenuTestParent(Kind == "context-menu" ? MenuParentKind.ContextMenu : MenuParentKind.Menubar);
}
