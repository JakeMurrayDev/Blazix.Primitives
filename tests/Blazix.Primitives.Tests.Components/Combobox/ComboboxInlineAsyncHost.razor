@namespace Blazix.Primitives.Tests.Components
@* An inline Combobox over `Items` the test replaces (M5 track 11's design point 9; CMB-STA-26): DefaultOpen, AutoHighlight
   true and no filter, the Input and List under the root, and a button to blur to. *@
<ComboboxRoot TValue="string" @ref="Root" Items="@Items" Inline="true" DefaultOpen="true" AutoHighlight="true" Filter="null">
    <ComboboxInput data-testid="input" />
    <ComboboxList TValue="string">
        <ItemContent><ComboboxItem TValue="string" Value="@context.Value" @key="context.Value">@context.Value</ComboboxItem></ItemContent>
    </ComboboxList>
</ComboboxRoot>
<button type="button" data-testid="blur-target">Blur target</button>

@code {
    [Parameter]
    public IReadOnlyList<string> Items { get; set; } = [];

    /// <summary>Gets the rendered root.</summary>
    public ComboboxRoot<string>? Root { get; private set; }
}
