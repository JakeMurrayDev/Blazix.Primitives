@namespace Iodine.Headless.Tests.Components
@* The trees of MenuFilterRoot.scoping.test.tsx's and useMenuFilterSubmenuTrigger.test.tsx's popup-semantics titles
   (MNU-ARIA-01, ARIA-13, STR-14), one per `Case`:
   - `plain`: a plain open menu, trigger "Actions", whose popup holds Delete;
   - `plain-parent`: a plain open menu holding Rename and an open filterable submenu "Move to" (input "Filter folders",
     a list of Projects);
   - `detached`: a trigger "Actions" on a handle, detached from a closed filterable menu (input, a list of Rename);
   - `plain-submenu`: an open filterable menu whose list holds a plain submenu "Sort by" (Name);
   - `override-submenu`: an open filterable menu whose list holds a filterable submenu "Move to" whose trigger sets
     `aria-haspopup="menu"` (a list of Projects, no input);
   - `override-root`: a closed filterable menu whose trigger sets `aria-haspopup="menu"` (a list of Rename);
   - `popup-label`: an open filterable menu, trigger "Fruit", whose popup sets `aria-label="Available commands"`;
   - `triggerless`: an open filterable menu with no trigger (an input and a list of Rename);
   - `popup-id`: an open filterable menu, trigger "Fruit", whose popup takes `PopupId` (input, a list of Apple);
   - `empty-list-id`: an open filterable menu, trigger "Actions", whose list renders a substitute `<div id="">` (input, a list of Rename);
   - `trigger-render-id`: an open filterable menu whose trigger renders through `<button id="custom-trigger">`;
   - `popup-render-label`: an open filterable menu whose popup renders through `<section aria-label="Available commands">`. *@
@switch (Case)
{
    case "plain":
        <MenuRoot TPayload="NoPayload" DefaultOpen="true">
            <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
            <MenuPortal><MenuPositioner><MenuPopup><MenuItem>Delete</MenuItem></MenuPopup></MenuPositioner></MenuPortal>
        </MenuRoot>
        break;
    case "plain-parent":
        <MenuRoot TPayload="NoPayload" DefaultOpen="true">
            <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
            <MenuPortal>
                <MenuPositioner>
                    <MenuPopup>
                        <MenuItem>Rename</MenuItem>
                        <MenuFilterProvider>
                            <MenuSubmenuRoot DefaultOpen="true">
                                <MenuSubmenuTrigger>Move to</MenuSubmenuTrigger>
                                <MenuPortal>
                                    <MenuPositioner>
                                        <MenuPopup>
                                            <MenuInput aria-label="Filter folders" />
                                            <MenuList><MenuItem>Projects</MenuItem></MenuList>
                                        </MenuPopup>
                                    </MenuPositioner>
                                </MenuPortal>
                            </MenuSubmenuRoot>
                        </MenuFilterProvider>
                    </MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuRoot>
        break;
    case "detached":
        <MenuTrigger TPayload="NoPayload" Handle="@handle">Actions</MenuTrigger>
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" Handle="@handle">
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup>
                            <MenuInput aria-label="Filter actions" />
                            <MenuList><MenuItem>Rename</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "plain-submenu":
    case "override-submenu":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup>
                            <MenuInput aria-label="Filter actions" />
                            <MenuList>
                                @if (Case == "plain-submenu")
                                {
                                    <MenuSubmenuRoot>
                                        <MenuSubmenuTrigger>Sort by</MenuSubmenuTrigger>
                                        <MenuPortal><MenuPositioner><MenuPopup><MenuItem>Name</MenuItem></MenuPopup></MenuPositioner></MenuPortal>
                                    </MenuSubmenuRoot>
                                }
                                else
                                {
                                    <MenuFilterProvider>
                                        <MenuSubmenuRoot>
                                            <MenuSubmenuTrigger aria-haspopup="menu">Move to</MenuSubmenuTrigger>
                                            <MenuPortal><MenuPositioner><MenuPopup><MenuList><MenuItem>Projects</MenuItem></MenuList></MenuPopup></MenuPositioner></MenuPortal>
                                        </MenuSubmenuRoot>
                                    </MenuFilterProvider>
                                }
                            </MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "popup-label":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuTrigger TPayload="NoPayload">Fruit</MenuTrigger>
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup aria-label="Available commands">
                            <MenuInput aria-label="Filter fruit" />
                            <MenuList><MenuItem>Apple</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "triggerless":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup>
                            <MenuInput aria-label="Filter actions" />
                            <MenuList><MenuItem>Rename</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "popup-id":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuTrigger TPayload="NoPayload">Fruit</MenuTrigger>
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup id="@PopupId">
                            <MenuInput aria-label="Filter fruit" />
                            <MenuList><MenuItem>Apple</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "empty-list-id":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuTrigger TPayload="NoPayload">Actions</MenuTrigger>
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup>
                            <MenuInput aria-label="Filter actions" />
                            <MenuList Render="EmptyIdElement"><MenuItem>Rename</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "trigger-render-id":
    case "popup-render-label":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload" DefaultOpen="true">
                <MenuTrigger TPayload="NoPayload" Render="@(Case == "trigger-render-id" ? s_customTrigger : null)">Fruit</MenuTrigger>
                <MenuPortal>
                    <MenuPositioner>
                        <MenuPopup Render="@(Case == "popup-render-label" ? s_labelledSection : null)">
                            <MenuInput aria-label="Filter fruit" />
                            <MenuList><MenuItem>Apple</MenuItem></MenuList>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
    case "override-root":
        <MenuFilterProvider>
            <MenuRoot TPayload="NoPayload">
                <MenuTrigger TPayload="NoPayload" aria-haspopup="menu">Actions</MenuTrigger>
                <MenuPortal><MenuPositioner><MenuPopup><MenuList><MenuItem>Rename</MenuItem></MenuList></MenuPopup></MenuPositioner></MenuPortal>
            </MenuRoot>
        </MenuFilterProvider>
        break;
}

@code {
    private static readonly RenderFragment s_customTrigger = @<button id="custom-trigger"></button>;
    private static readonly RenderFragment s_labelledSection = @<section aria-label="Available commands"></section>;
    private readonly MenuHandle<NoPayload> handle = new();

    [Parameter]
    public string? Case { get; set; }

    [Parameter]
    public string? PopupId { get; set; }

    // Base UI's `render={<div id="" />}`.
    private static readonly RenderFragment EmptyIdElement = builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "id", string.Empty);
        builder.CloseElement();
    };
}
