@namespace Iodine.Headless.Tests.Components
@* DrawerRoot.test.tsx "supports detached triggers with handles" and "supports imperative actions with handles": two detached
   triggers on one handle with the payloads 1 and 2, then the handle-backed root, whose popup renders the payload and a
   Close. *@
<div>
    <DrawerTrigger TPayload="int?" Handle="Handle" id="trigger-1" Payload="1">Trigger 1</DrawerTrigger>
    <DrawerTrigger TPayload="int?" Handle="Handle" id="trigger-2" Payload="2">Trigger 2</DrawerTrigger>
    <DrawerRoot TPayload="int?" Handle="Handle">
        <PayloadContent Context="payload">
            <DrawerPortal>
                <DrawerViewport>
                    <DrawerPopup data-testid="content">
                        <span data-testid="payload">@payload</span>
                        <DrawerClose data-testid="close">Close</DrawerClose>
                    </DrawerPopup>
                </DrawerViewport>
            </DrawerPortal>
        </PayloadContent>
    </DrawerRoot>
</div>

@code {
    public DrawerHandle<int?> Handle { get; } = new();
}
