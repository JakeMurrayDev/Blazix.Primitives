@namespace Iodine.Headless.Tests.Components
@* DrawerRoot.test.tsx's single-root trees. "exposes the attributes rendered by borrowed trigger and close parts" (WithPopup
   false): a root with an enabled and a disabled trigger and a disabled Close, and no popup. "synchronizes trigger
   aria-controls with the popup id" (WithPopup true): a root with one trigger and its popup inside a portal and a viewport. *@
<DrawerRoot TPayload="NoPayload" Modal="Modal">
    <DrawerTrigger id="open">Open</DrawerTrigger>
    @if (WithPopup)
    {
        <DrawerPortal>
            <DrawerViewport>
                <DrawerPopup data-testid="popup">Drawer</DrawerPopup>
            </DrawerViewport>
        </DrawerPortal>
    }
    else
    {
        <DrawerTrigger id="disabled" Disabled="true">Disabled</DrawerTrigger>
        <DrawerClose data-testid="close" Disabled="true">Close</DrawerClose>
    }
</DrawerRoot>

@code {
    [Parameter] public ModalValue? Modal { get; set; }

    [Parameter] public bool WithPopup { get; set; }
}
