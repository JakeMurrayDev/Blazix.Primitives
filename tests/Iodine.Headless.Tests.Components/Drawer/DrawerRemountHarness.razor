@namespace Iodine.Headless.Tests.Components
@* DrawerRoot.test.tsx "attaches fresh root state when a handle-backed root remounts": a persistent detached trigger with the
   payload 1, and a handle-backed root that renders its payload outside its portal and can be unmounted from its popup and
   remounted. *@
<DrawerTrigger TPayload="int?" Handle="Handle" id="trigger" Payload="1">Trigger</DrawerTrigger>
@if (!mounted)
{
    <button type="button" data-testid="remount" @onclick="() => mounted = true">Remount root</button>
}
@if (mounted)
{
    <DrawerRoot TPayload="int?" Handle="Handle">
        <PayloadContent Context="payload">
            <span data-testid="payload">@(payload?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "No payload")</span>
            <DrawerPortal>
                <DrawerViewport>
                    <DrawerPopup>
                        Drawer content
                        <button type="button" data-testid="unmount" @onclick="() => mounted = false">Unmount root</button>
                    </DrawerPopup>
                </DrawerViewport>
            </DrawerPortal>
        </PayloadContent>
    </DrawerRoot>
}

@code {
    private bool mounted = true;

    public DrawerHandle<int?> Handle { get; } = new();
}
