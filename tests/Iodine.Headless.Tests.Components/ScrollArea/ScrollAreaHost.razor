@namespace Iodine.Headless.Tests.Components
@using Iodine.Headless

@*
    The ScrollArea tests' host: a root with a viewport and its content, a vertical and a horizontal scrollbar with their
    thumbs, and a corner, each with a data-testid. The parameters toggle what a test needs.
*@
<ScrollAreaRoot OverflowEdgeThreshold="@Threshold" ClassValue="@RootClass" data-testid="root">
    <ScrollAreaViewport data-testid="viewport" @attributes="Attributes(ViewportStyle)" ClassValue="@ViewportClass">
        <ScrollAreaContent data-testid="content" ClassValue="@ContentClass">content</ScrollAreaContent>
    </ScrollAreaViewport>
    <ScrollAreaScrollbar KeepMounted="@KeepMounted" data-testid="scrollbar-y" ClassValue="@ScrollbarClass" @attributes="Attributes(ScrollbarStyle)">
        <ScrollAreaThumb data-testid="thumb-y" ClassValue="@ThumbClass" @attributes="Attributes(ThumbStyle)" />
    </ScrollAreaScrollbar>
    @if (Horizontal)
    {
        <ScrollAreaScrollbar Orientation="Iodine.Headless.Orientation.Horizontal" KeepMounted="@KeepMounted" data-testid="scrollbar-x">
            <ScrollAreaThumb data-testid="thumb-x" />
        </ScrollAreaScrollbar>
    }
    @if (Corner)
    {
        <ScrollAreaCorner data-testid="corner" @attributes="Attributes(CornerStyle, CornerAriaHidden)" />
    }
</ScrollAreaRoot>

@code {
    [Parameter] public OverflowEdgeThresholdValue? Threshold { get; set; }

    [Parameter] public bool KeepMounted { get; set; }

    [Parameter] public bool Horizontal { get; set; } = true;

    [Parameter] public bool Corner { get; set; } = true;

    [Parameter] public string? CornerAriaHidden { get; set; } = null;

    [Parameter] public string? CornerStyle { get; set; }

    [Parameter] public string? ViewportStyle { get; set; }

    [Parameter] public string? ScrollbarStyle { get; set; }

    [Parameter] public string? ThumbStyle { get; set; }

    [Parameter] public Func<ScrollAreaRootState, string?>? RootClass { get; set; }

    [Parameter] public Func<ScrollAreaViewportState, string?>? ViewportClass { get; set; }

    [Parameter] public Func<ScrollAreaContentState, string?>? ContentClass { get; set; }

    [Parameter] public Func<ScrollAreaScrollbarState, string?>? ScrollbarClass { get; set; }

    [Parameter] public Func<ScrollAreaThumbState, string?>? ThumbClass { get; set; }

    private static Dictionary<string, object> Attributes(string? style, string? ariaHidden = null)
    {
        Dictionary<string, object> attributes = [];
        if (style is not null)
        {
            attributes["style"] = style;
        }

        if (ariaHidden is not null)
        {
            attributes["aria-hidden"] = ariaHidden;
        }

        return attributes;
    }
}
