@namespace Blazix.Primitives.Tests.Components
@*
    ToastProvider.test.tsx's App: a Provider whose Timeout and Limit a test changes in the same render that activates a
    descendant which adds toasts from its parameter set, and a descendant that records the store's toasts in the same pass.
*@

<ToastProvider TData="NoPayload" Timeout="Timeout" Limit="Limit">
    <ToastAdder Active="Active" Toasts="Toasts" />
    <ToastObserver Active="Active" Observed="Observed" />
</ToastProvider>

@code {
    [Parameter]
    public Duration? Timeout { get; set; }

    [Parameter]
    public int Limit { get; set; } = 3;

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public IReadOnlyList<ToastObject>? Toasts { get; set; }

    [Parameter]
    public List<IReadOnlyList<(string Id, bool Limited)>>? Observed { get; set; }
}
