@namespace Iodine.Headless.Tests.Components
@*
    ToastRoot.test.tsx's "keeps dynamic title and description ids synchronized with mounted label parts": a Root whose
    Title and Description fall back to the toast's text, take explicit children, are removed, and come back.
*@

<ToastProvider TData="NoPayload">
    <ToastViewport>
        <ToastRoot Toast="Toast" data-testid="root">
            @if (Mode != "none")
            {
                @* Base UI's `{explicit ? 'Explicit title' : undefined}`: in Razor, undefined children are no ChildContent. *@
                @if (Mode == "explicit")
                {
                    <ToastTitle data-testid="title">Explicit title</ToastTitle>
                    <ToastDescription data-testid="description">Explicit description</ToastDescription>
                }
                else
                {
                    <ToastTitle data-testid="title" />
                    <ToastDescription data-testid="description" />
                }
            }
        </ToastRoot>
    </ToastViewport>
</ToastProvider>

@code {
    [Parameter]
    public ToastObject Toast { get; set; } = null!;

    [Parameter]
    public string Mode { get; set; } = "fallback";
}
