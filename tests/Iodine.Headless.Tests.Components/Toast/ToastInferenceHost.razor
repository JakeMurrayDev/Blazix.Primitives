@namespace Blazix.Primitives.Tests.Components
@*
    The root's TData inferred through its Toast parameter (ADR 08 Amendments 2026-11-18): ToastRootOnly writes no TData
    and sees no cascading type parameter; the Provider here supplies only the runtime context.
*@

<ToastProvider TData="NoPayload">
    <ToastViewport>
        <ToastRootOnly Toast="Toast" />
    </ToastViewport>
</ToastProvider>

@code {
    [Parameter]
    public ToastObject Toast { get; set; } = null!;
}
