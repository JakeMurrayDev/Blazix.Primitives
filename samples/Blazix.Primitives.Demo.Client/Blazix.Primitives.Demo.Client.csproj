<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The demo pages, WebAssembly-capable, referenced by the host. Never packed. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <!-- The library's development warnings are on in a Debug build, as a consumer's app would have them. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <RuntimeHostConfigurationOption Include="Blazix.Primitives.DevelopmentWarnings" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blazix.Primitives\Blazix.Primitives.csproj" />
  </ItemGroup>

</Project>
