<DemoFrame Slug="accordion" Note="The same accordion with Multiple, so several items stay open, and with HiddenUntilFound, so the browser's find-in-page (Ctrl+F or Cmd+F) finds the closed answers and opens them.">
    <Hero>
        <AccordionRoot TValue="string" class="@RootClass">
            <AccordionItem>
                <AccordionHeader>
                    <AccordionTrigger class="@TriggerClass">
                        What is Base UI?
                        <PlusIcon class="@IconClass" />
                    </AccordionTrigger>
                </AccordionHeader>
                <AccordionPanel class="@PanelClass">
                    <div class="px-3 py-2">
                        Base UI is a library of high-quality unstyled React components for design systems and
                        web apps.
                    </div>
                </AccordionPanel>
            </AccordionItem>

            <AccordionItem class="@ItemClass">
                <AccordionHeader>
                    <AccordionTrigger class="@TriggerClass">
                        How do I get started?
                        <PlusIcon class="@IconClass" />
                    </AccordionTrigger>
                </AccordionHeader>
                <AccordionPanel class="@PanelClass">
                    <div class="px-3 py-2">
                        Head to the “Quick start” guide in the docs. If you’ve used unstyled libraries before,
                        you’ll feel at home.
                    </div>
                </AccordionPanel>
            </AccordionItem>

            <AccordionItem class="@ItemClass">
                <AccordionHeader>
                    <AccordionTrigger class="@TriggerClass">
                        Can I use it for my project?
                        <PlusIcon class="@IconClass" />
                    </AccordionTrigger>
                </AccordionHeader>
                <AccordionPanel class="@PanelClass">
                    <div class="px-3 py-2">Of course! Base UI is free and open source.</div>
                </AccordionPanel>
            </AccordionItem>
        </AccordionRoot>
    </Hero>
    <Variants>
        <div class="Variant">
            <span class="VariantName">Multiple</span>
            <AccordionRoot TValue="string" Multiple="true" class="@RootClass">
                @foreach ((string question, string answer) in Faq)
                {
                    <AccordionItem class="@(question == Faq[0].Question ? null : ItemClass)">
                        <AccordionHeader>
                            <AccordionTrigger class="@TriggerClass">
                                @question
                                <PlusIcon class="@IconClass" />
                            </AccordionTrigger>
                        </AccordionHeader>
                        <AccordionPanel class="@PanelClass">
                            <div class="px-3 py-2">@answer</div>
                        </AccordionPanel>
                    </AccordionItem>
                }
            </AccordionRoot>
        </div>
        <div class="Variant">
            <span class="VariantName">HiddenUntilFound</span>
            <AccordionRoot TValue="string" HiddenUntilFound="true" class="@RootClass">
                @foreach ((string question, string answer) in Faq)
                {
                    <AccordionItem class="@(question == Faq[0].Question ? null : ItemClass)">
                        <AccordionHeader>
                            <AccordionTrigger class="@TriggerClass">
                                @question
                                <PlusIcon class="@IconClass" />
                            </AccordionTrigger>
                        </AccordionHeader>
                        <AccordionPanel class="@PanelClass">
                            <div class="px-3 py-2">@answer</div>
                        </AccordionPanel>
                    </AccordionItem>
                }
            </AccordionRoot>
        </div>
    </Variants>
</DemoFrame>

@code {
    private const string RootClass = "flex w-full max-w-80 flex-col border border-neutral-950 text-neutral-950 dark:border-white dark:text-white";
    private const string ItemClass = "border-t border-neutral-950 dark:border-white";
    private const string TriggerClass = "group flex w-full items-center justify-between gap-4 bg-transparent px-3 py-2 text-left text-sm font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 focus-visible:relative focus-visible:z-1 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800";
    private const string IconClass = "shrink-0 transition-transform duration-100 ease-[ease-out] group-data-panel-open:rotate-45";
    private const string PanelClass = "h-[var(--accordion-panel-height)] overflow-hidden text-sm transition-[height] duration-150 ease-[ease-out] data-ending-style:h-0 data-starting-style:h-0";

    // The `multiple` and `hidden-until-found` demos' four items (demos/multiple/tailwind/index.tsx).
    private static readonly (string Question, string Answer)[] Faq =
    [
        ("How long does shipping take?", "Standard shipping takes 3–5 business days. Express delivery arrives in 1–2 business days."),
        ("What is your return policy?", "You can return any item within 30 days of delivery. Opened items may be subject to a 10% restocking fee."),
        ("Do you ship internationally?", "Yes, we ship to over 40 countries. International orders typically arrive within 7–14 business days."),
        ("How can I track my order?", "Once your order ships, you’ll receive a tracking link by email. Tracking updates can take up to 24 hours to appear."),
    ];
}
