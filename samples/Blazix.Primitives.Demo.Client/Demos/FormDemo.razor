<DemoFrame Slug="form" Note="The server answer arrives after one second; any other domain than example.com is accepted.">
    <Hero>
        <Form class="flex w-full max-w-64 flex-col gap-4" Errors="errors" OnFormSubmit="SubmitAsync">
            <FieldRoot Name="url" class="flex flex-col items-start gap-1">
                <FieldLabel class="text-sm font-bold text-neutral-950 dark:text-white">
                    Homepage
                </FieldLabel>
                <FieldControl type="url"
                              required
                              DefaultValue="https://example.com"
                              placeholder="https://example.com"
                              pattern="https?://.*"
                              class="@ControlClass" />
                <FieldError class="text-sm text-red-700 dark:text-red-400" />
            </FieldRoot>
            <Button Disabled="loading" FocusableWhenDisabled="true" type="submit" class="@ButtonClass">
                Submit
            </Button>
        </Form>
    </Hero>
    <Variants>
        @if (accepted is not null)
        {
            <p class="text-sm text-neutral-600 dark:text-neutral-400">Accepted: @accepted</p>
        }
    </Variants>
</DemoFrame>

@code {
    private const string ControlClass = "h-8 w-full border border-neutral-950 bg-white dark:bg-neutral-950 px-2 text-sm any-pointer-coarse:text-base font-normal text-neutral-950 placeholder:text-neutral-500 focus:outline-2 focus:-outline-offset-1 focus:outline-neutral-950 dark:focus:outline-white dark:border-white dark:text-white dark:placeholder:text-neutral-400";
    private const string ButtonClass = "flex h-8 items-center justify-center gap-2 rounded-none border border-neutral-950 bg-white px-3 text-sm leading-none whitespace-nowrap font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 active:not-data-disabled:bg-neutral-200 focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white data-disabled:border-neutral-500 data-disabled:text-neutral-500 disabled:border-neutral-500 disabled:text-neutral-500 dark:border-white dark:bg-neutral-950 dark:text-white dark:hover:not-data-disabled:bg-neutral-800 dark:active:not-data-disabled:bg-neutral-700 dark:data-disabled:border-neutral-400 dark:data-disabled:text-neutral-400";

    private FormErrors errors = new();
    private bool loading;
    private string? accepted;

    // The demo's onSubmit with preventDefault() and FormData becomes OnFormSubmit, which never lets the browser submit and
    // hands over the fields' values.
    private async Task SubmitAsync(FormSubmitEventArgs args)
    {
        string value = args.Values.TryGetValue("url", out object? url) && url is string text ? text : string.Empty;
        loading = true;
        accepted = null;
        string? error = await SubmitFormAsync(value);
        errors = new FormErrors { ["url"] = error };
        accepted = error is null ? value : null;
        loading = false;
    }

    // Mimics a server response.
    private static async Task<string?> SubmitFormAsync(string value)
    {
        await Task.Delay(1000);
        if (!Uri.TryCreate(value, UriKind.Absolute, out Uri? url))
        {
            return "This is not a valid URL";
        }

        return url.Host.EndsWith("example.com", StringComparison.OrdinalIgnoreCase) ? "The example domain is not allowed" : null;
    }
}
