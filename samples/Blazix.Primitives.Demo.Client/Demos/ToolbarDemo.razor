<DemoFrame Slug="toolbar" Note="The arrow keys move between the items and Tab leaves the toolbar. The documentation's hero also has a font picker, which returns with Select in M5.">
    <Hero>
        <ToolbarRoot class="flex w-150 items-center gap-px border border-neutral-950 bg-white p-px dark:border-white dark:bg-neutral-950">
            <ToggleGroup class="flex gap-px" aria-label="Alignment">
                <ToolbarButton Render="s_toggle" aria-label="Align left" value="align-left" class="@ToggleButtonClass">Align Left</ToolbarButton>
                <ToolbarButton Render="s_toggle" aria-label="Align right" value="align-right" class="@ToggleButtonClass">Align Right</ToolbarButton>
            </ToggleGroup>
            <ToolbarSeparator class="@SeparatorClass" />
            <ToolbarGroup class="flex gap-px" aria-label="Numerical format">
                <ToolbarButton class="@ButtonClass" aria-label="Format as currency">$</ToolbarButton>
                <ToolbarButton class="@ButtonClass" aria-label="Format as percent">%</ToolbarButton>
            </ToolbarGroup>
            <ToolbarSeparator class="@SeparatorClass" />
            <ToolbarLink class="mr-[0.875rem] ml-auto flex-none self-center font-[inherit] text-sm text-neutral-500 no-underline hover:text-blue-700 dark:text-neutral-400 dark:hover:text-blue-500 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white" href="#">
                Edited 51m ago
            </ToolbarLink>
        </ToolbarRoot>
    </Hero>
    <Variants>
        <div class="Variant">
            <ToolbarRoot Orientation="Orientation.Vertical" class="@VerticalRootClass" aria-label="Vertical">
                <ToolbarButton class="@ButtonClass" aria-label="Format as currency">$</ToolbarButton>
                <ToolbarButton class="@ButtonClass" aria-label="Format as percent">%</ToolbarButton>
                <ToolbarSeparator class="@HorizontalSeparatorClass" />
                <ToolbarButton class="@ButtonClass" aria-label="Clear format">×</ToolbarButton>
            </ToolbarRoot>
            <span class="VariantName">Orientation="Orientation.Vertical" (the up and down arrows; the separator turns horizontal)</span>
        </div>
        <div class="Variant">
            <ToolbarRoot class="@RootClass" aria-label="Formatting">
                <ToolbarGroup Disabled="true" class="flex gap-px" aria-label="Numerical format">
                    <ToolbarButton class="@DisabledButtonClass" aria-label="Format as currency">$</ToolbarButton>
                    <ToolbarButton class="@DisabledButtonClass" aria-label="Format as percent">%</ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator class="@SeparatorClass" />
                <ToolbarButton class="@ButtonClass" aria-label="Bold">B</ToolbarButton>
            </ToolbarRoot>
            <span class="VariantName">A disabled group: its buttons stay focusable, with aria-disabled</span>
        </div>
        <div class="Variant">
            <ToolbarRoot class="@RootClass" aria-label="Search">
                <ToolbarButton class="@ButtonClass" aria-label="Previous">‹</ToolbarButton>
                <ToolbarInput DefaultValue="toolbar" aria-label="Find" class="@InputClass" />
                <ToolbarButton class="@ButtonClass" aria-label="Next">›</ToolbarButton>
            </ToolbarRoot>
            <span class="VariantName">An input: the arrows move the caret, and leave the input at either end of its text</span>
        </div>
    </Variants>
</DemoFrame>

@code {
    private const string ButtonClass = "flex h-8 min-w-8 items-center justify-center gap-2 border-0 bg-transparent font-[inherit] text-sm leading-none whitespace-nowrap font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 active:not-data-disabled:not-data-pressed:bg-neutral-200 data-pressed:bg-neutral-950 data-pressed:text-white data-pressed:hover:not-data-disabled:bg-neutral-950 data-pressed:hover:not-data-disabled:text-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800 dark:active:not-data-disabled:not-data-pressed:bg-neutral-700 dark:data-pressed:bg-white dark:data-pressed:text-neutral-950 dark:data-pressed:hover:not-data-disabled:bg-white dark:data-pressed:hover:not-data-disabled:text-neutral-950 focus-visible:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white";
    private const string ToggleButtonClass = "flex h-8 min-w-8 items-center justify-center gap-2 border-0 bg-transparent px-3 font-[inherit] text-sm leading-none whitespace-nowrap font-normal text-neutral-950 select-none hover:not-data-disabled:bg-neutral-100 active:not-data-disabled:not-data-pressed:bg-neutral-200 data-pressed:bg-neutral-950 data-pressed:text-white data-pressed:hover:not-data-disabled:bg-neutral-950 data-pressed:hover:not-data-disabled:text-white dark:text-white dark:hover:not-data-disabled:bg-neutral-800 dark:active:not-data-disabled:not-data-pressed:bg-neutral-700 dark:data-pressed:bg-white dark:data-pressed:text-neutral-950 dark:data-pressed:hover:not-data-disabled:bg-white dark:data-pressed:hover:not-data-disabled:text-neutral-950 focus-visible:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white";
    private const string SeparatorClass = "m-1 h-4 w-px bg-neutral-950 dark:bg-white";

    // The hero's classes, for the variants: a root without its fixed width, a stacked root, a horizontal separator, a dimmed
    // disabled button and an input sized like the buttons.
    private const string RootClass = "flex items-center gap-px border border-neutral-950 bg-white p-px dark:border-white dark:bg-neutral-950";
    private const string VerticalRootClass = "flex w-fit flex-col items-stretch gap-px border border-neutral-950 bg-white p-px dark:border-white dark:bg-neutral-950";
    private const string HorizontalSeparatorClass = "m-1 h-px w-4 self-center bg-neutral-950 dark:bg-white";
    private const string DisabledButtonClass = ButtonClass + " data-disabled:opacity-50";
    private const string InputClass = "h-8 w-32 border-0 bg-transparent px-2 font-[inherit] text-sm text-neutral-950 dark:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white";

    // Base UI's render={<Toggle />}: the toolbar button's attributes, its value among them, reach the toggle as parameters.
    private static readonly RenderFragment s_toggle = @<Toggle />;
}
