@implements IDisposable

<DemoFrame Slug="progress" Note="The same progress bar with its value under your control: restart the simulation or make it indeterminate.">
    <Hero>
        <ProgressRoot class="@RootClass" Value="value">
            <ProgressLabel class="@LabelClass">Export data</ProgressLabel>
            <ProgressValue class="@ValueClass" />
            <ProgressTrack class="@TrackClass">
                <ProgressIndicator class="@IndicatorClass" />
            </ProgressTrack>
        </ProgressRoot>
    </Hero>
    <Variants>
        <div class="Controls">
            <button type="button" class="Control" @onclick="Restart">Restart</button>
            <button type="button" class="Control" @onclick="MakeIndeterminate">Indeterminate</button>
        </div>
    </Variants>
</DemoFrame>

@code {
    private const string RootClass = "grid max-w-full w-60 grid-cols-2 gap-y-2";
    private const string LabelClass = "text-sm font-normal text-neutral-950 dark:text-white";
    private const string ValueClass = "text-right text-sm text-neutral-950 dark:text-white";
    private const string TrackClass = "col-span-2 h-1 overflow-hidden bg-neutral-200 dark:bg-neutral-800";
    private const string IndicatorClass = "bg-neutral-950 transition-[width] duration-500 dark:bg-white";

    private readonly Random random = new();
    private Timer? timer;
    private double? value = 20;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Simulate changes: from the first interactive render on, not while prerendering.
            timer = new Timer(_ => InvokeAsync(Advance), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    private void Advance()
    {
        // An indeterminate bar (no value) stays indeterminate until Restart.
        if (value is double current)
        {
            value = Math.Min(100, Math.Round(current + random.NextDouble() * 25));
            StateHasChanged();
        }
    }

    private void Restart() => value = 20;

    private void MakeIndeterminate() => value = null;

    public void Dispose() => timer?.Dispose();
}
