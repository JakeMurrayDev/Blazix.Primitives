<DemoFrame Slug="switch" Note="The switch controlled from outside, read-only, disabled, and rendered as a native button.">
    <Hero>
        <label class="@LabelClass">
            <SwitchRoot DefaultChecked="true" class="@RootClass">
                <SwitchThumb class="@ThumbClass" />
            </SwitchRoot>
            Notifications
        </label>
    </Hero>
    <Variants>
        <div class="Variant">
            <label class="@LabelClass">
                <SwitchRoot class="@RootClass" @bind-Checked="controlled">
                    <SwitchThumb class="@ThumbClass" />
                </SwitchRoot>
                Controlled
            </label>
            <button type="button" class="Control" @onclick="() => controlled = !controlled">Toggle from outside</button>
            <span class="VariantName">checked: <strong data-checked-state>@(controlled ? "true" : "false")</strong></span>
        </div>
        <div class="Variant">
            <label class="@LabelClass">
                <SwitchRoot DefaultChecked="true" ReadOnly="true" class="@RootClass">
                    <SwitchThumb class="@ThumbClass" />
                </SwitchRoot>
                Read-only
            </label>
            <span class="VariantName">ReadOnly (focusable, not togglable)</span>
        </div>
        <div class="Variant">
            <label class="@LabelClass">
                <SwitchRoot Disabled="true" class="@RootClass">
                    <SwitchThumb class="@ThumbClass" />
                </SwitchRoot>
                Disabled
            </label>
            <span class="VariantName">Disabled</span>
        </div>
        <div class="Variant">
            <label class="@LabelClass" for="native-switch">Native button</label>
            <SwitchRoot id="native-switch" NativeButton="true" class="@RootClass">
                <Render><button></button></Render>
                <ChildContent><SwitchThumb class="@ThumbClass" /></ChildContent>
            </SwitchRoot>
            <span class="VariantName">NativeButton="true" (a button named by the label's for)</span>
        </div>
    </Variants>
</DemoFrame>

@code {
    private const string LabelClass = "flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white";
    private const string RootClass = "flex h-5 w-9 shrink-0 border border-neutral-950 bg-white p-0.5 transition-colors duration-150 ease-[ease] dark:border-white dark:bg-neutral-950 data-checked:bg-neutral-950 dark:data-checked:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white";
    private const string ThumbClass = "size-3.5 bg-neutral-950 transition-[translate,background-color] duration-150 ease-[ease] data-checked:translate-x-4 data-checked:bg-white dark:bg-white dark:data-checked:bg-neutral-950";

    private bool controlled;
}
