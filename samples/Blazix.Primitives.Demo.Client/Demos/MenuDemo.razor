<DemoFrame Slug="menu" Note="Press the trigger, or press and drag onto an item and release. The arrow keys move the highlight, typing a letter jumps to an item, Enter or Space activates it, and Escape closes the menu.">
    <Hero>
        <MenuRoot TPayload="NoPayload">
            <MenuTrigger class="@TriggerClass">
                Song <CaretDownIcon />
            </MenuTrigger>
            <MenuPortal>
                <MenuPositioner class="outline-hidden" SideOffset="8" Align="Align.Start">
                    <MenuPopup class="@PopupClass">
                        <MenuItem class="@ItemClass">Add to Library</MenuItem>
                        <MenuItem class="@ItemClass">Add to Playlist</MenuItem>
                        <MenuSeparator class="@SeparatorClass" />
                        <MenuItem class="@ItemClass">Play Next</MenuItem>
                        <MenuItem class="@ItemClass">Play Last</MenuItem>
                        <MenuSeparator class="@SeparatorClass" />
                        <MenuItem class="@ItemClass">Favorite</MenuItem>
                        <MenuItem class="@ItemClass">Share</MenuItem>
                    </MenuPopup>
                </MenuPositioner>
            </MenuPortal>
        </MenuRoot>
    </Hero>
    <Variants>
        <div class="Variant">
            <MenuRoot TPayload="NoPayload">
                <MenuTrigger class="@TriggerClass">
                    View <CaretDownIcon />
                </MenuTrigger>
                <MenuPortal>
                    <MenuPositioner class="outline-hidden" SideOffset="8" Align="Align.Start">
                        <MenuPopup class="@PopupClass">
                            <MenuCheckboxItem class="@CheckableItemClass" @bind-Checked="showMinimap">
                                <MenuCheckboxItemIndicator class="@IndicatorClass">
                                    <CheckIcon />
                                </MenuCheckboxItemIndicator>
                                <span class="col-start-2">Minimap</span>
                            </MenuCheckboxItem>
                            <MenuCheckboxItem class="@CheckableItemClass" @bind-Checked="showSearch">
                                <MenuCheckboxItemIndicator class="@IndicatorClass">
                                    <CheckIcon />
                                </MenuCheckboxItemIndicator>
                                <span class="col-start-2">Search</span>
                            </MenuCheckboxItem>
                            <MenuSeparator class="@SeparatorClass" />
                            <MenuSubmenuRoot>
                                <MenuSubmenuTrigger class="@SubmenuTriggerClass">
                                    Sort by <CaretRightIcon />
                                </MenuSubmenuTrigger>
                                <MenuPortal>
                                    <MenuPositioner class="outline-hidden" AlignOffset="-4" SideOffset="-4">
                                        <MenuPopup class="@PopupClass">
                                            <MenuRadioGroup @bind-Value="sortBy">
                                                @foreach (string option in s_sortOptions)
                                                {
                                                    <MenuRadioItem class="@CheckableItemClass" Value="option">
                                                        <MenuRadioItemIndicator class="@IndicatorClass">
                                                            <CheckIcon />
                                                        </MenuRadioItemIndicator>
                                                        <span class="col-start-2">@option</span>
                                                    </MenuRadioItem>
                                                }
                                            </MenuRadioGroup>
                                        </MenuPopup>
                                    </MenuPositioner>
                                </MenuPortal>
                            </MenuSubmenuRoot>
                        </MenuPopup>
                    </MenuPositioner>
                </MenuPortal>
            </MenuRoot>
            <span class="VariantName">Checkbox items, and a submenu of radio items: minimap @(showMinimap ? "on" : "off"), search @(showSearch ? "on" : "off"), sorted by @sortBy</span>
        </div>
        <div class="Variant">
            <MenuFilterProvider @bind-Value="filterQuery">
                <MenuRoot TPayload="NoPayload">
                    <MenuTrigger class="@TriggerClass">
                        Actions <CaretDownIcon />
                    </MenuTrigger>
                    <MenuPortal>
                        <MenuPositioner class="outline-hidden" SideOffset="8" Align="Align.Start">
                            <MenuPopup class="@FilterPopupClass">
                                <div class="@FilterInputContainerClass">
                                    <MenuInput class="@FilterInputClass" aria-label="Filter actions" placeholder="e.g. Save" />
                                    <MenuClear class="@FilterClearClass">
                                        <XIcon />
                                    </MenuClear>
                                </div>
                                <MenuEmpty class="@FilterEmptyClass">No actions found.</MenuEmpty>
                                <MenuList class="@FilterListClass">
                                    <MenuGroup>
                                        <MenuGroupLabel class="@FilterGroupLabelClass">File</MenuGroupLabel>
                                        <MenuItem class="@FilterItemClass">New file</MenuItem>
                                        <MenuItem class="@FilterItemClass">Open file</MenuItem>
                                        <MenuItem class="@FilterItemClass">Save</MenuItem>
                                        <MenuItem class="@FilterItemClass">Save as</MenuItem>
                                        <MenuItem class="@FilterItemClass">Duplicate</MenuItem>
                                        <MenuItem class="@FilterItemClass">Rename</MenuItem>
                                    </MenuGroup>
                                    <MenuGroup>
                                        <MenuGroupLabel class="@FilterGroupLabelClass">Organize</MenuGroupLabel>
                                        <MenuItem class="@FilterItemClass">Download a copy</MenuItem>
                                        <MenuItem class="@FilterItemClass">Delete</MenuItem>
                                    </MenuGroup>
                                </MenuList>
                            </MenuPopup>
                        </MenuPositioner>
                    </MenuPortal>
                </MenuRoot>
            </MenuFilterProvider>
            <span class="VariantName">A filterable menu: type in the input to filter the actions; the arrow keys move the highlight while the input keeps focus. Query: "@filterQuery"</span>
        </div>
    </Variants>
</DemoFrame>

