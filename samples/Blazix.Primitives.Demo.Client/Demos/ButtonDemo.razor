<div class="DemoScope">
    <DemoFrame Slug="button" Note="The variants of the Button part: a click counter, disabled, disabled but focusable, a loading state that disables the button after a click, and a non-native button rendered as a span.">
        <Hero>
            <Button class="Button">Submit</Button>
        </Hero>
        <Variants>
            <div class="Variant">
                <Button class="Button" @onclick="() => clicks++">Clicked @clicks @(clicks == 1 ? "time" : "times")</Button>
                <span class="VariantName">enabled</span>
            </div>
            <div class="Variant">
                <Button class="Button" Disabled="true">Disabled</Button>
                <span class="VariantName">Disabled</span>
            </div>
            <div class="Variant">
                <Button class="Button" Disabled="true" FocusableWhenDisabled="true">Focusable</Button>
                <span class="VariantName">Disabled + FocusableWhenDisabled</span>
            </div>
            <div class="Variant">
                <Button class="Button" Disabled="@loading" FocusableWhenDisabled="true" @onclick="Save">@(loading ? "Saving…" : "Save")</Button>
                <span class="VariantName">loading (disabled for two seconds after a click)</span>
            </div>
            <div class="Variant">
                <Button class="Button" NativeButton="false" @onclick="() => spanClicks++">
                    <Render><span></span></Render>
                    <ChildContent>Span clicked @spanClicks</ChildContent>
                </Button>
                <span class="VariantName">NativeButton="false" (a span with role="button")</span>
            </div>
        </Variants>
    </DemoFrame>
</div>

@code {
    private int clicks;
    private int spanClicks;
    private bool loading;

    private async Task Save()
    {
        loading = true;
        await Task.Delay(TimeSpan.FromSeconds(2));
        loading = false;
    }
}
