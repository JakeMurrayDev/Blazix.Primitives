<DemoFrame Slug="navigation-menu" Note="Rest the pointer on a trigger or click it to open its panel; moving to the other trigger slides the content across and resizes the popup. The arrow keys move between the triggers and ArrowDown opens a panel; Escape, a press outside or leaving the menu closes it. Tab does not reach the panel's links yet; that arrives with the links' registration in the list navigation.">
    <Hero>
        <NavigationMenuRoot TValue="string" class="min-w-max text-neutral-950 dark:text-white">
            <NavigationMenuList class="relative flex gap-px">
                <NavigationMenuItem TValue="string">
                    <NavigationMenuTrigger class="@TriggerClass">
                        Overview
                        <NavigationMenuIcon class="transition-transform duration-200 ease-[ease] data-popup-open:rotate-180">
                            <CaretDownIcon />
                        </NavigationMenuIcon>
                    </NavigationMenuTrigger>
                    <NavigationMenuContent class="@ContentClass">
                        <ul class="m-0 grid list-none grid-cols-2 p-0 max-[500px]:grid-cols-1">
                            @foreach (DemoLink link in s_overviewLinks)
                            {
                                <li @key="link.Href">
                                    <NavigationMenuLink href="@link.Href" class="@LinkCardClass">
                                        <h3 class="m-0 mb-1 text-sm leading-4 font-normal">@link.Title</h3>
                                        <p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">@link.Description</p>
                                    </NavigationMenuLink>
                                </li>
                            }
                        </ul>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <NavigationMenuItem TValue="string">
                    <NavigationMenuTrigger class="@TriggerClass">
                        Handbook
                        <NavigationMenuIcon class="transition-transform duration-200 ease-[ease] data-popup-open:rotate-180">
                            <CaretDownIcon />
                        </NavigationMenuIcon>
                    </NavigationMenuTrigger>
                    <NavigationMenuContent class="@ContentClass">
                        <ul class="m-0 flex max-w-[400px] list-none flex-col justify-center p-0">
                            @foreach (DemoLink link in s_handbookLinks)
                            {
                                <li @key="link.Href">
                                    <NavigationMenuLink href="@link.Href" class="@LinkCardClass">
                                        <h3 class="m-0 mb-1 text-sm leading-4 font-normal">@link.Title</h3>
                                        <p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">@link.Description</p>
                                    </NavigationMenuLink>
                                </li>
                            }
                        </ul>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <NavigationMenuItem TValue="string">
                    <NavigationMenuLink class="@TriggerClass" href="https://github.com/mui/base-ui">GitHub</NavigationMenuLink>
                </NavigationMenuItem>
            </NavigationMenuList>

            <NavigationMenuPortal>
                <NavigationMenuPositioner SideOffset="10" CollisionPadding="s_collisionPadding" CollisionAvoidance="s_collisionAvoidance"
                                          class="@PositionerClass" style="--duration: 0.35s; --easing: cubic-bezier(0.22, 1, 0.36, 1)">
                    <NavigationMenuPopup class="@PopupClass">
                        <NavigationMenuArrow class="@ArrowClass" />
                        <NavigationMenuViewport class="relative h-full w-full overflow-hidden" />
                    </NavigationMenuPopup>
                </NavigationMenuPositioner>
            </NavigationMenuPortal>
        </NavigationMenuRoot>
    </Hero>
</DemoFrame>

@code {
