<DemoFrame Slug="navigation-menu" Note="Rest the pointer on a trigger or click it to open its panel; moving to the other trigger slides the content across and resizes the popup. The arrow keys move between the triggers and ArrowDown opens a panel; Escape, a press outside or leaving the menu closes it. Tab moves from a trigger into its open panel's links and on to the next trigger.">
    <Hero>
        <NavigationMenuRoot TValue="string" class="min-w-max text-neutral-950 dark:text-white">
            <NavigationMenuList class="relative flex gap-px">
                <NavigationMenuItem TValue="string">
                    <NavigationMenuTrigger class="@TriggerClass">
                        Overview
                        <NavigationMenuIcon class="transition-transform duration-200 ease-[ease] data-popup-open:rotate-180">
                            <CaretDownIcon />
                        </NavigationMenuIcon>
                    </NavigationMenuTrigger>
                    <NavigationMenuContent class="@ContentClass">
                        <ul class="m-0 grid list-none grid-cols-2 p-0 max-[500px]:grid-cols-1">
                            @foreach (DemoLink link in s_overviewLinks)
                            {
                                <li @key="link.Href">
                                    <NavigationMenuLink href="@link.Href" class="@LinkCardClass">
                                        <h3 class="m-0 mb-1 text-sm leading-4 font-normal">@link.Title</h3>
                                        <p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">@link.Description</p>
                                    </NavigationMenuLink>
                                </li>
                            }
                        </ul>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <NavigationMenuItem TValue="string">
                    <NavigationMenuTrigger class="@TriggerClass">
                        Handbook
                        <NavigationMenuIcon class="transition-transform duration-200 ease-[ease] data-popup-open:rotate-180">
                            <CaretDownIcon />
                        </NavigationMenuIcon>
                    </NavigationMenuTrigger>
                    <NavigationMenuContent class="@ContentClass">
                        <ul class="m-0 flex max-w-[400px] list-none flex-col justify-center p-0">
                            @foreach (DemoLink link in s_handbookLinks)
                            {
                                <li @key="link.Href">
                                    <NavigationMenuLink href="@link.Href" class="@LinkCardClass">
                                        <h3 class="m-0 mb-1 text-sm leading-4 font-normal">@link.Title</h3>
                                        <p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">@link.Description</p>
                                    </NavigationMenuLink>
                                </li>
                            }
                        </ul>
                    </NavigationMenuContent>
                </NavigationMenuItem>

                <NavigationMenuItem TValue="string">
                    <NavigationMenuLink class="@TriggerClass" href="https://github.com/mui/base-ui">
                        <Render><a></a></Render>
                        <ChildContent>GitHub</ChildContent>
                    </NavigationMenuLink>
                </NavigationMenuItem>
            </NavigationMenuList>

            <NavigationMenuPortal>
                <NavigationMenuPositioner SideOffset="10" CollisionPadding="s_collisionPadding" CollisionAvoidance="s_collisionAvoidance"
                                          class="@PositionerClass" style="--duration: 0.35s; --easing: cubic-bezier(0.22, 1, 0.36, 1)">
                    <NavigationMenuPopup class="@PopupClass">
                        <NavigationMenuArrow class="@ArrowClass" />
                        <NavigationMenuViewport class="relative h-full w-full overflow-hidden" />
                    </NavigationMenuPopup>
                </NavigationMenuPositioner>
            </NavigationMenuPortal>
        </NavigationMenuRoot>
    </Hero>
    <Variants>
        <div class="Variant">
            <NavigationMenuRoot TValue="string" class="min-w-max text-neutral-950 dark:text-white">
                <NavigationMenuList class="relative flex gap-px">
                    <NavigationMenuItem TValue="string">
                        <NavigationMenuTrigger class="@TriggerClass">
                            Product
                            <NavigationMenuIcon class="transition-transform duration-200 ease-[ease] data-popup-open:rotate-180">
                                <CaretDownIcon />
                            </NavigationMenuIcon>
                        </NavigationMenuTrigger>
                        <NavigationMenuContent class="@ProductContentClass">
                            <NavigationMenuRoot TValue="string" class="overflow-hidden overflow-clip text-neutral-950 dark:text-white" Orientation="Orientation.Vertical" DefaultValue="@("developers")">
                                <div class="grid grid-cols-1 overflow-hidden overflow-clip min-[700px]:grid-cols-[13rem_minmax(0,1fr)]">
                                    <NavigationMenuList class="@SubmenuListClass">
                                        @foreach (DemoAudience audience in s_audiences)
                                        {
                                            <NavigationMenuItem TValue="string" Value="@audience.Value" @key="audience.Value">
                                                <NavigationMenuTrigger class="@SubmenuTriggerClass">
                                                    <span class="text-sm leading-4 font-normal text-neutral-950 dark:text-white">@audience.Label</span>
                                                    <span class="text-sm text-neutral-500 dark:text-neutral-400">@audience.Hint</span>
                                                </NavigationMenuTrigger>
                                                <NavigationMenuContent class="@SubmenuContentClass">
                                                    <div>
                                                        <h4 class="m-0 text-base leading-5 font-normal">@audience.Title</h4>
                                                        <p class="m-0 mt-1 text-sm text-neutral-500 dark:text-neutral-400">@audience.Description</p>
                                                    </div>
                                                    <ul class="-mx-2 m-0 flex list-none flex-col gap-0 p-0">
                                                        @foreach (DemoLink link in audience.Links)
                                                        {
                                                            <li @key="link.Href">
                                                                <NavigationMenuLink href="@link.Href" class="@LinkCardClass">
                                                                    <h5 class="m-0 text-sm leading-4 font-normal">@link.Title</h5>
                                                                    <p class="m-0 text-sm text-neutral-500 dark:text-neutral-400">@link.Description</p>
                                                                </NavigationMenuLink>
                                                            </li>
                                                        }
                                                    </ul>
                                                </NavigationMenuContent>
                                            </NavigationMenuItem>
                                        }
                                    </NavigationMenuList>
                                    <NavigationMenuViewport class="relative min-h-[16.5rem] overflow-hidden border-t border-neutral-950 min-[700px]:border-t-0 dark:border-white" />
                                </div>
                            </NavigationMenuRoot>
                        </NavigationMenuContent>
                    </NavigationMenuItem>
                </NavigationMenuList>

                <NavigationMenuPortal>
                    <NavigationMenuPositioner SideOffset="10" CollisionPadding="s_collisionPadding" CollisionAvoidance="s_collisionAvoidance"
                                              class="@PositionerClass" style="--duration: 0.35s; --easing: cubic-bezier(0.22, 1, 0.36, 1)">
                        <NavigationMenuPopup class="@PopupClass">
                            <NavigationMenuArrow class="@ArrowClass" />
                            <NavigationMenuViewport class="relative h-full w-full overflow-hidden" />
                        </NavigationMenuPopup>
                    </NavigationMenuPositioner>
                </NavigationMenuPortal>
            </NavigationMenuRoot>
            <span class="VariantName">A submenu inside a panel: a nested root with its own list and an inline viewport, which switches as the pointer rests on its triggers or the arrow keys move between them</span>
        </div>
    </Variants>
</DemoFrame>

