<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The sample application's host: a Blazor Web App with Server and WebAssembly interactivity. Never packed. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- The library's development warnings are on in a Debug build, as a consumer's app would have them. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <RuntimeHostConfigurationOption Include="Blazix.Primitives.DevelopmentWarnings" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazix.Primitives.Demo.Client\Blazix.Primitives.Demo.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
