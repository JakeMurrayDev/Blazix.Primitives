<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Razor-generated .razor.g.cs land under obj/Debug/net11.0/generated/ -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Probe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared framework instead of a PackageReference: no NuGet download, same RC2 bits as the SDK. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Cases that do not compile are parked under Failing/; see Failing/README.md -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Failing/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
