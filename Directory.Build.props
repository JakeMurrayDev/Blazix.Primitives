<Project>

  <!-- Defaults for every project (ADR 09 §3, ADR 10 §5). The two Roslyn projects override TargetFramework. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new advisory against a pinned package must not break an unrelated pull request. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The two shipped assemblies produce XML documentation; under warnings-as-errors a public or protected member without a
       documentation comment (CS1591) or a cref, paramref or typeparamref that does not resolve fails the build. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Blazix.Primitives' Or '$(MSBuildProjectName)' == 'Blazix.Primitives.Generators'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The library only. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Blazix.Primitives'">
    <!-- ADR 16 rule 1: reflection or dynamic code in the library fails the build. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Blazix.Primitives'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
