<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Iodine.Headless</RootNamespace>
    <PackageId>Iodine.Headless</PackageId>
    <Description>Unofficial Blazor port of MUI Base UI v1.9.0: headless, accessible primitives for Blazor Server and WebAssembly.</Description>
    <Authors>Jake Alexander Murray</Authors>
    <Copyright>Copyright (c) 2026 Jake Alexander Murray</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;headless;primitives;accessibility;base-ui</PackageTags>
    <RepositoryUrl>https://github.com/JakeMurrayDev/Iodine.Headless</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    A component library consumed by both render modes references the Components package, never the full framework:
    a FrameworkReference to Microsoft.AspNetCore.App has no runtime pack for browser-wasm (NETSDK1082), so the
    WebAssembly fixture client could not reference the library (changed in Track 3; Track 0 had the FrameworkReference).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <!--
    L1 and L2 test the library's internal helpers (store equality, the value-changed observer, highlight reasons);
    the twins are internal (ADR 08 §1), so the L2 twin contract tests and the fixture probe twin derive from the base.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Iodine.Headless.Tests" />
    <InternalsVisibleTo Include="Iodine.Headless.Tests.Components" />
    <InternalsVisibleTo Include="Iodine.Headless.Fixtures.Client" />
  </ItemGroup>

  <!--
    The JavaScript build (ADR 04 §4). esbuild emits the initializer and one ESM entry per module of ADR 04 §1 into
    wwwroot/, which is build output and ignored by git. `node` is needed at build time only; `-p:IodineSkipJsBuild=true`
    skips the step and requires the outputs to be present (the packaging path, ADR 04 verification item 4).
    One entry per module of ADR 04 §1; `js/CONTEXT.md` has the rules for adding one.
  -->
  <PropertyGroup>
    <IodineJsBuildScript>$(MSBuildProjectDirectory)/js/build.mjs</IodineJsBuildScript>
  </PropertyGroup>
  <ItemGroup>
    <IodineJsEntry Include="js/initializer.ts" Out="Iodine.Headless.lib.module" />
    <IodineJsEntry Include="js/dom.ts" Out="js/dom" />
    <IodineJsEntry Include="js/button.ts" Out="js/button" />
    <IodineJsEntry Include="js/transitions.ts" Out="js/transitions" />
    <IodineJsEntry Include="js/collapsible.ts" Out="js/collapsible" />
    <IodineJsEntry Include="js/composite.ts" Out="js/composite" />
    <IodineJsEntry Include="js/form.ts" Out="js/form" />
    <IodineJsEntry Include="js/tabs.ts" Out="js/tabs" />
    <IodineJsEntry Include="js/scroll-lock.ts" Out="js/scroll-lock" />
    <IodineJsEntry Include="js/portal.ts" Out="js/portal" />
    <IodineJsEntry Include="js/positioning.ts" Out="js/positioning" />
    <IodineJsEntry Include="js/popup.ts" Out="js/popup" />
    <IodineJsEntry Include="js/interactions.ts" Out="js/interactions" />
    <IodineJsEntry Include="js/focus-manager.ts" Out="js/focus-manager" />
    <IodineJsEntry Include="js/navigation-menu.ts" Out="js/navigation-menu" />
    <IodineJsEntry Include="js/combobox.ts" Out="js/combobox" />
    <IodineJsEntry Include="js/context-menu.ts" Out="js/context-menu" />
    <IodineJsEntry Include="js/menu-filter.ts" Out="js/menu-filter" />
    <IodineJsEntry Include="js/select.ts" Out="js/select" />
    <IodineJsEntry Include="js/scroll-area.ts" Out="js/scroll-area" />
    <IodineJsEntry Include="js/slider.ts" Out="js/slider" />
    <IodineJsEntry Include="js/drawer.ts" Out="js/drawer" />
    <IodineJsEntry Include="js/number-field.ts" Out="js/number-field" />
    <IodineJsEntry Include="js/toast.ts" Out="js/toast" />
    <IodineJsEntry Include="js/otp-field.ts" Out="js/otp-field" />
    <IodineJsOutput Include="@(IodineJsEntry->'wwwroot/%(Out).js')" />
  </ItemGroup>

  <!-- Runs on every build (about 0.1 s): outputs differ per configuration and a timestamp check cannot tell them apart. -->
  <!-- The manifest path is set inside the targets: IntermediateOutputPath is defined by the SDK after the project body. -->
  <Target Name="IodineJsPaths">
    <PropertyGroup>
      <IodineJsManifest>$(IntermediateOutputPath)iodine-js.manifest.txt</IodineJsManifest>
    </PropertyGroup>
  </Target>

  <Target Name="IodineBuildJs" DependsOnTargets="IodineJsPaths" Condition="'$(IodineSkipJsBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(IodineJsBuildScript)&quot; --root &quot;$(MSBuildProjectDirectory)&quot; --outdir wwwroot --clean wwwroot --configuration $(Configuration) --manifest &quot;$(IodineJsManifest)&quot; @(IodineJsEntry->'--entry &quot;%(Identity)=%(Out)&quot;', ' ')" />
  </Target>

  <!-- Runs before the static web assets pipeline enumerates wwwroot, so files generated by this build are packed too. -->
  <Target Name="IodineRegisterJs" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="IodineJsPaths;IodineBuildJs" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('%(IodineJsOutput.Identity)')"
           Text="The JavaScript build output '%(IodineJsOutput.Identity)' is missing. Run the build with node on PATH, or set IodineSkipJsBuild=true only with prebuilt outputs in wwwroot/." />
    <!--
      The whole folder is generated: drop the evaluated items whose file the clean removed (a stale sourcemap from the
      other configuration) and register exactly what esbuild wrote. No globs here: an in-target Include glob is served
      from MSBuild's cached directory listing and a Remove glob is matched against the disk, so neither sees the
      deletion. Without a manifest (IodineSkipJsBuild) the evaluated items stand.
    -->
    <ReadLinesFromFile File="$(IodineJsManifest)" Condition="Exists('$(IodineJsManifest)')">
      <Output TaskParameter="Lines" ItemName="_IodineJsFile" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'@(_IodineJsFile)' != ''">
      <Content Remove="@(Content)" Condition="!Exists('%(Content.FullPath)')" />
      <Content Include="@(_IodineJsFile)" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

  <!-- The Base UI release this package ports (ADR 10 §2); a re-pin (ADR 15) edits this value. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BaseUIVersion</_Parameter1>
      <_Parameter2>v1.9.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The generator and the analyzers run inside the library's own compilation; neither becomes a package dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Iodine.Headless.Generators\Iodine.Headless.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Iodine.Headless.Analyzers\Iodine.Headless.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The generator ships to consumers as an analyzer asset; the analyzers project does not (ADR 10 §1). -->
  <ItemGroup>
    <None Include="..\Iodine.Headless.Generators\bin\$(Configuration)\netstandard2.0\Iodine.Headless.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- The licence and the third-party notices travel inside the package (ADR 07 decision 4). -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
